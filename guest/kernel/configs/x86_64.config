# The experimental x86-64 guest kernel (guest/kernel/meson.build,
# docs/dev/architecture/qemu-user-bridge.md):
# webos_virt_defconfig with these over it, built with ARCH=x86_64. The defconfig is a savedefconfig
# file, relative to Kconfig's defaults, so it means the same here as on arm64; this adds what x86-64
# needs for the q35 machine under KVM and the i386 compat layer (the compat bridge, patch 0025), and
# turns off the defconfig's arm64-only options, which meson/kbuild.sh then does not require.
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_IA32_EMULATION=y
# CONFIG_X86_X32_ABI is not set
CONFIG_PCI_MSI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
# lgemu.ko's micom owns ACPI's power button, its wake line (i2c.c): no input device for webOS
# CONFIG_ACPI_BUTTON is not set
# CONFIG_EFI is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_DRM_I915 is not set
# CONFIG_SND_HDA_INTEL is not set
# arm64 only
# CONFIG_ARM64_VA_BITS_48 is not set
# CONFIG_COMPAT_ALIGNMENT_FIXUPS is not set
# CONFIG_ARMV8_DEPRECATED is not set
# CONFIG_SWP_EMULATION is not set
# CONFIG_CP15_BARRIER_EMULATION is not set
# CONFIG_SETEND_EMULATION is not set
# CONFIG_PCI_HOST_GENERIC is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_AMBA_PL011_CONSOLE is not set
# CONFIG_GPIO_PL061 is not set
# CONFIG_RTC_DRV_PL031 is not set
