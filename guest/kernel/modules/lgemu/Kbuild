# lgemu.ko (core.c): one object per part of the module.
obj-m := lgemu.o
lgemu-y := core.o partinfo.o low_mem_notify.o i2c.o accel.o light.o tof.o thermal.o micom-rtc.o lgib.o gfx.o snd.o mic.o video.o v4l2-vsc.o v4l2-hdmi.o earc.o capture.o capture-histogram.o v4l2-capture.o
# What the SoC driver modules share (lgemu-drv.h): no part of its own, only exports.
lgemu-y += drv.o
lgemu-y += sestore.o
# The Linux I2C adapters over i2c.c's devices, where the kernel has I2C (lgemu.h has the stubs).
lgemu-$(CONFIG_I2C) += i2c_adapters.o
# The board's CEC adapter on the kernel's CEC framework, where the kernel has it (lgemu.h has the stubs).
lgemu-$(CONFIG_CEC_CORE) += cec.o
