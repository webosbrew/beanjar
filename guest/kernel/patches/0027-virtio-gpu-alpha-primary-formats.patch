drm/virtio: primary planes take ARGB8888 and ABGR8888

The primary plane listed XRGB8888 only, so a compositor that scans out with
alpha could not: spacebuns' stock Weston 13 asks for gbm-format=abgr8888 and
fails with "format not supported by output". The TV puts its video plane
under the OSD, and the host viewer composes the video under the OSD's alpha,
which an X format does not carry. ARGB8888 was already accepted by ADDFB2 (the
cursor's format); ABGR8888 maps to R8G8B8A8_UNORM, which the host's 2D and 3D
scanouts know.

--- a/drivers/gpu/drm/virtio/virtgpu_display.c
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c
@@ -327,7 +327,8 @@
 	int ret;
 
 	if (mode_cmd->pixel_format != DRM_FORMAT_HOST_XRGB8888 &&
-	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888)
+	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888 &&
+	    mode_cmd->pixel_format != DRM_FORMAT_ABGR8888)
 		return ERR_PTR(-ENOENT);
 
 	if ((mode_cmd->flags & DRM_MODE_FB_MODIFIERS) &&
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c
@@ -35,6 +35,8 @@
 
 static const uint32_t virtio_gpu_formats[] = {
 	DRM_FORMAT_HOST_XRGB8888,
+	DRM_FORMAT_HOST_ARGB8888,
+	DRM_FORMAT_ABGR8888,
 };
 
 static const uint32_t virtio_gpu_cursor_formats[] = {
@@ -63,6 +65,9 @@
 	case DRM_FORMAT_BGRA8888:
 		format = VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM;
 		break;
+	case DRM_FORMAT_ABGR8888:
+		format = VIRTIO_GPU_FORMAT_R8G8B8A8_UNORM;
+		break;
 	default:
 		/*
