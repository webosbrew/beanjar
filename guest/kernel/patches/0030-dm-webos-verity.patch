+/* dm-webos-verity.c: LG's webos-verity, which reads its verity table from the device */
+extern const struct target_type *dm_verity_target(void);
+#ifdef CONFIG_DM_WEBOS_VERITY
+extern int dm_webos_verity_init(void);
+extern void dm_webos_verity_exit(void);
+#else
+static inline int dm_webos_verity_init(void) { return 0; }
+static inline void dm_webos_verity_exit(void) {}
+#endif
