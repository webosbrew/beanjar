+/*
+ * The overlay plane (virtio_gpu.overlay_plane). A virtio scanout shows one resource and composes
+ * nothing, so the overlay is scanned out only while the CRTC's primary plane has no framebuffer:
+ * the scanout then shows the overlay's visible source rectangle (clipped to the CRTC) at that
+ * rectangle's own size; its position on the CRTC is not kept. With the primary on, the overlay
+ * is not shown.
+ */
+static void virtio_gpu_overlay_show(struct drm_plane *plane,
+				    struct drm_plane_state *old_state)
+{
+	struct drm_plane_state *new_state = plane->state;
+	struct virtio_gpu_device *vgdev = plane->dev->dev_private;
+	struct virtio_gpu_output *output =
+		drm_crtc_to_virtio_gpu_output(new_state->crtc);
+	struct virtio_gpu_object *bo = gem_to_virtio_gpu_obj(new_state->fb->obj[0]);
+	struct drm_rect src = new_state->src, rect;
+	bool full = !old_state || !output->overlay_shown;
+
+	if (full || !drm_atomic_helper_damage_merged(old_state, new_state, &rect))
+		drm_rect_init(&rect, 0, 0, new_state->fb->width, new_state->fb->height);
+	if (bo->dumb)
+		virtio_gpu_update_dumb_bo(vgdev, new_state, &rect);
+	if (full || new_state->fb != old_state->fb ||
+	    !drm_rect_equals(&new_state->src, &old_state->src)) {
+		drm_rect_fp_to_int(&src, &src);
+		if (bo->host3d_blob || bo->guest_blob)
+			virtio_gpu_cmd_set_scanout_blob(vgdev, output->index, bo, new_state->fb,
+							drm_rect_width(&src), drm_rect_height(&src),
+							src.x1, src.y1);
+		else
+			virtio_gpu_cmd_set_scanout(vgdev, output->index, bo->hw_res_handle,
+						   drm_rect_width(&src), drm_rect_height(&src),
+						   src.x1, src.y1);
+		output->overlay_shown = true;
+	}
+	virtio_gpu_resource_flush(plane, rect.x1, rect.y1,
+				  drm_rect_width(&rect), drm_rect_height(&rect));
+}
+
+static void virtio_gpu_overlay_plane_update(struct drm_plane *plane,
+					    struct drm_atomic_state *state)
+{
+	struct drm_plane_state *old_state = drm_atomic_get_old_plane_state(state, plane);
+	struct virtio_gpu_device *vgdev = plane->dev->dev_private;
+	struct virtio_gpu_output *output = NULL;
+
+	if (plane->state->crtc)
+		output = drm_crtc_to_virtio_gpu_output(plane->state->crtc);
+	if (old_state->crtc)
+		output = drm_crtc_to_virtio_gpu_output(old_state->crtc);
+	if (WARN_ON(!output))
+		return;
+
+	/* the primary plane is updated first (plane order) and owns the scanout while it has a fb */
+	if (output->crtc.primary->state->fb || !output->crtc.state->active)
+		return;
+	if (plane->state->fb && plane->state->visible) {
+		virtio_gpu_overlay_show(plane, old_state);
+	} else if (output->overlay_shown) {
+		/* both planes off: nothing shown, as when the primary alone goes off */
+		virtio_gpu_cmd_set_scanout(vgdev, output->index, 0, 0, 0, 0, 0);
+		virtio_gpu_notify(vgdev);
+		output->overlay_shown = false;
+	}
+}
