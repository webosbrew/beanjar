# The initramfs's busybox (docs/dev/guides/build.md, "Initramfs busybox"): a config fragment over
# allnoconfig. Every option not set here is off: meson/kbuild.sh runs `make allnoconfig`, replaces
# the options listed here with these lines, runs `make oldconfig`, and fails if an option listed
# as =y did not stay set (a typo, or a dependency that is not listed). Comments are ignored.
#
# What uses each applet, outside webOS (inside, `webos-enter` runs the firmware's own busybox):
#   init      guest/initramfs/rootfs/init, guest/initramfs/rootfs/bin/webos-start (and the /run/webos-init it writes)
#   enter     guest/initramfs/rootfs/bin/webos-enter
#   console   commands typed on the serial console (host/scripts/vm-launcher console, beanjar/runtime/unit.py,
#             tests/regress/input/check-bridge.py, check-viewer.py, tests/regress/tcg/run.py)
#             and the scripts they run with the initramfs's sh: guest/scripts/save-logs.sh,
#             guest/scripts/time-boot.sh, tests/regress/boot/guest.sh, tests/regress/input/start-viewer-probe.sh,
#             tests/regress/tcg/io.sh, tests/regress/video/check-registry.sh,
#             guest/layers/gl/test/sendkey.sh
#   shell     the debug shell by hand (records in docs/ used free and top)

# --- the binary ---
CONFIG_STATIC=y
# GCC 14's false -Wreturn-local-addr on modutils.c's filename2modname (it returns an xstrdup of
# its local buffer, never the buffer)
CONFIG_EXTRA_CFLAGS="-Wno-return-local-addr"
CONFIG_LFS=y
CONFIG_TIME64=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_BUSYBOX=y
# init: `busybox --install -s /bin` makes the applet links at boot (the cpio only has bin/sh)
CONFIG_FEATURE_INSTALLER=y
CONFIG_FEATURE_DEVPTS=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_MONOTONIC_SYSCALL=y
# console: sleep 0.2 / 0.5
CONFIG_FLOAT_DURATION=y

# --- the shell: sh (init, every script above), the debug shell (setsid cttyhack sh -l) ---
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
CONFIG_FEATURE_SH_READ_FRAC=y
CONFIG_CTTYHACK=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_WINCH=y

# --- files and text ---
# init, console
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_FEATURE_PRESERVE_HARDLINKS=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_FEATURE_CHOWN_LONG_OPTIONS=y
CONFIG_LN=y
CONFIG_MKDIR=y
# init: the eMMC partitions' /dev/mmcblk0pN nodes
CONFIG_MKNOD=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_FEATURE_TEST_64=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_SYNC=y
# init: tr (cmdline), grep
CONFIG_TR=y
CONFIG_GREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
# console: cut, head -c, sed -n, awk, stat -c, sha256sum, date -u, timeout
CONFIG_CUT=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_FEATURE_AWK_GNU_EXTENSIONS=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_SHA256SUM=y
CONFIG_DATE=y
CONFIG_FEATURE_DATE_ISOFMT=y
CONFIG_TIMEOUT=y
# shell
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_RM=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_LESS=y
CONFIG_FEATURE_LESS_MAXLINES=9999999

# --- mounts, namespaces, power ---
# init, console (tests/regress/tcg)
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_CHROOT=y
# init (webos-start), enter
CONFIG_UNSHARE=y
CONFIG_NSENTER=y
CONFIG_SETSID=y
CONFIG_HOSTNAME=y
# webos-start: poweroff -f / reboot -f when webOS powers the set off or restarts it
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# --- processes, kernel ---
# console (dmesg: save-logs.sh; kill: start-viewer-probe.sh), shell
CONFIG_DMESG=y
CONFIG_KILL=y
CONFIG_PS=y
CONFIG_FREE=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS=y
CONFIG_FEATURE_TOP_SMP_CPU=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_UNAME=y
CONFIG_DF=y
# init: a qemu-user VM's swap disk in host RAM (host/core/beanjar/runtime/hostswap.py), swapon -d
CONFIG_MKSWAP=y
CONFIG_SWAPON=y
CONFIG_FEATURE_SWAPON_DISCARD=y
# out-of-tree modules the initramfs loads before webOS starts (guest/kernel/modules, docs/dev/guides/build.md)
CONFIG_INSMOD=y
CONFIG_RMMOD=y
CONFIG_LSMOD=y
CONFIG_FEATURE_CMDLINE_MODULE_OPTIONS=y
# the kernel's own modules (boot.conf's PERIPHERAL_MODULES) with their dependencies, from the
# modules.dep that the kernel build's modules_install generates in /lib/modules/<release>
CONFIG_MODPROBE=y
CONFIG_DEFAULT_MODULES_DIR="/lib/modules"
CONFIG_DEFAULT_DEPMOD_FILE="modules.dep"
