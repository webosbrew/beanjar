# Emulator: a paired Magic Remote's record on the common data partition, made once when the state
# has none (usr/libexec/beanjar/emulator-mrcu-pairing). Pulled in by lginput2.service
# (lginput2.service.wants) and done before it starts, after mount-readwrite mounted the partition.
# The systemd releases' counterpart of etc/init/emulator-mrcu-pairing.conf.
[Unit]
Description=Emulator: a paired Magic Remote's record
After=mount-readwrite.service
Before=lginput2.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/beanjar/emulator-mrcu-pairing
RemainAfterExit=yes
