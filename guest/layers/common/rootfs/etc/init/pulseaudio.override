# Emulator (guest/layers/common): the stock job, running the stock /etc/pulse/system.pa. That file's
# pcm_output is module-alsa-sink on hw:0,6, which the virtio-sound PCM is because the kernel
# cmdline has virtio_snd.pcm_device_base=6 (guest/kernel/patches, beanjar/runtime/qemu.py). Restores the
# stock "start on init-boot-done" (the emulator layer used to set "manual" when there was no
# card). Without a playback device (AUDIO=off, the x86 TCG launcher) that sink cannot load and
# pulseaudio would exit and respawn, so the pre-start stops the job instead. The firmware's
# device_table creates /dev/snd/pcmC0D6p even without a card; sysfs reflects the kernel PCM.
start on init-boot-done

pre-start script
	if [ ! -e /sys/class/sound/pcmC0D6p ]; then
		echo "pulseaudio: no kernel PCM hw:0,6, not started"
		stop; exit 0
	fi
	rm -rf ~/.pulse/*
	chgrp -R audio /dev/snd/*
	chmod -R 660 /dev/snd/*
end script
