#!/usr/bin/python
# SPDX-FileCopyrightText: Mariotaku <git@mariotaku.me> and the Beanjar contributors
# SPDX-License-Identifier: GPL-2.0-or-later
# The normal layer's FirstUse writes (systemd releases). A new state boots in FirstUse as a new set
# does; what the FirstUse app writes before its last button is replayed here, once, through LG's
# own services, with the values FirstUse computes from them, and emulator-firstuse-done then makes
# the button's call, bootManager/firstUseDone, after them (usr/sbin/emulator-firstuse-done). From W20L's com.palm.app.firstuse (main.js), on a set whose user takes every
# screen's default with no network connected:
#   location  the country selected is the set's own (settings' country in the list, W21P's
#             main.js: the index of countryCode3 in countryList[0]'s countries; W20L's list has
#             only it), or the VM's (etc/emulator/country, vm.toml firmware.country: a country
#             of the board's RMM group, which settings' list for the board's group may not name;
#             the common layer's emulator-country sets settings' country to it); one time zone for the country: onSelectTimeZone(0) by itself, which
#             writes it when it is not the current one, to systemservice setPreferences and to
#             settings' category time; of several, the user's: the list starts on the current
#             zone, which stands, else the country's default zone (default_zone below, the
#             settings app's choice on a change of country); Next: completeSetup, option
#             smartServiceCountryCode2/3
#             (the selected country's shortName and alpha3)
#   connect   no write without wired Internet
#   network   skipped
#   eula      not shown without Internet
#   confirm   the watch type and the zip code are the user's input; not replayed
#   done      Jd: category network deviceName = deviceName + " " + the model's series, 25 chars
# Not replayed: asc startAdvertising (no state).
# After FirstUse, the last input (last_input below; its own mark, so a state already past the
# writes above gets it too). W21A's com.palm.app.firstuse ends on Next with firstUseDone
# {action "launch", params {supportOOBE}, appId com.webos.app.channelsetting for a watch type
# TV/CABLE/BOTH, else com.webos.app.oobe}; bootd (StarfishBootSequencer::onFirstUseDone) launches
# it; channelsetting's onclose launches com.webos.app.oobe when launched with supportOOBE; oobe
# (main.js) on start reads category general lastInputApp and, when it is "none" (the stock
# default), writes lastInputApp and physicalLastInputApp = com.webos.app.livetv. Without it
# Home's ChannelInterfaces.updateLastInputChannel throws and its card row stays empty. Checked:
# W20L, W20H, W21P, W21A, W22P/L/A/H/O, W23A/H, W24G/P ship oobe with that write; W19P has no
# oobe (its FirstUse sends firstUseDone {} and bootd launches the last input), so the write is
# made only where the firmware ships the oobe app. As on a set, where oobe writes it with Home
# already resident, Home reads "none" on the boot that writes it (bootd launches Home before
# settings-service is up, and this unit runs after it): that boot's card row stays empty until
# Home is next launched; later boots draw it.
# Not FirstUse's: the auto power-off timers and Audio Guidance are the common layer's
# (usr/libexec/beanjar/emulator-settings).
import json
import os
import re
import subprocess
import sys
import syslog
import time

MARK = "/var/luna/preferences/emulator-firstuse"
LASTINPUT_MARK = "/var/luna/preferences/emulator-firstuse-lastinput"
OOBE = "/usr/palm/applications/com.webos.app.oobe"
LIVETV = "com.webos.app.livetv"
COUNTRY = "/etc/emulator/country"
COUNTRY_LIST = "/etc/palm/countryList.json"


def call(uri, payload):
    out = subprocess.check_output(["luna-send", "-n", "1", uri, json.dumps(payload)])
    reply = json.loads(out)
    if not reply.get("returnValue", False):
        raise RuntimeError("%s %s: %s" % (uri, json.dumps(payload), out.strip()))
    return reply


def first(uri, payload, test):
    # the first reply of a subscription that passes test
    proc = subprocess.Popen(["luna-send", "-i", uri, json.dumps(payload)], stdout=subprocess.PIPE)
    try:
        for line in iter(proc.stdout.readline, b""):
            reply = json.loads(line)
            if test(reply):
                return reply
    finally:
        proc.kill()
        proc.wait()
    raise RuntimeError("%s: ended" % uri)


def log(msg):
    syslog.syslog(msg)
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


def settings(category, keys):
    return call(
        "luna://com.webos.settingsservice/getSystemSettings", {"category": category, "keys": keys}
    )["settings"]


def set_settings(category, values):
    log("setSystemSettings %s %s" % (category, json.dumps(values)))
    call(
        "luna://com.webos.settingsservice/setSystemSettings",
        {"category": category, "settings": values},
    )


def default_zone(short, zones):
    # A country of several time zones: the one the set picks for it, as W23P's settings app
    # (com.palm.app.settings main.js) does when the country changes: settings' category time
    # defaultTimeZone (/etc/palm/defaultTimeZone.json) names the country's defaultZoneId; the
    # zone whose ZoneID holds its last part, else the country's first zone
    reply = call(
        "luna://com.webos.settingsservice/getSystemSettingValues",
        {"category": "time", "key": "defaultTimeZone"},
    )
    defaults = reply.get("defaultTimeZones", reply.get("values", {}).get("defaultTimeZones"))
    if not isinstance(defaults, list):
        raise RuntimeError("no defaultTimeZones in time defaultTimeZone: %s" % json.dumps(reply))
    zone_id = next(
        (d.get("defaultZoneId", "") for d in defaults if d.get("countryCode") == short), ""
    )
    city = zone_id.split("/")[-1]
    return next((z for z in zones if city and city in z.get("ZoneID", "")), zones[0])


def vm_country():
    # the VM's country (vm.toml firmware.country), or None
    try:
        with open(COUNTRY) as f:
            return f.read().strip() or None
    except IOError:
        return None


def last_input():
    # oobe's write on FirstUse's default finish (header), once
    if os.path.exists(LASTINPUT_MARK):
        return
    if not os.path.isdir(OOBE):
        log("emulator-firstuse: no %s, no last input write" % OOBE)
    elif settings("general", ["lastInputApp"]).get("lastInputApp") == "none":
        set_settings("general", {"lastInputApp": LIVETV, "physicalLastInputApp": LIVETV})
    open(LASTINPUT_MARK, "a").close()
    subprocess.call(["sync"])


def lls_country():
    # LLS's factory countryName, or None (no answer; "---" on a new EEPROM without one)
    try:
        reply = call(
            "luna://com.webos.service.lowlevelstorage/getData",
            {"dbgroups": [{"dbid": "factory", "items": ["countryName"]}]},
        )
    except (RuntimeError, subprocess.CalledProcessError, ValueError):
        return None
    for group in reply.get("dbgroups", []):
        if group.get("dbid") == "factory":
            return group.get("items", {}).get("countryName")
    return None


def default_country():
    # configd's system.defaultCountry (the board's group's default), or None
    try:
        reply = call(
            "luna://com.webos.service.config/getConfigs",
            {"configNames": ["system.defaultCountry"]},
        )
    except (RuntimeError, subprocess.CalledProcessError, ValueError):
        return None
    return reply.get("configs", {}).get("system.defaultCountry")


def list_entry(country3):
    # the country's entry in the firmware's full list (/etc/palm/countryList.json), or None
    try:
        with open(COUNTRY_LIST) as f:
            groups = json.load(f)["countryList"]
    except (IOError, ValueError, KeyError):
        return None
    for group in groups:
        for c in group.get("countries", []):
            if c.get("alpha3") == country3 and c.get("shortName"):
                return c
    return None


OTHERS_ROW = re.compile(r"^[A-Z]{2}7$")


def service_country_first():
    # FirstUse's location step stores the smart service country before its network step, so on a
    # set sdx has the country before it first reaches LG's server; this state starts past FirstUse
    # with its network up. sdx compares the server's country with its own and, outside FirstUse
    # mode, raises "Changing the country will cause your TV to restart" when they differ
    # (CountryManager::changeCountry_by_serverResponse, W23M 13.40 to 43.22); at its start it
    # makes the stock "other" its group's Others row (US7). So the country is stored as early as
    # settings takes it, from what devicereset will choose for settings' country: the VM's,
    # else LLS's factory countryName, else configd's system.defaultCountry. The location step
    # below stores it again where settings' own country differs or sdx's row landed over it,
    # keep_service_country() after it, and LG's mock withholds its answers meanwhile.
    current = settings("option", ["smartServiceCountryCode3"]).get("smartServiceCountryCode3")
    if current != "other" and not (current and OTHERS_ROW.match(current)):
        return
    for source in (vm_country, lls_country, default_country):
        country3 = source()
        entry = list_entry(country3) if country3 else None
        if entry:
            set_settings(
                "option",
                {
                    "smartServiceCountryCode2": entry["shortName"],
                    "smartServiceCountryCode3": country3,
                },
            )
            return
    log("emulator-firstuse: no country before settings' own; the smart service country waits")


FILE_CACHE = "/var/luna/preferences/option"
KEEP_WAIT = 450  # s
KEEP_POLL = 5  # s


def uptime():
    with open("/proc/uptime") as f:
        return float(f.read().split()[0])


def sdx_start():
    # when sdx's running process started, seconds since boot, or None if it does not run
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as f:
                if f.read().strip() != "sdx":
                    continue
            with open("/proc/%s/stat" % pid) as f:
                fields = f.read().rsplit(")", 1)[1].split()
        except (IOError, OSError, IndexError):
            continue
        # field 22, starttime, is the 20th after the command's closing parenthesis
        return float(fields[19]) / os.sysconf("SC_CLK_TCK")
    return None


def cached_country():
    # smartServiceCountryCode3 in settings' file cache of category option, which sdx reads at its
    # start (getStringFromSettingCache), or None
    try:
        with open(FILE_CACHE) as f:
            return json.load(f).get("smartServiceCountryCode3")
    except (IOError, ValueError, AttributeError):
        return None


def keep_service_country(short, country3):
    # sdx's first run reads the smart service country from settings' file cache and, finding the
    # stock "other", stores its group's Others row (US7). Settings applies writes late in a first
    # boot (15 to 40 s on the PC), so that row can land after the country stored here and stay.
    # Until it does not, the country is stored again over an Others row: done once sdx has started
    # after the file cache held the country (it read the country), or after storing it again, or
    # after KEEP_WAIT. LG's mock answers no SDP request naming an Others row meanwhile (lg_sdp.py
    # first_use_pending), as a set without a network gets none, so sdx never sees a "change".
    deadline = time.time() + KEEP_WAIT
    held = None  # uptime by which the file cache held the country
    while time.time() < deadline:
        stored = settings("option", ["smartServiceCountryCode3"]).get("smartServiceCountryCode3")
        if stored and OTHERS_ROW.match(stored):
            set_settings(
                "option", {"smartServiceCountryCode2": short, "smartServiceCountryCode3": country3}
            )
            log("emulator-firstuse: sdx's %s replaced by %s" % (stored, country3))
            return
        if held is None and cached_country() == country3:
            held = uptime()
        if held is not None:
            start = sdx_start()
            if start is None or start > held:
                return
        time.sleep(KEEP_POLL)
    log("emulator-firstuse: no Others row from sdx within %d s" % KEEP_WAIT)


def main():
    if os.path.exists(MARK):
        last_input()
        return 0
    service_country_first()
    # FirstUse starts once the set has its country: settings' default is "other" until the
    # set's own country reaches it (devicereset, from LLS's factory DB), a few seconds in
    first(
        "luna://com.webos.settingsservice/getSystemSettings",
        {"category": "option", "keys": ["country"], "subscribe": True},
        lambda r: r.get("settings", {}).get("country", "other") != "other",
    )
    option = settings("option", ["country", "localeCountryGroup", "japanCitySelection"])
    country3 = vm_country() or option["country"]
    group = option["localeCountryGroup"][-2:]
    countries = call(
        "luna://com.webos.settingsservice/getSystemSettingValues",
        {"category": "option", "key": "country"},
    )["countryList"][0]["countries"]
    if vm_country() and not [c for c in countries if c["alpha3"] == country3]:
        # the VM's country, outside the list of the board's own group: its entry in the full list
        with open(COUNTRY_LIST) as f:
            countries = [c for g in json.load(f)["countryList"] for c in g["countries"]]
        countries = [c for c in countries if c["alpha3"] == country3][:1]
    country = [c for c in countries if c["alpha3"] == country3]
    if len(country) != 1:
        raise RuntimeError(
            "country %s is not once in %s" % (country3, [c["alpha3"] for c in countries])
        )
    short = country[0]["shortName"]
    if group == "JA":
        raise RuntimeError("country group JA: the region path is not replayed")

    # location: Next stays disabled for JPN until the city is one of the list's
    if country3 == "JPN":
        cities = call(
            "luna://com.webos.settingsservice/getSystemSettingValues",
            {"category": "option", "key": "japanCitySelection"},
        )
        if option["japanCitySelection"] not in json.dumps(cities):
            raise RuntimeError(
                "japanCitySelection %s not in its list" % option["japanCitySelection"]
            )
    stored = settings("option", ["smartServiceCountryCode2", "smartServiceCountryCode3"])
    if (stored.get("smartServiceCountryCode2"), stored.get("smartServiceCountryCode3")) != (
        short,
        country3,
    ):
        set_settings(
            "option", {"smartServiceCountryCode2": short, "smartServiceCountryCode3": country3}
        )

    # done: the device name with the model's series
    name = settings("network", ["deviceName"])["deviceName"]
    model = call("luna://com.webos.service.factorymanager/getFactoryOpt", {"keys": ["modelName"]})[
        "modelName"
    ]
    letter = re.search("[A-Za-z]", model)
    start = letter.start() if letter else -1
    end = model.find("-") if "-" in model else len(model)
    series = model[min(start, end) : max(start, end)] if start >= 0 else model[:end]
    set_settings("network", {"deviceName": (name + " " + series)[:25]})

    # after FirstUse: oobe's last input, before the time zone's wait (Home reads it on launch)
    last_input()

    # location: the country's time zones; with one, it is selected by itself. Last here, as
    # systemservice answers only once its secure store gives up; the
    # hub holds the call until then
    zones = [
        z
        for z in call("luna://com.palm.systemservice/getPreferenceValues", {"key": "timeZone"})[
            "timeZone"
        ]
        if z.get("CountryCode") == short
    ]
    current = call("luna://com.palm.systemservice/getPreferences", {"keys": ["timeZone"]}).get(
        "timeZone", {}
    )
    chosen = [z for z in zones if z.get("ZoneID") == current.get("ZoneID")]
    if not zones:
        raise RuntimeError("no time zone for %s" % short)
    if len(zones) == 1:
        selected = zones[0]
    elif len(chosen) == 1:
        # FirstUse's list starts on the current zone: one already chosen through LG's API stands
        selected = chosen[0]
    else:
        selected = default_zone(short, zones)
    if current.get("ZoneID") != selected.get("ZoneID"):
        log("setPreferences timeZone %s" % json.dumps(selected))
        call("luna://com.palm.systemservice/setPreferences", {"timeZone": selected})
    set_settings("time", {"timeZone": selected})

    open(MARK, "a").close()
    subprocess.call(["sync"])
    keep_service_country(short, country3)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        log("emulator-firstuse: %s" % e)
        sys.exit(1)
