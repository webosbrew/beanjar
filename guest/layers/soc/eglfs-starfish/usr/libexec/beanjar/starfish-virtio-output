# What LG's stock Qt EGLFS Starfish integration (the firmwares whose product.env exports
# QT_QPA_EGLFS_INTEGRATION=eglfs_starfish: O22's from W23O ombre on, W23A's and W25H's and W25P's
# ponytail) needs from the launcher's configuration on virtio-gpu, which has one scanout plane per
# CRTC (and a cursor plane): product.env gives it two displays, the panel (fb0) and a 512x2160
# secondary popup (fb1) on its own plane of the same CRTC, and it aborts ("Fail to choose plane for
# output fb1"). One display instead, the stock launcher's own default. The outputs keep their
# formats (abgr8888, W25P's argb8888): the primary plane scans both out (guest kernel patch 0027).
# The plugin takes the first alpha-8 EGL config and creates its surface in the output's format;
# Mesa's GBM EGL has a config for each format (the gl layer's Mesa patch 0006) and, where the soc
# table names the TV driver's formats (O22's Mali: XBGR8888 and ABGR8888), lists theirs first
# (patch 0007), so the first config matches abgr8888 as on the set; elsewhere Mesa's ARGB8888 comes
# first, which W25P's argb8888 matches. The file is replaced by a runtime copy, bind-mounted, with
# only that change; an unexpected content fails rather than boot an unknown configuration. An
# optional root prefix allows tests without mounts.
set -eu
root=${1-}
runtime=$root/run/beanjar/starfish
mkdir -p "$runtime"
trap 'rm -f "$runtime"/*.tmp' 0
trap 'exit 1' HUP INT TERM

# rewrite NAME OLD NEW: /etc/surface-manager.d/NAME with OLD changed to NEW in its one line
# containing it
rewrite() {
	src=$root/etc/surface-manager.d/$1 out=$runtime/$1
	# A service restart in the same boot reuses the binding made at the first start.
	if mountpoint -q "$src" 2>/dev/null; then
		[ -f "$out" ] && cmp -s "$src" "$out" && return 0
		echo "starfish-virtio-output: $1 already mounted by another owner" >&2
		exit 1
	fi
	awk -v old="$2" -v new="$3" 'index($0, old) { n++; i = index($0, old)
	        $0 = substr($0, 1, i - 1) new substr($0, i + length(old)) }
	     { print } END { if (n != 1) exit 1 }' "$src" > "$out.tmp"
	mv "$out.tmp" "$out"
	[ -n "$root" ] || mount --bind "$out" "$src"
}
rewrite product.env 'export WEBOS_COMPOSITOR_DISPLAYS=2' 'export WEBOS_COMPOSITOR_DISPLAYS=1'
