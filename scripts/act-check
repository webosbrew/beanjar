#!/bin/sh
# SPDX-FileCopyrightText: Mariotaku <git@mariotaku.me> and the Beanjar contributors
# SPDX-License-Identifier: GPL-2.0-or-later
# Run the public workflows' jobs locally with nektos/act (docs/dev/guides/formatting.md, "Before a
# push"), in the same debian:trixie container the CI uses, so a dependency this machine happens to
# have is not mistaken for one the CI has.
#
#   scripts/act-check [--guest | --no-guest]
#
# Always: tests.yml's lint and unit (amd64). The Test guest workflow (testguest.yml) runs too with
# --guest, or by default when the commits being pushed touch guest/, meson/ or
# packaging/debian/build-deps/. Not covered: the arm64 unit entry (this machine cannot run it).
# Exit status: nonzero when a job fails. scripts/push-main runs this and then pushes; the pre-push
# hook only checks that it did (`git push --no-verify` skips the hook).
#
# What is checked: by hand, the working tree. Run by scripts/push-main (which sets
# ACT_CHECK_COMMIT to the commit being pushed and ACT_CHECK_BASE to what the remote has), a throwaway clone of that commit, so files that are not being pushed are not tested;
# it is removed afterwards, also after a failure or an interrupt. The output says which.
#
# What act cannot do by itself in these jobs, and what is set here for it:
# - The workflows name `container: debian:trixie`. Their node actions (actions/cache,
#   upload-artifact) need `node` in the job container, which the real runner supplies and
#   debian:trixie lacks: the jobs run a temporary copy of the workflow with only that image
#   replaced by beanjar-act-node:trixie, the stock image plus this machine's node binary (built once
#   per node binary). The stock debian:trixie is left alone. node is the only difference from CI.
# - actions/checkout clones from github.com; a local stub action stands in, since act has already
#   copied the tree it runs on (with .git).
# - actions/cache goes to act's own cache server; artifacts go to build/act/artifacts. act's artifact
#   server does not understand upload-artifact v7's requests ("unknown field mime_type"), so a failed
#   "Upload" step does not fail a job here (the files are not kept; the job's logs are in build/act).
# - act mounts the workspace at the tree's own path, which can make a Unix socket path longer
#   than the 108 bytes the kernel allows (the guest check's media socket), where the CI's /__w/...
#   is short: act runs on a short symlink, in the runtime directory.
set -eu
TOP=$(cd "$(dirname "$0")/.." && pwd)
cd "$TOP"
guest=auto
case ${1:-} in
--guest) guest=yes ;;
--no-guest) guest=no ;;
'') ;;
*) sed -n '7,8p' "$0" >&2; exit 2 ;;
esac

PATH=$HOME/.local/bin:$PATH
need() { command -v "$1" >/dev/null 2>&1 || { echo "act-check: $1 not found: $2" >&2; exit 2; }; }
need docker "install docker.io"
need act "install nektos/act from https://github.com/nektos/act/releases into ~/.local/bin"
need node "install Node.js (any version the actions run on)"

if [ "$guest" = auto ]; then
	to=${ACT_CHECK_COMMIT:-HEAD}
	from=${ACT_CHECK_BASE:-}
	case $from in ''|0000000000000000000000000000000000000000) from=$(git merge-base origin/main "$to" 2>/dev/null || echo) ;; esac
	guest=no
	if [ -n "$from" ] && [ -n "$(git diff --name-only "$from" "$to" -- guest meson packaging/debian/build-deps 2>/dev/null)" ]; then
		guest=yes
	elif [ -z "$from" ]; then
		guest=yes # no base to compare with: run it
	fi
fi

work=$TOP/build/act
mkdir -p "$work/artifacts" "$work/checkout-stub" "$work/image"
# one run at a time: act's artifact server listens on a fixed port, and the logs are shared
command -v flock >/dev/null 2>&1 && {
	exec 9>"$work/lock"
	flock -n 9 || { echo "act-check: another run is going; waiting for it"; flock 9; }
}
cat >"$work/checkout-stub/action.yml" <<'EOF'
name: checkout stub
runs:
  using: composite
  steps:
    - run: "true"
      shell: sh
EOF

# the stock debian:trixie plus node, once per node binary
nodebin=$(readlink -f "$(command -v node)")
nodeid=$(sha256sum "$nodebin" | cut -c1-16)
image=beanjar-act-node:trixie
if [ "$(docker image inspect -f '{{index .Config.Labels "beanjar.act-node"}}' $image 2>/dev/null)" != "$nodeid" ]; then
	docker image inspect debian:trixie >/dev/null 2>&1 || docker pull -q debian:trixie
	cp "$nodebin" "$work/image/node"
	printf 'FROM debian:trixie\nCOPY node /usr/local/bin/node\nLABEL beanjar.act-node=%s\n' "$nodeid" \
		>"$work/image/Dockerfile"
	docker build -q -t $image "$work/image"
fi
# the workflows with only the container image replaced
mkdir -p "$work/workflows"
for wf in tests.yml testguest.yml; do
	sed "s|^\( *container:\) debian:trixie\$|\1 $image|" ".github/workflows/$wf" >"$work/workflows/$wf"
	grep -q "container: $image" "$work/workflows/$wf" || { echo "act-check: no container image to replace in $wf" >&2; exit 2; }
done

stub=actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1=$work/checkout-stub
short=${XDG_RUNTIME_DIR:-/tmp}/act-$(printf '%s' "$TOP" | cksum | cut -d' ' -f1)
tree=$TOP
if [ -n "${ACT_CHECK_COMMIT:-}" ]; then
	# a throwaway clone (hardlinked objects, a .git of its own that works inside the container)
	tree=$work/clone
	trap 'rm -rf "$tree"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM HUP
	rm -rf "$tree"
	git clone -q --no-checkout "$TOP" "$tree"
	git -C "$tree" checkout -q --detach "$ACT_CHECK_COMMIT"
	echo "act-check: checking commit $(git -C "$tree" rev-parse --short HEAD) in a clean clone"
else
	echo "act-check: checking the working tree (uncommitted changes included)"
fi
ln -sfn "$tree" "$short"
act_run() { # workflow job [extra act args]
	wf=$1 job=$2
	shift 2
	act -C "$short" workflow_dispatch -W "$work/workflows/$wf" -j "$job" "$@" \
		-P ubuntu-24.04=$image --pull=false --rm --local-repository "$stub" \
		--artifact-server-path "$work/artifacts"
}

results=
rc=0
run() { # label workflow job [extra act args]
	label=$1
	shift
	log=$work/${label}.log
	t=$(date +%s)
	if act_run "$@" >"$log" 2>&1; then
		r=passed
	elif grep -aq 'Failure - Main Upload' "$log" && ! grep -a 'Failure - ' "$log" | grep -qav 'Failure - Main Upload'; then
		r=passed # only the artifact upload failed (see above)
	else
		r=FAILED rc=1
		tail -40 "$log"
	fi
	results="$results$(printf '  %-22s %-7s %4ss  (log %s)\n' "$label" "$r" "$(($(date +%s) - t))" "build/act/${label}.log")
"
	echo "act-check: $label $r"
}
t0=$(date +%s)
run tests-lint tests.yml lint
run tests-unit-amd64 tests.yml unit --matrix arch:amd64
[ "$guest" = yes ] && run testguest testguest.yml check
printf 'act-check results:\n%s' "$results"
[ "$guest" = yes ] || echo "  testguest              skipped (no change under guest/, meson/ or packaging/debian/build-deps/; --guest forces it)"
echo "act-check: $(($(date +%s) - t0))s in total; arm64 unit entry not covered"
exit $rc
