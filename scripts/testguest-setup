#!/usr/bin/env python3
# SPDX-FileCopyrightText: Mariotaku <git@mariotaku.me> and the Beanjar contributors
# SPDX-License-Identifier: GPL-2.0-or-later
"""Prepare the open test guest's build from beanjar-vendor's userland
(docs/dev/architecture/test-guest.md).

    scripts/testguest-setup [OUT]       default OUT: build/testguest

Takes the userland, the program testguest of packaging/vendor.toml (meson/vendor.py: the pinned
release, or the tarball BEANJAR_VENDOR_TESTGUEST names), and writes:

    OUT/cross.ini   the cross file of the guest build of virt-testguest: Debian's cross compiler
                    for the triplet BUILDINFO names (gcc-arm-linux-gnueabi, armv7 EABI softfp
                    with the CPU options of BUILDINFO's Target-Flags) on the userland's sysroot,
                    for the test programs' layer (guest/testguest) and the kernel and initramfs
    OUT/image       rootfs.pak (the userland's root filesystem) and manifest.toml naming the
                    target: a firmware directory for beanjar create --firmware

Debian's cross compiler is not built for a sysroot: --sysroot alone leaves its own tool directory
(/usr/<triplet>/include and lib, Debian's armel C library when libc6-dev-armel-cross is installed)
ahead of the sysroot. So the cross file puts the sysroot first by hand: -nostdinc with the sysroot's
usr/include and GCC's own include directory after it, -B for the start files and -L and -rpath-link
for the libraries. Only GCC's libgcc.a, crtbegin and crtend then come from the compiler. And it
undefines _TIME_BITS, which Debian 13's armel compiler defines to 64 by default (Debian's 64-bit
time_t transition): webOS's userland, and glibc's default, is 32-bit time_t.

Then the build is

    meson setup --cross-file build/testguest/cross.ini build/guest-virt-testguest -Dsoc=virt -Dwebos=testguest
    meson compile -C build/guest-virt-testguest
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

TOP = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TOP / "meson"))
import vendor

TARGET = 'chip = "virt"\nrelease = "testguest"\n'


def fields(tree):
    info = vendor.buildinfo(tree / "BUILDINFO")
    for name in ("Version", "Architecture", "Target-Triplet", "Target-Flags"):
        if not info.get(name):
            raise vendor.Error(f"{tree}/BUILDINFO has no {name}")
    if info["Architecture"] != "armel":
        raise vendor.Error(f"{tree}/BUILDINFO: Architecture {info['Architecture']}, not armel")
    return info


def compiler(triplet):
    """The directory of the system's cross compiler for triplet (Debian's gcc-<triplet>), and its
    own include directory (stddef.h, stdarg.h, arm_neon.h)."""
    gcc = shutil.which(triplet + "-gcc")
    if not gcc:
        raise vendor.Error(
            f"no {triplet}-gcc: install gcc-{triplet} (the guest build-dependencies)"
        )
    r = subprocess.run([gcc, "-print-file-name=include"], capture_output=True, text=True)
    include = Path(r.stdout.strip())
    if r.returncode or not (include / "stddef.h").is_file():
        raise vendor.Error(f"{gcc}: no include directory of its own ({r.stdout.strip()!r})")
    return Path(gcc).parent, include


def sysroot_flags(sysroot, include):
    """The options that make Debian's cross compiler take headers, start files and libraries from
    sysroot before its own tool directory: (compile, link)."""
    s = str(sysroot)
    # GCC's own directory with -idirafter: Meson drops an -isystem of a directory the compiler
    # searches by default. Debian 13's armel compiler defines _TIME_BITS=64 (and
    # _FILE_OFFSET_BITS=64) by default; webOS's userland is 32-bit time_t, glibc's default.
    compile_ = [
        "--sysroot=" + s,
        "-nostdinc",
        "-isystem" + s + "/usr/include",
        "-idirafter" + str(include),
        "-U_TIME_BITS",
    ]
    link = [
        "--sysroot=" + s,
        f"-B{s}/usr/lib/",
        f"-B{s}/lib/",
        f"-L{s}/lib",
        f"-L{s}/usr/lib",
        f"-Wl,-rpath-link,{s}/lib:{s}/usr/lib",
    ]
    return compile_, link


def cross(out, bindir, prefix, sysroot, include, flags):
    tool = lambda t: repr(str(bindir / (prefix + t)))
    compile_, link = sysroot_flags(sysroot, include)
    args = ", ".join(repr(a) for a in [*compile_, *flags])
    link_args = ", ".join(repr(a) for a in [*link, *flags])
    pc = ", ".join(repr(str(sysroot / d)) for d in ("usr/lib/pkgconfig", "usr/share/pkgconfig"))
    return f"""# Written by scripts/testguest-setup (docs/dev/architecture/test-guest.md):
#   meson setup --cross-file {out}/cross.ini build/guest-virt-testguest -Dsoc=virt -Dwebos=testguest
[binaries]
c = {tool("gcc")}
cpp = {tool("g++")}
ar = {tool("ar")}
strip = {tool("strip")}
readelf = {tool("readelf")}
objcopy = {tool("objcopy")}
nm = {tool("nm")}
pkg-config = 'pkg-config'

[properties]
sys_root = {str(sysroot)!r}
pkg_config_libdir = [{pc}]

[built-in options]
c_args = [{args}]
c_link_args = [{link_args}]

[host_machine]
system = 'linux'
cpu_family = 'arm'
cpu = 'armv7-a'
endian = 'little'
"""


def write(path, text):
    if not path.is_file() or path.read_text() != text:
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(text)
        os.replace(tmp, path)


def main(argv):
    if argv[:1] in (["-h"], ["--help"]) or len(argv) > 1:
        sys.exit(__doc__)
    out = Path(argv[0]).resolve() if argv else TOP / "build/testguest"
    try:
        tree = vendor.tree("testguest", "amd64")
        info = fields(tree)
        triplet = info["Target-Triplet"]
        bindir, include = compiler(triplet)
    except vendor.Error as e:
        sys.exit(f"testguest-setup: {e}")
    out.mkdir(parents=True, exist_ok=True)
    write(
        out / "cross.ini",
        cross(out, bindir, triplet + "-", tree / "sysroot", include, info["Target-Flags"].split()),
    )
    image = out / "image"
    image.mkdir(exist_ok=True)
    pak = image / "rootfs.pak"
    rootfs = tree / "rootfs.squashfs"
    if not pak.is_file() or vendor.sha256(pak) != vendor.sha256(rootfs):
        shutil.copyfile(rootfs, pak.with_name("rootfs.pak.tmp"))
        os.replace(pak.with_name("rootfs.pak.tmp"), pak)
    write(
        image / "manifest.toml",
        f"# The Beanjar test guest: beanjar-vendor's testguest {info['Version']}, not LG firmware\n"
        f'name = "testguest"\n{TARGET}',
    )
    print(f"testguest {info['Version']}: {out}/cross.ini, {image}")


if __name__ == "__main__":
    main(sys.argv[1:])
