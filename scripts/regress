# A host file into the VM's out share (out-relative), never through the guest's links: the share is
# the guest's, its links real host ones (host/core/beanjar/share.py)
PUT_OUT = "host/scripts/vm-launcher put-out"
# ... and the guest's files out of it: a regular file only, never through a link (the guest's
# links would hand over any file the user can read, its FIFOs hang the read), and a removal never
# through a linked directory
GET_OUT = "host/scripts/vm-launcher get-out"
RM_OUT = "host/scripts/vm-launcher rm-out"
TV_IPK = (
    "build/regress/{run}/tvsuite.ipk"  # the test app (tests/regress/tvapp), packed by ares-package
