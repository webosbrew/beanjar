TV_LAYERS = "normal,gl,devmode"  # graphics --tv: developer mode, for the test app's dev/install
SMP_IPK = "build/regress/{run}/smpcheck.ipk"  # the SMP check app (tests/regress/smp), packed by its pack.sh
# A host file into the VM's out share (out-relative), never through the guest's links: the share is
# the guest's, its links real host ones (host/core/beanjar/share.py)
PUT_OUT = "host/scripts/vm-launcher put-out"
# ... and the guest's files out of it: a regular file only, never through a link (the guest's
# links would hand over any file the user can read, its FIFOs hang the read), and a removal never
# through a linked directory
GET_OUT = "host/scripts/vm-launcher get-out"
RM_OUT = "host/scripts/vm-launcher rm-out"
TV_IPK = (
    "build/regress/{run}/tvsuite.ipk"  # the test app (tests/regress/tvapp), packed by ares-package
)
TV_NET = {
    "NET_LINK": "nat",
    "NET_MODE": "direct",
}  # the suite's server runs in the VM's namespace (netns-exec), its network judged as direct's
STANDBY_CPU = 10.0  # QEMU's CPU in standby, % of one host CPU, at most
RESUME_SETTLE = 12  # s from the resume to HOME for its screenshot
SCREENSAVER_WAIT = 60  # s for each screen-saver transition (guest.sh screensaver), times the scale
STANDBY_SETTLE = 2  # s from the standby port to the CPU measure: the micom's
# standby comes first, then the s2idle entry (under 1 s on TCG)
PASSTHROUGH = (
    "NET_LINK",
    "NET_MODE",
