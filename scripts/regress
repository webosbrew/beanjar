# counted as SMP vCPUs (QEMU's TCG threads) against the host's CPUs and its RAM (MEM, else its model's,
# nvm.board_ram) against MemAvailable
JOBS = 2  # measured, docs/dev/guides/build.md "Two lanes": 560 s for six targets, against 1017-1150 s at -j 3 and -j 4
