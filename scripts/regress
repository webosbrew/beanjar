)
DEFAULTS = {
    "graphics": {"LAYERS": "normal,gl", "DISPLAY_BACKEND": "dbus"},
    "headless": {"LAYERS": "normal,headless", "DISPLAY_BACKEND": "none"},
}
M1_WAIT = {"graphics": 10, "headless": 150}  # check-m1's wait for boot-done, once booted / ready
# --local --headless: each target in an instance of its own (launch.instance_env), JOBS at once, each
# counted as SMP vCPUs (QEMU's TCG threads) against the host's CPUs and its RAM (MEM, else its model's,
# nvm.board_ram) against MemAvailable
JOBS = 2  # measured, docs/dev/guides/build.md "Two lanes": 560 s for six targets, against 1017-1150 s at -j 3 and -j 4
PI_JOBS = 2  # --headless over ssh: targets at once by default
HEADROOM_MB = 1024  # of the VM host's MemAvailable left to the host itself and a GUI: the guests' RAM fits in the rest
# the measured peaks of the lanes' QEMUs, on the machine that runs this script (lanemem.Peaks): what
# a headless lane books against MemAvailable once its target has one (lanemem.booking)
PEAKS = os.path.join(TOP, "build", "regress", "peaks.json")
INSTANCE_DEFAULTS = {
    "NET_LINK": "nat",
    "NET_MODE": "direct",
}  # QEMU's own slirp: private, no namespace helpers
# The launcher settings a lane leaves to the launcher's own default: given empty unless passed through, so
# that a target's development VM (its vm.toml, written by whichever run made it, development.prepare) cannot
# carry an earlier run's into this one (an AUDIO=dbus from a graphics run failed every headless start).
# LAYERS, DISPLAY_BACKEND, NET_LINK and NET_MODE are each lane's own; MAC and SERIAL, the VM's identity, are kept.
LAUNCHER_DEFAULTED = (
    "AUDIO",
    "MEM",
    "SMP",
    "ACCEL",
    "PMLOG_DEBUG",
    "KERNEL_ARGS",
    "QEMU_EXTRA",
    "GPU_DEVICE",
    "GUEST_KERNEL",
    "MEDIA_HWDEC",
)
# What a stopped checkout VM must not leave on its host. `pgrep -x` (a remote shell's own command line
# never matches it); QEMU's name is cut to 15 characters (aarch64, or x86_64 for GUEST_KERNEL=x86-64).
ORPHANS = (
    "for p in qemu-system-aar qemu-system-x86 vhost-user-gpu mitmweb slirp4netns beanjar-viewer beanjar-mediahu; do pgrep -ax $p; done; "
    "systemctl --user list-units --no-legend --plain --state=active,activating,deactivating "
    "'beanjar-vm-regress-*' 2>/dev/null; true"
)
_print = threading.Lock()

# set once the run is interrupted (Ctrl-C, SIGTERM, SIGHUP; schedule_hosts): each lane stops at its
# next command (Host.run), its guest step's wait at once, and goes to the stop of its VM
INTERRUPT = threading.Event()


class Interrupted(BaseException):
    """A lane's command not run, or its wait cut short, because the run was interrupted (INTERRUPT).
    Not an Exception: nothing on the way to run_target, which stops the VM, may take it for a
    step's failure."""


def regress_unit(iid):
    """The unit of the regress VM iid (a target; None: the checkout VM), the same on every VM host:
    beanjar-vm-regress-<iid>, in beanjar-regress.slice (vmunits.unit_slice)."""
    return vmunits.regress_unit_name(iid)


class Usage(Exception):
    pass


def say(line):
    say_raw(f"[regress] {line}")


def say_raw(line):
    with _print:
        print(line, flush=True)


def bring_up_targets():
    return [targets.name(p) for p in targets.all_targets() if targets.in_bring_up(p)]


def named_only_targets():
    """The targets run only when named with --target: those in bring-up and those never booted
    (targets.untested_targets)."""
    return sorted(set(bring_up_targets()) | set(targets.untested_targets()))


def all_targets():
    """The supported targets' names, as `host/scripts/vm-launcher config TARGETS` prints them."""
    return [targets.name(p) for p in targets.all_targets()]


def gl_expected(target, top=TOP):
    """Whether the chip enables GL through vendor stand-ins or gl_standard_abi.
    Values absent from its table come from its base (docs/dev/guides/build.md "Layer bases")."""
    chip = leaf = target.split("-")[0]
    stubs = gl = standard = None
    if not os.path.isdir(os.path.join(top, "guest", "layers", "soc", chip)):
        return False  # a chip with no soc layer (NetCast's lm14): no gl layer either
    while chip:
        d = os.path.join(top, "guest", "layers", "soc", chip)
        with open(os.path.join(d, "meson.build")) as f:
            text = f.read()
        standard = standard or re.search(r"^gl_standard_abi\s*=\s*(true|false)", text, re.M)
        stubs = stubs or re.search(r"^gl_vendor_stubs\s*=\s*\[([^]]*)\]", text, re.M)
        gl = gl or re.search(r"^gl_vendor_gl\s*=\s*'([^']*)'", text, re.M)
        try:
            with open(os.path.join(d, "base")) as f:
                chip = f.read().strip()
        except FileNotFoundError:
            chip = None
    if not stubs or not gl:
        raise ValueError(f"guest/layers/soc/{leaf}/meson.build: no gl_vendor_stubs or gl_vendor_gl")
    return bool(stubs.group(1).strip() or gl.group(1) or (standard and standard.group(1) == "true"))


def firmware_dirs():
    """The host's firmware collections (paths.firmware_dirs: config.toml's firmware_dirs)."""
    try:
        return paths.firmware_dirs()
    except ValueError as e:
        raise Usage(str(e)) from None


def find_firmwares(dirs):
    """{target name: {firmware name: its directory}} of the firmware directories in dirs, each by the target
    it resolves to (paths.firmware_target; one that does not resolve is not a firmware of this tree), a
    name in several dirs from the first."""
    found = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if paths.model_of(n) not in targets.MODELS or not os.path.isdir(os.path.join(d, n)):
                continue
            try:
                target = targets.name(paths.firmware_target(os.path.join(d, n), n))
            except ValueError:
                continue
            found.setdefault(target, {}).setdefault(n, os.path.join(d, n))
    return found


def select(want, fws, found, default_fw=paths.FW_NAME):
    """[(target, firmware name)] in TARGETS order: the targets wanted (all but those in bring-up or untested without
    --target: named_only_targets), each with its
    firmware (--fw, else the default firmware, else the only one found that is not a bring-up model's, unless the
    whole target is in bring-up, or of several the one that boots the chip's default board: paths.default_candidates).
    found: find_firmwares(). Usage on anything unclear."""
    known = all_targets()
    for p in want:
        if p not in known:
            raise Usage(f"unknown target {p} (targets: {', '.join(known)})")
    chosen = {}
    for fw in fws:
        target = next((p for p, names in found.items() if fw in names), None)
        if target is None:
            raise Usage(
                f"--fw {fw}: not a firmware of a supported target in the host's firmware collections "
                f"({':'.join(firmware_dirs())})"
            )
        if target in chosen:
            raise Usage(f"--fw given twice for {target}")
        chosen[target] = fw
    out = []
    for p in known:
        if want and p not in want or not want and p in named_only_targets():
            continue
        if p not in chosen:
            # a bring-up model's firmware on a target that is not in bring-up (W21Z on W21P's target) only with --fw
            cands = paths.default_candidates(targets.by_name(p), found.get(p, {}))
            if default_fw in cands:
                chosen[p] = default_fw
            elif len(cands) == 1:
                chosen[p] = cands[0]
            elif not cands:
                raise Usage(
                    f"no firmware for {p} in the host's firmware collections ({':'.join(firmware_dirs())})"
                )
            else:
                raise Usage(f"several firmwares for {p}: {', '.join(cands)}; pick one with --fw")
        out.append((p, chosen[p]))
    return out


def instance_id(target, fw):
    """The INSTANCE a target's lane runs in: the target's name, or for a bring-up model's firmware on a
    target that is not in bring-up (W21Z on W21P's k7lp-kisscurl, only with --fw) <target>-<model>: a
    development VM is bound to one firmware, so the default firmware's VM cannot boot it."""
    model = paths.model_of(fw)
    if model in targets.BRING_UP and not targets.in_bring_up(targets.by_name(target)):
        return f"{target}-{model.lower()}"
    return target


def parser():
    p = argparse.ArgumentParser(
        prog="scripts/regress",
        description="regression run over the supported targets",
        epilog="See the header of scripts/regress and docs/dev/guides/build.md.",
    )
    p.add_argument(
        "--target",
        action="append",
        default=[],
        help="a target to run (repeatable, or comma-separated; "
        "default: every target but those in bring-up, targets.BRING_UP, and the untested ones, "
        "a target file's tested = false)",
    )
    p.add_argument(
        "--fw", action="append", default=[], help="the firmware (name) of its target (repeatable)"
    )
    p.add_argument(
        "--tv",
        action="store_true",
        help="the TV feature suite (luna-info, network, apps, tee, draw, audio, decode) after "
        "the boot, instead of the boot checks; NET_LINK=nat NET_MODE=direct",
    )
    p.add_argument(
        "--tv-steps",
        metavar="LIST",
        help="--tv: only these of its steps (comma-separated; default all of the lane's)",
    )
    p.add_argument(
        "--decode-cases",
        metavar="LIST",
        help="--tv: only these of the decode step's cases "
        "(tvsuite.DECODE_CASES, comma-separated; default all)",
    )
    p.add_argument(
        "--headless",
        action="store_true",
        help="system sanity: LAYERS=normal,headless, no GPU, "
        "ready at tvservice's core-boot-done, no HOME or screenshot",
    )
    p.add_argument(
        "--no-build", action="store_true", help="do not build; check the published files are there"
    )
    p.add_argument(
        "--no-sync",
        action="store_true",
        help="do not sync to the VM host (nor build its host side)",
    )
    p.add_argument(
        "--keep-going", action="store_true", help="go on with the next target after a failure"
    )
    p.add_argument(
        "--timeout", type=int, default=300, metavar="S", help="each step's limit (default 300)"
    )
    p.add_argument(
        "--settle", type=int, default=8, metavar="S", help="HOME to screenshot (default 8)"
    )
    p.add_argument("--run", help="the run's name (default: UTC time, YYYYmmddTHHMMSSZ)")
    p.add_argument(
        "--host",
        metavar="HOST",
        action="append",
        default=[],
        help="a VM host: an ssh destination (repeatable, or comma-separated: the targets are spread "
        "across them; default: $REGRESS_HOST, a comma- or space-separated list); its checkout is the "
        "directory $DEST (default beanjar) in its home",
    )
    p.add_argument("--local", action="store_true", help="boot on this machine instead of over ssh")
    p.add_argument(
        "--commit",
        metavar="REV",
        help="the commit the VM hosts get (default HEAD): its public tree (.github/publish/paths.txt), "
        "pushed to each host's bare repository and checked out there exactly",
    )
    p.add_argument(
        "--private-tree",
        action="store_true",
        help="the commit's whole tree, private paths included, instead of its public tree",
    )
    p.add_argument(
        "--working-tree",
        action="store_true",
        help="sync this checkout's working tree as it is (REGRESS_SYNC), uncommitted and private "
        "files included, instead of a commit",
    )
    p.add_argument("--dry-run", "-n", action="store_true", help="print what would run, run nothing")
    p.add_argument(
        "--viewer",
        action="store_true",
        help="graphics: show each VM in the viewer on the VM host's "
        "desktop (build/viewer/beanjar-viewer --no-audio --no-media), opened at its start and closed "
        "before its stop; what the run tests does not change",
    )
    p.add_argument(
        "--jobs",
        "-j",
        type=int,
        metavar="N",
        help=f"--headless: targets at once, each in an instance "
        f"of its own (default {JOBS} with --local, {PI_JOBS} on each VM host; capped by each host's CPUs and MemAvailable)",
    )
    return p


def meminfo_kb(field="MemAvailable", path="/proc/meminfo"):
    with open(path) as f:
        for line in f:
            k, _, v = line.partition(":")
            if k == field:
                return int(v.split()[0])
    raise ValueError(f"no {field} in {path}")


def start_env(a, fw, net_dump=""):
    """The environment of a target's `vm-launcher start`: the lane's settings, and every other launcher setting
    (LAUNCHER_DEFAULTED) empty where the run does not give it, never the development VM's stored one."""
    env = dict(FW=fw, STATE="none", BUILD="0", **a.vm_env)
    for k in LAUNCHER_DEFAULTED:
        env.setdefault(k, "")
    env["NET_DUMP"] = net_dump
    return env


def cap_jobs(jobs, n_targets, cpus, avail_kb, mems, smp=4, headroom_mb=HEADROOM_MB):
    """(the targets to run at once, why it is fewer than jobs or ""): no more than the targets, the
    host's CPUs over each VM's SMP vCPUs (no overcommit: host_capacity's CPUs, fast_cpus),
    and as many as the RAM of the targets (mems: MiB each, or one number for all) allows: the sum of the n largest
    must fit in MemAvailable less headroom_mb, whichever n run together; at least one."""
    ram = sorted(mems if isinstance(mems, (list, tuple)) else [mems] * n_targets, reverse=True)
    room = avail_kb // 1024 - headroom_mb
    fit = 0
    while fit < len(ram) and sum(ram[: fit + 1]) <= room:
        fit += 1
    limits = [
        (n_targets, f"{n_targets} target(s)"),
        (cpus // smp, f"{cpus} CPUs / {smp} vCPUs per VM"),
        (
            fit,
            f"MemAvailable {avail_kb // 1024} MB less {headroom_mb} MB headroom, guests booking up to "
            f"{ram[0] if ram else 0} MB",
        ),
    ]
    n, why = jobs, ""
    for limit, text in limits:
        if limit < n:
            n, why = limit, text
    return max(n, 1), why


def host_state(a, host, lanes):
    """lanemem.parse_state of the VM host now: MemAvailable, swap and the named lanes' QEMUs'
    VmRSS; None if it cannot be read (a dry run)."""
    rc, text = Host(host, a.dest, a.dry_run).run(lanemem.state_cmd(lanes), 30)
    if rc or a.dry_run:
        return None
    return lanemem.parse_state(text)


def keep_peak(a, store, r):
    """The lane's QEMU's peak into the store (lanemem.Peaks), for the target, mode and its host's
    architecture: a lane that passed, at its model's RAM (not under MEM); one whose own QEMU an OOM
    killed (r.oom's own) as its full RAM."""
    if a.vm_env.get("MEM") or not r.memory.get("ram_mb"):
        return
    oom = bool(r.oom and r.oom["own"])
    peak = r.memory.get("peak_mb")
    if not oom and not (r.ok and peak):
        return
    try:
        kept = store.record(
            r.target,
            r.mode,
            a.traits[r.host]["arch"],
            peak,
            r.memory["ram_mb"],
            a.run,
            r.host or machine_name(),
            oom=oom,
        )
    except OSError as e:
        say(f"{r.target}: keeping its peak: {e}")
        return
    say(
        f"{r.target}: QEMU peak {peak if peak else '-'} MB"
        + (" (OOM: raised to its full RAM)" if oom else "")
        + f"; stored peak {kept['peak_mb']} MB ({kept['run']}, {kept['lanes']} lane(s))"
    )


def machine_name():
    return os.uname().nodename


def memory_table(results):
    """The summary's memory lines: each lane's QEMU peak, its booking and RAM, the host's swap at
    its start and end, and any OOM kill."""
    rows = [r for r in results if r.memory.get("ram_mb")]
    if not rows:
        return ""
    mb = lambda v: "-" if v is None else str(v)  # noqa: E731
    out = ["", "memory (MB): QEMU peak (VmHWM) / booked (rule) / RAM; host swap start -> end"]
    for r in rows:
        m = r.memory
        out.append(
            f"  {r.target}: {mb(m.get('peak_mb'))} / {m['booked_mb']} ({m['rule']}) / {m['ram_mb']}; "
            f"swap {mb(m.get('swap_start_mb'))} -> {mb(m.get('swap_end_mb'))}"
            + (
                "; OOM kill: "
                + (
                    ", ".join(
                        f"{k['victim']} {k['pid']} {mb(k['rss_mb'])} MB" for k in r.oom["kills"]
                    )
                    or "victim unknown"
                )
                if r.oom
                else ""
            )
        )
    return "\n".join(out)


# Targets whose core-boot-done takes ~20 s or more on KVM (the rest 3-7 s): a parallel run starts
# them alternately with the light ones, so two heavy VMs are not booting side by side where avoidable.
HEAVY = ("h13-afro", "m16p-dreadlocks2", "m3-goldilocks")


def interleave(items, heavy=HEAVY):
    """items (each (target, fw)) with the heavy targets and the light ones alternating, heavy first,
    each kind in its own order; the rest of the longer kind at the end."""
    h = [i for i in items if i[0] in heavy]
    l = [i for i in items if i[0] not in heavy]
    out = []
    while h or l:
        for q in (h, l):
            if q:
                out.append(q.pop(0))
    return out


def fast_cpus(n, freqs):
    """The CPUs of a VM host that count for its lanes: n (nproc), or on a big.LITTLE host (its CPUs'
    cpuinfo_max_freq not all the same) only the fastest ones, at most n. The lanes get them without
    overcommit (cap_jobs: CPUs over each VM's vCPUs), so an SBC runs one 4-vCPU lane at a time: a
    ROCK Pi 4 (RK3399: two A72 at 1.8 GHz, four A53 at 1.4 GHz) and a Pi 5 (four A76) one each, the
    lanes spread across the hosts. Measured on the ROCK Pi 4 with two 4-vCPU headless lanes at once:
    core-boot-done 20-55 % later than alone (o18k-goldilocks2 31-33 s alone, 32-44 s paired;
    k24-ombre 39-41 s, 62 s) and one h13-afro of two paired failed bootd's timeout."""
    freqs = [f for f in freqs if f > 0]
    if len(set(freqs)) < 2:
        return n
    return max(1, min(n, freqs.count(max(freqs))))


def host_capacity(h):
    """(CPUs, MemAvailable kB) of the VM host h (this machine without a host, the VM host over ssh;
    its CPUs: fast_cpus)."""
    if not h.host:
        return os.cpu_count() or 1, meminfo_kb()
    rc, out = h.run(
        "nproc; grep MemAvailable /proc/meminfo; "
        "cat /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq 2>/dev/null; true",
        30,
    )
    f = out.split()
    if rc or len(f) < 3 or not f[0].isdigit() or not f[2].isdigit():
        raise RuntimeError(f"cannot read the VM host's CPUs and MemAvailable: {out.strip()}")
    freqs = [int(x) for x in f[4:] if x.isdigit()]
    return fast_cpus(int(f[0]), freqs), int(f[2])


def parse(argv, found=None, env=None):
    """(args, [(target, fw)]); found: find_firmwares() (default: the real firmware directories)."""
    a = parser().parse_args(argv)
    a.target = [x for p in a.target for x in p.split(",") if x]
    if a.timeout <= 0 or a.settle < 0:
        raise Usage("--timeout must be positive, --settle not negative")
    if a.viewer and a.headless:
        raise Usage("--viewer needs a graphics run (no --headless)")
    a.run = a.run or time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    # The run name becomes a path in VM-host shell commands and in the rsync source.
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", a.run):
        raise Usage(f"bad run name {a.run}")
    env = os.environ if env is None else env
    if a.local and a.host:
        raise Usage("--host and --local exclude each other")
    hosts = [h for x in a.host for h in x.split(",")] or re.split(
        r"[,\s]+", env.get("REGRESS_HOST") or ""
    )
    a.hosts = [] if a.local else list(dict.fromkeys(h for h in hosts if h))
    del a.host
    if not a.local and not a.hosts:
        raise Usage(
            "no VM host: give --host HOST (or set REGRESS_HOST) for a run over ssh, or --local to boot on this machine"
        )
    a.dest = env.get("DEST") or "beanjar"
    a.sync = env.get("REGRESS_SYNC") or ""
    # what the VM hosts get: a commit's public tree (REV, default HEAD), its whole tree
    # (--private-tree), or with --working-tree this checkout as it is
    if a.working_tree and (a.commit is not None or a.private_tree):
        raise Usage("--working-tree syncs this checkout: no --commit or --private-tree with it")
    if (a.commit is not None or a.working_tree or a.private_tree) and (a.local or a.no_sync):
        raise Usage(
            "--commit, --private-tree and --working-tree choose what a VM host gets: "
            + ("--local runs this checkout as it is" if a.local else "--no-sync sends nothing")
        )
    if not a.commit and a.commit is not None:
        raise Usage("--commit needs a revision")
    a.tree = (
        None
        if a.local or a.no_sync
        else "working-tree"
        if a.working_tree
        else "private"
        if a.private_tree
        else "public"
    )
    a.pin = (a.commit or "HEAD") if a.tree in ("public", "private") else None
    a.mode = "headless" if a.headless else "graphics"
    a.vm_env = {k: env.get(k) or v for k, v in DEFAULTS[a.mode].items()}
    if env.get("NET"):
        raise Usage(
            "NET is replaced by NET_LINK (nat, off) and NET_MODE (mitm, direct): docs/dev/architecture/network.md"
        )
    if a.tv:
        if any(env.get(k, v) != v for k, v in TV_NET.items()):
            raise Usage(
                "--tv needs NET_LINK=nat NET_MODE=direct: its server runs in the VM's network namespace, and its network checks are direct's"
            )
        a.vm_env.update(TV_NET)
        if not a.headless and not env.get("LAYERS"):
            a.vm_env["LAYERS"] = TV_LAYERS
    lane = [s for s in tvsuite.STEPS if s in TV_STEPS[a.mode]]
    a.tv_steps = [x for x in (a.tv_steps or ",".join(lane)).split(",") if x]
    cases = [c for c, *_ in tvsuite.DECODE_CASES]
    a.decode_cases = [x for x in (a.decode_cases or ",".join(cases)).split(",") if x]
    if [x for x in a.decode_cases if x not in cases]:
        raise Usage(f"--decode-cases: one of {', '.join(cases)}")
    bad = [x for x in a.tv_steps if x not in lane]
    if bad:
        raise Usage(
            f"--tv-steps: {', '.join(bad)} not a step of the {a.mode} TV suite ({', '.join(lane)})"
        )
    # every target in an instance of its own (a development VM is bound to its firmware: the default
    # instance cannot take the next target's); --local --headless JOBS at once, graphics one at a time
    if a.jobs is not None and not a.headless:
        raise Usage("-j/--jobs needs --headless (graphics runs one VM at a time)")
    if a.jobs is not None and a.jobs < 1:
        raise Usage("-j must be at least 1")
    a.jobs = (JOBS if a.local else PI_JOBS) if a.jobs is None else a.jobs
    if not a.headless:
        a.jobs = 1
    a.instances = True
    a.vm_env.update(INSTANCE_DEFAULTS)
    a.vm_env.update({k: env[k] for k in PASSTHROUGH if env.get(k)})
    # the deadlines are for hangs, not for the guest's speed: TCG's factor, as the launcher's for bootd
    # (here the launcher's own choice, which GUEST_KERNEL=x86-64 makes KVM on an x86-64 host, with
    # its userland under qemu-user, which takes TCG's factor: qemu.time_scale)
    a.accel = qemu.vm_accel(a.vm_env) if a.local else (a.vm_env.get("ACCEL") or "kvm")
    userland = (qemu.vm_userland(a.vm_env) if a.local else a.vm_env.get("USERLAND")) or "native"
    a.scale = qemu.time_scale(a.accel, userland)
    a.timeout *= a.scale
    return a, select(a.target, a.fw, find_firmwares(firmware_dirs()) if found is None else found)


class Instance:
    """Where one VM's runtime files are, as `host/scripts/vm-launcher` finds them: the default instance (build/,
    beanjar-vm-regress-default; iid None) or INSTANCE=<iid>'s (launch.instance_env), relative to the VM host's
    checkout. env: what each command of this VM gets in its environment. Each instance is a VM with
    a slot of its own: its ports are on its own address (`host/scripts/vm-launcher config ADDRESS`)."""

    def __init__(self, iid=None):
        self.iid = iid
        if iid is None:
            self.run_dir = self.log_dir = "build"
            self.unit = regress_unit(None)
            self.env = dict(RUN_DIR="build", LOG_DIR="build", UNIT=self.unit)
        else:
            d = os.path.join(TOP, "build", "instances", iid)
            e = launch.instance_env(
                dict(INSTANCE=iid, RUN_DIR=d, LOG_DIR=d, UNIT=regress_unit(iid))
            )
            rel = lambda p: os.path.relpath(p, TOP)  # noqa: E731
            self.run_dir, self.log_dir, self.unit = rel(e["RUN_DIR"]), rel(e["LOG_DIR"]), e["UNIT"]
            # INSTANCE for host/scripts/vm-launcher, its paths for the tests' own tools (standby.py, ir-key.py: RUN_DIR)
            self.env = {k: e[k] for k in ("INSTANCE", "RUN_DIR", "LOG_DIR", "UNIT")}
        self.guest_out = (
            f"{self.run_dir}/share/out/regress"  # RUN_DIR/share/out: the guest's /host/out
        )
        # what this instance may leave running, as a command for the VM host (Host.run, where its
        # checkout's RUN_DIR is in the environment): processes whose command line names RUN_DIR (QEMU's
        # pidfile, the console bridge; NET_MODE=mitm's helpers run inside its unit), its unit if still up.
        # The shell's own command line has "$RUN_DIR" unexpanded, and only builtins see the expansion.
        self.orphans = (
            ORPHANS
            if iid is None
            else (
                "m=\"$RUN_DIR/\"; for f in /proc/[0-9]*/cmdline; do c=$(tr '\\0' ' ' 2>/dev/null < \"$f\") || continue; "
                'case "$c" in *"$m"*) p=${f#/proc/}; echo "${p%/cmdline} $c";; esac; done; '
                f"s=$(systemctl --user is-active {self.unit}.service 2>/dev/null); "
                f'case "$s" in active|activating|deactivating|reloading) echo "{self.unit}.service $s";; esac; true'
            )
        )


class Host:
    """Shell commands on the VM host (in its checkout), or here with --local; printed in dry runs.
    inst: the VM's Instance (its INSTANCE in every command's environment)."""

    def __init__(self, host, dest, dry, inst=None):
        self.host, self.dest, self.dry = host, dest, dry
        self.inst = inst or Instance()
        # a lane's steps run (run_target): once INTERRUPT is set, a command that is not protected
        # raises Interrupted instead of running; False again for the lane's stop
        self.lane = False

    def argv(self, cmd):
        prefix = "".join(f"{k}={shlex.quote(v)} " for k, v in self.inst.env.items())
        if self.host:
            # the VM host's checkout is elsewhere than this one: its paths, from where the command starts
            rel = {"RUN_DIR": self.inst.run_dir, "LOG_DIR": self.inst.log_dir}
            prefix = "".join(
                f'{k}="$PWD"/{shlex.quote(rel[k])} ' if k in rel else f"{k}={shlex.quote(v)} "
                for k, v in self.inst.env.items()
            )
            return [
                "ssh",
                self.host,
                f"cd {shlex.quote(self.dest)} && {'export ' + prefix + '&& ' if prefix else ''}{cmd}",
            ]
        return ["sh", "-c", cmd]

    def run(self, cmd, timeout, protected=False, abort=False):
        """(exit status, output); 124 when timeout passes (the command killed). protected: in a
        session of its own, so an interrupt of the run (Ctrl-C reaches the whole foreground group)
        cannot cut it short: the stop of a VM must finish. In a lane's steps (self.lane), an
        interrupted run (INTERRUPT) raises Interrupted instead of starting the command, and abort
        ends one already running then too (its process group here; a remote command loses its ssh,
        so abort is only for one that ends by itself once the VM is gone: guest_step's waits)."""
        if self.lane and not protected and INTERRUPT.is_set():
            raise Interrupted(cmd)
        where = self.host or "local"
        if self.inst.iid:
            where += f" {self.inst.iid}"
        if self.dry:
            say_raw(f"  [{where}] {cmd}")
            return 0, ""
        if abort and self.lane and not protected:
            return self._run_abortable(cmd, timeout)
        try:
            r = subprocess.run(
                self.argv(cmd),
                cwd=TOP,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=timeout,
                env=dict(os.environ, **self.inst.env) if not self.host else None,
                start_new_session=protected,
            )
        except subprocess.TimeoutExpired as e:
            out = e.output or b""
            return 124, out.decode(errors="replace")
        return r.returncode, r.stdout.decode(errors="replace")

    ABORT_POLL = 0.5  # s between looks at INTERRUPT while an abortable command runs

    def _run_abortable(self, cmd, timeout):
        """Host.run's abort: the command in a session of its own (Ctrl-C does not reach it), its
        process group ended (TERM, then KILL) once INTERRUPT is set, and Interrupted raised."""
        p = subprocess.Popen(
            self.argv(cmd),
            cwd=TOP,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=dict(os.environ, **self.inst.env) if not self.host else None,
            start_new_session=True,
        )
        deadline = time.monotonic() + timeout
        try:
            while True:
                try:
                    out, _ = p.communicate(timeout=self.ABORT_POLL)
                    return p.returncode, out.decode(errors="replace")
                except subprocess.TimeoutExpired:
                    pass
                if INTERRUPT.is_set():
                    raise Interrupted(cmd)
                if time.monotonic() >= deadline:
                    p.kill()
                    out, _ = p.communicate()
                    return 124, (out or b"").decode(errors="replace")
        except BaseException:
            for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
                try:
                    os.killpg(p.pid, sig)
                except ProcessLookupError:
                    break
                try:
                    p.communicate(timeout=wait)
                    break
                except subprocess.TimeoutExpired:
                    pass
            raise


def local(cmd, dry, env=None):
    """A command here (build, sync, copy back); its exit status."""
    shown = " ".join(f"{k}={shlex.quote(v)}" for k, v in (env or {}).items())
    print(f"  [here] {(shown + ' ') if shown else ''}{shlex.join(cmd)}", flush=True)
    if dry:
        return 0
    return subprocess.run(
        cmd, cwd=TOP, env=dict(os.environ, **(env or {})), stdin=subprocess.DEVNULL
    ).returncode


class Result:
    def __init__(self, target, fw, mode="graphics", tv=False):
        self.target, self.fw, self.mode, self.tv = target, fw, mode, tv
        self.steps = {s: "-" for s in (TV_STEPS if tv else STEPS)[mode]}
        self.items = {}  # --tv: {step: [(check, PASS/FAIL/SKIP, reason)]}
        self.boot_done = "-"  # graphics: boot-done; headless: core-boot-done (tv-ready)
        self.tvservice = ""  # headless: tvservice's pids at ready (guest.sh's comma-joined set)
        self.ready_on = None  # headless: what ready saw (guest.sh READY-ON: tv-ready, policy-close)
        self.shot = "-"
        self.window = ("", "")
        self.orphans = ""
        self.text = ""  # the last guest step's output
        self.skipped = ""  # why the target was not run (graphics: no gl layer)
        self.failed = ""  # why the target failed without booting (its firmware not on the VM host)
        self.checklist = []  # [(item, PASS/WARN/FAIL, reason)]: tests/regress/lib/checklist.py
        self.standby = "-"  # the standby step's numbers, or why it was skipped
        self.idle = None  # the idle-cpu step's numbers (idlecpu.measure), for idle-cpu.json
        self.idle_item = None  # its (PASS/WARN/FAIL, reason)
        self.seconds = None  # the target's whole run, start to stopped
        self.instance = None  # its INSTANCE (every target runs in one of its own)
        self.host = None  # the VM host that ran it (None: this machine, or none ran it)
        self.identity = {}  # the started VM's MAC, SERIAL and IDENTITY (vm_identity)
        self.device_census = None  # evidence status only; never a hardware coverage verdict
        # guest restarts followed (follow_restart: a firmware's first-boot restart)
        self.restarts = 0
        self.restart = ""  # a guest restart that failed the target, said
        self.qemu_pid = None  # its QEMU's pid once started (an OOM kill's victim is told by it)
        # its memory: ram_mb, booked_mb and rule (lanemem.booking), peak_mb and rss_mb (its QEMU's
        # VmHWM and VmRSS before the stop), swap_start_mb and swap_end_mb (the host's)
        self.memory = {}
        self.oom = None  # an OOM kill on the host during the lane: {count, kills, own}
        self.interrupted = ""  # the step the run's interrupt stopped the lane at (INTERRUPT)

    @property
    def ok(self):
        # a checklist WARN does not fail the target; its FAIL does; no Quick Start+ skips standby
        return (
            bool(self.skipped)
            or all(v in ("PASS", "WARN", "SKIP", "dry", "not run") for v in self.steps.values())
            and not self.orphans
            and not self.restart
            and not self.oom
            and not self.interrupted
        )

    @property
    def verdict(self):
        """The target's result: SKIP, INTERRUPTED (the run's interrupt stopped it), PASS or FAIL."""
        if self.skipped:
            return "SKIP"
        return "INTERRUPTED" if self.interrupted else "PASS" if self.ok else "FAIL"

    def row(self):
        if self.tv:
            return (
                [self.target, self.mode, self.boot_done]
                + [
                    tvsuite.short(self.items[s]) if self.items.get(s) else self.steps.get(s, "-")
                    for s in tvsuite.STEPS
                ]
                + [
                    f"{self.window[0]}-{self.window[1]}",
                    "-" if self.seconds is None else f"{self.seconds:.0f} s",
                    self.verdict,
                ]
            )
        last = self.shot if self.mode == "graphics" else self.steps["tvservice"]
        cl = checklist.short(self.checklist) if self.checklist else self.steps["checklist"]
        return [
            self.target,
            self.mode,
            self.boot_done,
            *([self.steps["tv-ready"]] if self.mode == "graphics" else []),
            self.steps["check-m1"],
            self.steps["app-calls"],
            cl,
            self.steps["ssh"],
            last,
            idlecpu.cell(self.steps["idle-cpu"], self.idle)
            if self.idle
            else self.steps["idle-cpu"],
            self.standby if self.steps["standby"] in ("PASS", "SKIP") else self.steps["standby"],
            self.steps["capture"],
            f"{self.window[0]}-{self.window[1]}",
            "-" if self.seconds is None else f"{self.seconds:.0f} s",
            self.verdict,
        ]


def table(results, mode="graphics", tv=False, hosts=False):
    """The summary: a row per target (hosts: with the VM host that ran it, before the result),
    then each target's checklist items that are not PASS (--tv: the suite's checks that are not
    PASS)."""
    if tv:
        head = [
            "target",
            "mode",
            "core-boot-done" if mode == "headless" else "boot-done",
            *tvsuite.STEPS,
            "run window (UTC)",
            "total",
            "result",
        ]
    elif mode == "headless":
        head = [
            "target",
            "mode",
            "core-boot-done",
            "check-m1",
            "app-calls",
            "checklist",
            "ssh",
            "tvservice",
            "idle cpu",
            "standby",
            "capture",
            "run window (UTC)",
            "total",
            "result",
        ]
    else:
        head = [
            "target",
            "mode",
            "boot-done",
            "tv-ready",
            "check-m1",
            "app-calls",
            "checklist",
            "ssh",
            "screenshot",
            "idle cpu",
            "standby",
            "capture",
            "run window (UTC)",
            "total",
            "result",
        ]
    rows = [head] + [r.row() for r in results]
    if hosts:
        rows = [
            row[:-1] + [r.host or "-" if r else "host"] + row[-1:]
            for r, row in zip([None, *results], rows)
        ]
        head = rows[0]
    w = [max(len(row[i]) for row in rows) for i in range(len(head))]
    out = ["  ".join(c.ljust(w[i]) for i, c in enumerate(row)).rstrip() for row in rows]
    notes = [
        f"  {r.target}: {s} {item}: {why}"
        for r in results
        for item, s, why in r.checklist
        if s != "PASS"
    ]
    if notes:
        out += ["", "checklist (not PASS):"] + notes
    idle = [f"  {r.target}: {r.idle_item[0]} {r.idle_item[1]}" for r in results if r.idle_item]
    if idle:
        out += ["", "idle cpu (% of one core per window):"] + idle
    fails = [
        f"  {r.target}: {s} {step} {item}: {why}"
        for r in results
        for step, items in r.items.items()
        for item, s, why in items
        if s == "FAIL"
    ]
    if fails:
        out += ["", "TV suite (FAIL):"] + fails
    unrun = [f"  {r.target}: {r.failed}" for r in results if r.failed]
    if unrun:
        out += ["", "not run:"] + unrun
    return "\n".join(out)


def now():
    return time.strftime("%H:%M:%S", time.gmtime())


class GuestRestarted(Exception):
    """The guest restarted itself while a step waited (the unit's count of guest restarts,
    RUN_DIR/restarts, moved past r.restarts, or one is under way, RUN_DIR/restarting: unit.run), or
    powered off (off: QEMU is gone, its pidfile with it): the step's process is gone with the old
    boot, and so is the host share it was put into."""

    def __init__(self, step, off=False):
        super().__init__(step)
        self.step, self.off = step, off


# seconds a failed step looks for a guest restart that killed it (KVM: the reset follows the
# guest's shutdown within a few seconds)
RESTART_SETTLE = 15
# the step wait's status for a guest restart (lifecycle's RUN_DIR/restarting and RUN_DIR/restarts)
# and for a VM that is off (no RUN_DIR/qemu.pid, which QEMU removes as it exits)
RESTARTED, OFF = 3, 4


def restart_check(n):
    """Shell: exit RESTARTED if the guest has restarted more than n times, or a restart is under way;
    OFF if QEMU has exited for good."""
    return (
        f'[ -e "$RUN_DIR/restarting" ] && exit {RESTARTED}; '
        f'n=$(cat "$RUN_DIR/restarts" 2>/dev/null); [ "${{n:-0}}" = {n} ] || exit {RESTARTED}; '
        f'[ -e "$RUN_DIR/qemu.pid" ] || exit {OFF}; '
    )


def check_restart(h, step, rc):
    """Raise GuestRestarted for a restart_check status."""
    if rc in (RESTARTED, OFF):
        raise GuestRestarted(step, off=rc == OFF)


def guest_step(h, a, r, step, arg, out):
    """Type tests/regress/guest.sh STEP on the console (in the background), wait for its .rc, copy
    its output into the target's directory; the step's exit status (124: timed out). Raises
    GuestRestarted if the guest restarts or powers off while the step waits (r.restarts: the
    restarts already followed)."""
    gout, rel = h.inst.guest_out, f"regress/{step}"  # rel: in the out share
    line = f"TIME_SCALE={a.scale} sh /host/tests/regress/guest.sh {step} {arg} </dev/null >/dev/null 2>&1 &".replace(
        "  ", " "
    )
    # a step that runs twice (home-idle, before each screenshot) must not find its last .rc
    rc, text = h.run(
        f"{RM_OUT} {rel}.rc && host/scripts/vm-launcher console {shlex.quote(line)} 1 >/dev/null",
        60,
    )
    seen = getattr(r, "restarts", 0)
    if rc:
        # no console: the VM may be between two QEMUs, or off
        check_restart(h, step, h.run(f"sh -c '{restart_check(seen)}true'", 30)[0])
        return rc
    f = f"{gout}/{step}.rc"
    wait = a.timeout + 20 * a.scale  # the boot step's own limit is TIMEOUT
    rc, _ = h.run(
        f"timeout {wait} sh -c '{restart_check(seen)}until [ -f {f} ]; do sleep 2; {restart_check(seen)}done'",
        wait + 30,
        abort=True,
    )
    if rc:
        h.run(f"{GET_OUT} {rel}.txt {out}/{step}.txt 2>/dev/null; true", 30)
        check_restart(h, step, rc)
        return 124
    r.text = ""
    # the copies are read, not the share's files (only stat'ed above)
    rc, text = h.run(
        f"{GET_OUT} {rel}.txt {out}/{step}.txt && {GET_OUT} {rel}.rc {out}/{step}.rc && "
        f"cat {out}/{step}.rc {out}/{step}.txt",
        30,
    )
    if a.dry_run:
        return 0
    lines = text.splitlines()
    try:
        status = int(lines[0])
        r.text = "\n".join(lines[1:])
    except (IndexError, ValueError):
        status = rc or 1
    if status > 128:
        # a step the guest's shutdown killed (SIGTERM, SIGKILL) writes its .rc before the restart
        # shows on the host
        settle = int(RESTART_SETTLE * a.scale)
        rc, _ = h.run(
            f"timeout {settle} sh -c 'while :; do {restart_check(seen)}sleep 2; done'",
            settle + 30,
            abort=True,
        )
        check_restart(h, step, rc)
    return status


VIEWER_PID = "regress-viewer.pid"


CAPTURE_CTL = "regress-capture.ctl"  # in the run dir: the decode viewer's capture switch
VIEWER_WAV = (
    "host/viewer-media.wav"  # in the target's dir: the viewer's media audio, sliced per case
)


def viewer_args(h, out):
    """What the run's viewer (the --viewer window, or the decode step's headless one) is given: the
    VM's display without its audio (the recording is QEMU's wavcapture) and without the remote
    (ir.sock takes one client, ir-key.py: a path that does not exist); the media decoded and drawn,
    its audio recorded (out/VIEWER_WAV), never played; captures (480x270, one a second) while the
    run dir's CAPTURE_CTL names where (tv_decode)."""
    return (
        f"unix:path=$PWD/{h.inst.run_dir}/dbus.sock --no-audio --media-silent --media-wav {out}/{VIEWER_WAV} "
        f"--capture-control $PWD/{h.inst.run_dir}/{CAPTURE_CTL} "
        f"--ir-socket $PWD/{h.inst.run_dir}/regress-viewer-no-ir.sock"
    )


def viewer(h, out, start, headless=False):
    """--viewer: the VM's D-Bus display in build/viewer/beanjar-viewer on the VM host's desktop (its
    Wayland socket in XDG_RUNTIME_DIR, else X :0), from QEMU's start to the stop, one window for the
    whole run; with headless, the decode step's own viewer when there is no window. viewer_args says
    what it is given; with the media hub (host/helpers/media-helper) it may come and go at any time. Or that
    viewer closed (TERM: its exit reports, then KILL). Its output goes to out/host/viewer.log."""
    pid = f"{h.inst.run_dir}/{VIEWER_PID}"
    if start:
        if headless:
            env, size = "", "--headless --size 960x540 --screenshot-every 1000"
        else:
            env = (
                f"rt=${{XDG_RUNTIME_DIR:-/run/user/$(id -u)}}; w=$(cd $rt 2>/dev/null && ls -d wayland-[0-9]* "
                f"2>/dev/null | grep -v lock | head -n 1); XDG_RUNTIME_DIR=$rt WAYLAND_DISPLAY=$w DISPLAY=${{DISPLAY:-:0}} "
                f"DBUS_SESSION_BUS_ADDRESS=unix:path=$rt/bus "
            )
            size = "--size 1280x720 --capture-every 1000"
        rc, _ = h.run(
            f"mkdir -p {out}/host && rm -f {h.inst.run_dir}/{CAPTURE_CTL} {out}/{VIEWER_WAV} && "
            f"{{ {env}setsid build/viewer/beanjar-viewer {viewer_args(h, out)} {size} "
            f"</dev/null >>{out}/host/viewer.log 2>&1 & echo $! > {pid}; }}",
            30,
        )  # $!: the viewer
        if rc:
            say(f"{out}: the viewer did not start (rc {rc})")
        return
    h.run(
        f"if [ -f {pid} ]; then p=$(cat {pid}); kill $p 2>/dev/null; i=0; "
        f"while kill -0 $p 2>/dev/null && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done; "
        f"kill -9 $p 2>/dev/null; rm -f {pid}; fi; "
        # by its command line too: the pid file's process may not be the viewer's own
        f'pkill -f "[b]eanjar-viewer unix:path=$PWD/{h.inst.run_dir}/dbus.sock "; true',
        30,
    )


def target_of(name):
    return targets.by_name(name)


def checklist_args(target, fw):
    """(the guest step's argument, the broadcast standard) of the checklist: the offset of the release's
    Last_Input_info DB in the EEPROM (0: the table has none), and the broadcast standard of the firmware's paks
    (its directory here, else the release's pak names)."""
    p = target_of(target)
    off = targets.release(p).nvm.lastinput_offset
    fw_dir = next(
        (os.path.join(d, fw) for d in firmware_dirs() if os.path.isdir(os.path.join(d, fw))), None
    )
    return (hex(off) if off else "0"), checklist.broadcast_of_firmware(
        fw_dir, targets.pak_files(p, fw_dir)
    )


def home_shot(h, a, r, out, png, name):
    """HOME once no Home launcher shows by itself, SETTLE s, the screen to png; the exit status."""
    guest_step(h, a, r, "home-idle", 60 * a.scale, out)  # not a step of its own: its text is kept
    # a Home that stays up by itself (webOS 4.5, "HOMESHOWN"): HOME hides it, a second shows it
    home = "python3 tests/regress/ir-key.py && "
    if "HOMESHOWN" in r.text:
        home += f"sleep {a.settle} && " + home
    rc, _ = h.run(
        f"{{ {home}sleep {a.settle} && "
        f"timeout {a.timeout} python3 tests/regress/virgl/dbus-grab.py {png} 3; }} > {out}/{name}.txt 2>&1 "
        f"&& test -s {png}",
        a.timeout + a.settle + 30,
    )
    return rc


def idle_cpu(h, a, r, out, target):
    """The idle-cpu step, once Home is up and settled: guest.sh idle-cpu's idlecpu.WINDOWS windows
    of idlecpu.WINDOW s, then for a flagged process guest.sh idle-threads (its threads' state, wchan
    and syscall, idlecpu.SAMPLES times); judged by idlecpu.judge. r.idle (written to idle-cpu.json
    once the results are here) and r.idle_item; r.steps["idle-cpu"] the item's status, or FAIL or
    TIMEOUT where the sampling did not finish."""
    say(f"{target}: idle cpu ({idlecpu.WINDOWS} x {idlecpu.WINDOW} s)")
    rc = guest_step(h, a, r, "idle-cpu", f"{idlecpu.WINDOW} {idlecpu.WINDOWS}", out)
    if a.dry_run:
        r.steps["idle-cpu"] = "dry"
        return
    data = idlecpu.parse(r.text) if rc == 0 else None
    if data is None:
        r.steps["idle-cpu"] = "TIMEOUT" if rc == 124 else "FAIL"
        r.idle_item = (r.steps["idle-cpu"], f"the sampler did not finish (status {rc})")
        return
    r.idle = idlecpu.measure(data, a.accel)
    if r.idle["flagged"]:
        tids = ",".join(str(t["tid"]) for p in r.idle["flagged"] for t in p["threads"])
        if guest_step(h, a, r, "idle-threads", f"{tids} {idlecpu.SAMPLES}", out) == 0:
            idlecpu.add_threads(r.idle, r.text)
    r.idle_item = idlecpu.judge(r.idle)
    r.steps["idle-cpu"] = r.idle_item[0]
    say(f"{target}:   {r.idle_item[0]} idle-cpu: {r.idle_item[1]}")
    for p in r.idle["flagged"]:
        for t in p["threads"]:
            say(
                f"{target}:     {p['comm']}/{t['comm']} cpu {'/'.join(f'{c:.1f}' for c in t['cpu'])} %, "
                f"wakeups {'/'.join(f'{w:.0f}' for w in t['wakeups'])}/s"
                + "".join(f", {k} {t[k]}" for k in ("wchan", "syscall", "kind") if t.get(k))
            )


def standby(h, a, r, out, rel, target):
    """The standby step (Quick Start+): r.steps["standby"], and r.standby its numbers: the seconds
    from POWER to the standby, QEMU's CPU in it, the seconds from the power key to the wake (host)
    and from the wake line to tvpowerd's Active (guest)."""
    say(f"{target}: standby")
    verdict = "dry" if a.dry_run else "FAIL"
    rc = guest_step(h, a, r, "standby-prep", "", out)
    if a.dry_run:
        r.steps["standby"] = "dry"
    elif rc == 0 and "STANDBY SKIP" in r.text:
        r.steps["standby"], r.standby = "SKIP", "SKIP"
        say(f"{target}:   {r.text.strip()}")
        return
    m = re.search(r"STANDBY READY (\S+) (\S+)", r.text)
    if not a.dry_run and (rc or not m):
        r.steps["standby"] = "TIMEOUT" if rc == 124 else "FAIL"
        return
    pids, tvpowerd = m.groups() if m else ("dry", "dry")
    # graphics: two screen-saver rounds first (guest.sh screensaver), so the power-off below is the
    # one after them; a saver state that stays (Screen Saver Ready, power busy) fails the step
    saver = ""
    if not a.headless:
        rc = guest_step(h, a, r, "screensaver", str(SCREENSAVER_WAIT), out)
        rounds = re.findall(r"^SCREENSAVER [0-9]+ ([0-9.]+) ([0-9.]+)$", r.text, re.M)
        if a.dry_run:
            pass
        elif rc == 0 and "SCREENSAVER SKIP" in r.text:
            saver = "saver - "
        elif rc or "SCREENSAVER PASS" not in r.text:
            say(f"{target}:   screensaver: {r.text.strip() or rc}")
            r.steps["standby"] = "TIMEOUT" if rc == 124 else "FAIL"
            return
        else:
            saver = f"saver {'/'.join(on for on, _ in rounds)}s "
            say(
                f"{target}:   screen saver {', '.join(f'{on} s on, {off} s off' for on, off in rounds)}"
            )
    early = a.headless and os.environ.get("STANDBY_KEY_EARLY")
    if early:
        # test hook (docs/dev/guides/build.md): the power key the moment the standby shows, before the s2idle,
        # which the micom latches; standby.py is started before the power-off, and runs on its own
        h.run(
            f"setsid nohup python3 tests/regress/standby.py wake-early {60 * a.scale} "
            f"> {out}/standby-wake.txt 2>&1 < /dev/null &",
            30,
        )
    if a.headless:
        rc = guest_step(h, a, r, "power-off", "", out)
    else:
        rc, _ = h.run(f"python3 tests/regress/ir-key.py 0x08 > {out}/standby-key.txt 2>&1", 60)
    numbers = {}
    steps = (
        (("wake-wait", 60 * a.scale, "WOKEN"),)
        if early
        else (("wait", 60 * a.scale, "STANDBY"), ("cpu", 5, "CPU"), ("wake", 60 * a.scale, "WOKEN"))
    )
    for what, arg, mark in steps:
        if what == "wake-wait":
            rc, text = h.run(
                f"for i in $(seq {arg}); do grep -qE 'WOKEN|still|no standby' {out}/standby-wake.txt && break; sleep 1; done; "
                f"cat {out}/standby-wake.txt",
                arg + 30,
            )
            found = re.search(rf"^{mark} ([0-9.]+)", text, re.M)
            if not a.dry_run and (rc or not found):
                say(f"{target}:   standby.py wake-early: {text.strip() or rc}")
                r.steps["standby"] = verdict
                return
            numbers["wait"], numbers["cpu"], numbers["wake"] = (
                0.0,
                0.0,
                float(found.group(1)) if found else 0.0,
            )
            continue
        settle = f"sleep {STANDBY_SETTLE}; " if what == "cpu" else ""
        rc, text = h.run(
            f"{settle}python3 tests/regress/standby.py {what} {arg} > {out}/standby-{what}.txt 2>&1; "
            f"s=$?; cat {out}/standby-{what}.txt; exit $s",
            arg + STANDBY_SETTLE + 30,
        )
        found = re.search(rf"^{mark} ([0-9.]+)", text, re.M)
        if not a.dry_run and (rc or not found):
            say(f"{target}:   standby.py {what}: {text.strip() or rc}")
            r.steps["standby"] = verdict
            return
        numbers[what] = float(found.group(1)) if found else 0.0
    rc = guest_step(h, a, r, "resumed", f"{pids} {tvpowerd} {30 * a.scale}", out)
    found = re.search(r"^RESUMED (\S+)", r.text, re.M)
    if not a.dry_run and (rc or not found):
        r.steps["standby"] = "TIMEOUT" if rc == 124 else "FAIL"
        return
    r.standby = saver + (
        f"{numbers['wait']:.1f}s cpu{numbers['cpu']:.0f}% wake{numbers['wake']:.1f}s "
        f"active{found.group(1) if found else '?'}s"
    )
    say(
        f"{target}:   standby {numbers['wait']:.1f} s after POWER, QEMU {numbers['cpu']:.1f} % CPU in it, "
        f"woken {numbers['wake']:.2f} s after the power key, Active {found.group(1) if found else '?'} s "
        f"after the wake line"
    )
    if not a.dry_run and numbers["cpu"] > STANDBY_CPU:
        say(f"{target}:   QEMU used {numbers['cpu']:.1f} % CPU in standby (at most {STANDBY_CPU})")
        r.steps["standby"] = "FAIL"
        return
    if not a.headless:
        # the last app is back (Live TV, black without a signal): HOME shows the UI drawn again,
        # once that app is in front (W18R: a HOME 3.5 s after the resume stayed hidden, one 15 s
        # after it showed)
        h.run(f"sleep {RESUME_SETTLE}", RESUME_SETTLE + 30)
        rc = home_shot(h, a, r, out, f"{rel}/{target}-resume.png", "shot-resume")
        if rc and not a.dry_run:
            r.steps["standby"] = "FAIL"
            return
    r.steps["standby"] = "dry" if a.dry_run else "PASS"


def meminfo(h, out, when):
    """The VM host's free -m and /proc/meminfo into the target's host/meminfo-<when>.txt."""
    h.run(
        f"{{ date -u +%FT%TZ; free -m; cat /proc/meminfo; }} > {out}/host/meminfo-{when}.txt 2>&1; true",
        30,
    )


def qemu_status(h, r, out):
    """The lane's QEMU's VmHWM and VmRSS (lanemem.STATUS_CMD) into r.memory, before the VM stops;
    its status lines in the target's host/qemu-status.txt."""
    _, text = h.run(
        f"{{ {lanemem.STATUS_CMD}; }} > {out}/host/qemu-status.txt 2>&1; cat {out}/host/qemu-status.txt",
        30,
    )
    peak = lanemem.qemu_peak(text)
    if peak:
        r.memory.update(peak)


def oom_count(h):
    """The VM host's OOM kills since its boot (/proc/vmstat oom_kill), or None."""
    _, text = h.run(lanemem.OOM_COUNT_CMD, 30)
    return int(text.strip()) if text.strip().isdigit() else None


def check_oom(h, r, out, since, before):
    """An OOM kill on the VM host since the lane started (oom_count went up) into r.oom: the kernel
    log's victims where it can be read (its lines in the target's host/oom.txt), and whether the
    victim was this lane's own QEMU (own; also when it cannot be told: no readable log, or a victim
    that is no QEMU)."""
    after = oom_count(h)
    if before is None or after is None or after <= before:
        return
    _, text = h.run(
        f"{{ {lanemem.oom_log_cmd(since - 5)}; }} > {out}/host/oom.txt 2>&1; cat {out}/host/oom.txt",
        30,
    )
    kills = lanemem.oom_kills(text)
    own = (
        not kills
        or any(k["pid"] == r.qemu_pid for k in kills)
        or any(not k["victim"].startswith("qemu-system") for k in kills)
    )
    r.oom = {"count": after - before, "kills": kills, "own": own}
    said = (
        ", ".join(
            f"{k['victim']} ({k['pid']}{', ' + str(k['rss_mb']) + ' MB' if k['rss_mb'] else ''})"
            for k in kills
        )
        or "victim unknown (the kernel log is not readable)"
    )
    say(f"{r.target}: OOM kill on the VM host during the lane ({after - before}): {said}: FAIL")


def tv_suite(h, a, r, out, target, fw):
    """--tv: the luna-info and network steps (tests/regress/tv.sh gathers, tvsuite.py judges)."""
    ident = {k: v for k, v in r.identity.items() if k in ("MAC", "SERIAL")}
    ctx = tvsuite.context(target, fw, dict(a.vm_env, **ident))
    for step in tvsuite.STEPS:
        if step in r.steps and step not in a.tv_steps:
            r.steps[step] = "not run"
    if "luna-info" in a.tv_steps:
        tv_luna(h, a, r, out, target, ctx)
    if "network" in a.tv_steps:
        tv_network(h, a, r, out, target, ctx)
    state = dict(installed=False)
    if "apps" in a.tv_steps:
        tv_apps(h, a, r, out, target, ctx, state)
    if "tee" in a.tv_steps:
        tv_tee(h, a, r, out, target, ctx)
    if "draw" in a.tv_steps:
        tv_draw(h, a, r, out, target, state)
    if "histogram" in a.tv_steps:
        tv_histogram(h, a, r, out, target, ctx, state)
    if "gles" in a.tv_steps:
        tv_gles(h, a, r, out, target)
    if "audio" in a.tv_steps:
        tv_audio(h, a, r, out, target, ctx, state)
    if "decode" in a.tv_steps:
        tv_decode(h, a, r, out, target, ctx, state)
    if "smp" in a.tv_steps:
        tv_smp(h, a, r, out, target, ctx)
    if state["installed"]:
        say(f"{target}: remove the test app")
        step = next(
            s
            for s in ("decode", "audio", "histogram", "draw", "apps")
            if s in a.tv_steps and s in r.steps
        )
        gstep(h, a, r, out, "app-remove", tvsuite.TEST_APP, save="apps/testapp.remove")
        if not a.dry_run:
            r.items.setdefault(step, []).append(tvsuite.judge_remove(r.text))
            r.steps[step] = tvsuite.verdict(r.items[step])
    for step in tvsuite.STEPS:
        for item, s, why in r.items.get(step, []):
            if s != "PASS":
                say(f"{target}:   {s} {step} {item}: {why}")
        if r.items.get(step):
            say(f"{target}:   {step}: {tvsuite.counts(r.items[step])}")


def tv_luna(h, a, r, out, target, ctx):
    say(f"{target}: luna-info")
    rc = guest_step(h, a, r, "luna-info", "", out)
    if a.dry_run or rc == 124:
        r.steps["luna-info"] = "dry" if a.dry_run else "TIMEOUT"
    else:
        r.items["luna-info"] = tvsuite.judge_luna(r.text, ctx)
        r.steps["luna-info"] = tvsuite.verdict(r.items["luna-info"])


def test_server(portfile, token, life):
    """The command of the suite's test server (tests/regress/http-token.py) for life s in the VM's
    own network namespace (vm-launcher netns-exec), at tvsuite.TEST_SERVER there: only this VM's
    guest reaches it, and it sees the guest's own address."""
    return (
        f"timeout {life} host/scripts/vm-launcher netns-exec python3 tests/regress/http-token.py "
        f"{tvsuite.TEST_SERVER} {portfile} {token} {life}"
    )


def tv_network(h, a, r, out, target, ctx):
    say(f"{target}: network")
    # the server in the VM's own network namespace, at tvsuite.TEST_SERVER there, for the step only
    # (its own timeout ends it in any case); the host's own view of the name and of connman's
    # online check
    token = os.urandom(8).hex()
    life = int(a.timeout + 60 * a.scale)
    portfile, pidfile = f"{out}/http-port", f"{out}/http-server.pid"
    rc, port = h.run(
        f"rm -f {portfile} && {{ setsid {test_server(portfile, token, life)} "
        f"> {out}/http-server.txt 2>&1 < /dev/null & echo $! > {pidfile}; }} && "
        f"for i in $(seq 100); do [ -s {portfile} ] && break; sleep 0.1; done; cat {portfile}",
        60,
    )
    port = port.strip()
    url = ctx["expect"].get("online", {}).get("url") or "http://lgtvonline.lge.com/"
    _, host_facts = h.run(
        tvsuite.HOST_PROBE.format(
            name=tvsuite.DNS_NAME,
            url=shlex.quote(url),
            host=shlex.quote(re.sub(r"^\w+://|[:/].*$", "", url)),
        ),
        60,
    )
    h.run(f"printf '%s\\n' {shlex.quote(host_facts)} > {out}/network-host.txt", 30)
    if not a.dry_run and (rc or not port.isdigit()):
        r.steps["network"] = "FAIL"
        r.items["network"] = [
            ("http-server", "FAIL", f"the server in the VM's namespace did not start: {port or rc}")
        ]
    else:
        url = f"http://{tvsuite.TEST_SERVER}:{port or 0}/{token}"
        rc = guest_step(h, a, r, "network", f"{url} {tvsuite.DNS_NAME}", out)
        _, served = h.run(f"cat {out}/http-server.txt", 30)
        if a.dry_run or rc == 124:
            r.steps["network"] = "dry" if a.dry_run else "TIMEOUT"
        else:
            r.items["network"] = tvsuite.judge_network(
                r.text, ctx, token=token, served=served, host=host_facts
            )
            r.steps["network"] = tvsuite.verdict(r.items["network"])
    h.run(f"[ -s {pidfile} ] && kill $(cat {pidfile}) 2>/dev/null; true", 30)


def tv_tee(h, a, r, out, target, ctx):
    """--tv tee: the TEE through the firmware's own client (tv.sh tee, tests/regress/tee/tee-probe), judged
    against the VM's own identity/tee-huk (tvsuite.judge_tee); SKIP where the firmware has no
    client."""
    say(f"{target}: tee")
    plan = tvsuite.tee_plan(ctx["expect"], target)
    if plan is None or a.dry_run:
        r.items["tee"] = tvsuite.judge_tee("", ctx["expect"])
        r.steps["tee"] = "dry" if a.dry_run else tvsuite.verdict(r.items["tee"])
        return
    lib, tas = plan
    gstep(h, a, r, out, "tee", lib, tvsuite.SSTORE_UUID, *tas)
    ident = r.identity.get("IDENTITY") or a.vm_env.get("IDENTITY_DIR", "local")
    _, huk = h.run(f"cat {shlex.quote(ident)}/tee-huk 2>/dev/null", 30)
    r.items["tee"] = tvsuite.judge_tee(r.text, ctx["expect"], huk.strip() or None)
    r.steps["tee"] = tvsuite.verdict(r.items["tee"])


def sizes(*paths):
    """Shell printing each file's size, 0 for one not there yet, so the marks stay in place
    (a bare `stat` skips a missing file and shifts the rest)."""
    return "; ".join(f"stat -c %s {p} 2>/dev/null || echo 0" for p in paths)


def gstep(h, a, r, out, step, *args, save=None):
    """guest_step with its arguments quoted for the guest's shell; its output also kept as
    out/SAVE.txt. r.text is the output ("" when the step failed)."""
    rc = guest_step(h, a, r, step, " ".join(shlex.quote(str(x)) for x in args), out)
    if rc:
        r.text = ""
    if save:
        h.run(f"cp {out}/{step}.txt {out}/{save}.txt 2>/dev/null; true", 30)
    return rc


def keys(h, codes):
    """The remote's buttons (ir-key.py, the micom's IR path)."""
    h.run("python3 tests/regress/ir-key.py " + " ".join(hex(c) for c in codes), 60)


def grab(h, a, png):
    """The screen (dbus-grab.py) to png; image_facts of it, judged here."""
    rc, text = h.run(
        f"timeout {a.timeout} python3 tests/regress/virgl/dbus-grab.py {png} 3 > {png[:-4]}.grab.txt 2>&1 && "
        f"python3 tests/regress/lib/tvsuite.py image {png}",
        a.timeout + 60,
    )
    if a.dry_run:
        return None
    try:
        return json.loads(text.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return dict(error=f"dbus-grab.py or the image facts failed ({rc}): {text.strip()[-160:]}")


def tv_app(h, a, r, out, role, row, state, params="{}"):
    """One app's launch, keys, screenshot and close (tests/regress/tv.sh app-*): its judge's item.
    state["crashes"]: the crash reports the last app's facts ended with."""
    lane, limit, app_id = a.mode, 40 * a.scale, row.get("id")
    design = lane == "headless" and not (row.get("headless") or {}).get("runs", True)
    png = f"{out}/apps/{role}.png"
    img, after = None, ""

    def judged(launch, after, close):
        item = tvsuite.judge_app(
            role, row, launch, after, close, img, lane, state.get("crashes"), r.target
        )
        last = tvsuite.parse(close or after or launch)
        if "crashes" in last:
            state["crashes"] = tvsuite.crashes(last)
        return item

    if row.get("kind") == "key":
        # webOS 1 and 2's launcher, the compositor's: HOME shows it, HOME again hides it
        keys(h, [tvsuite.HOME_KEY])
        h.run(f"sleep {a.settle}", a.settle + 30)
        gstep(h, a, r, out, "app-state", lane, save=f"apps/{role}.launch")
        launch = r.text
        keys(h, tvsuite.NAV_KEYS)
        gstep(h, a, r, out, "app-state", lane, save=f"apps/{role}.keys")
        after = r.text
        img = grab(h, a, png)
        keys(h, [tvsuite.HOME_KEY])
        h.run(f"sleep {a.settle}", a.settle + 30)
        gstep(h, a, r, out, "app-state", lane, save=f"apps/{role}.close")
        return judged(launch, after, r.text)
    if not app_id:
        return tvsuite.judge_app(role, row, "", "", "", None, lane)
    # an app that cannot stay up headless: launched, then a look after a pause, no wait for it
    gstep(
        h,
        a,
        r,
        out,
        "app-launch",
        app_id,
        params,
        lane,
        0 if design else limit,
        *([row["eula"]["screen"]] if (row.get("eula") or {}).get("screen") else []),
        save=f"apps/{role}.launch",
    )
    launch = r.text
    if "present=no" in launch:
        # sam does not know it (getAppInfo before the launch): nothing launched or to close
        return judged(launch, "", "")
    # LG's terms screen in the app's place (terms the set has not agreed to): it gets the keys and
    # the close (tvsuite.terms_first)
    app_id = tvsuite.terms_first(row, launch) or app_id
    up = "front_wait=none" not in launch and "TV FACTS END" in launch
    if up and lane == "graphics":
        keys(h, tvsuite.NAV_KEYS)
        h.run(f"sleep {a.settle}", a.settle + 30)
        gstep(h, a, r, out, "app-state", lane, save=f"apps/{role}.keys")
        after = r.text
        img = grab(h, a, png)
    elif up or design:
        # an app that cannot run headless is looked at again until sam no longer lists it (up to 6
        # times): one that ends by crashing stays listed while crashd writes its report, which
        # under TCG with other VMs takes tens of seconds
        for _ in range(6 if design else 1):
            h.run(f"sleep {5 * a.scale}", 5 * a.scale + 30)
            gstep(h, a, r, out, "app-state", lane, save=f"apps/{role}.keys")
            after = r.text
            if not tvsuite.running_entry(tvsuite.parse(after).get("running"), app_id):
                break
    gstep(h, a, r, out, "app-close", app_id, 20 * a.scale, lane, save=f"apps/{role}.close")
    return judged(launch, after, r.text)


def install(h, a, r, out, target, state):
    """The test app's dev/install (once): its item."""
    say(f"{target}: install the test app (dev/install)")
    h.run(f"{PUT_OUT} {TV_IPK.format(run=a.run)} regress/tvsuite.ipk >/dev/null", 30)
    gstep(
        h,
        a,
        r,
        out,
        "app-install",
        "/mnt/host/out/regress/tvsuite.ipk",
        tvsuite.TEST_APP,
        save="apps/testapp.install",
    )
    item = tvsuite.judge_install(r.text)
    # remove it at the end whatever the answer: a half-done install may have left it
    state["installed"] = True
    state["ok"] = item[1] == "PASS"
    return item


def tv_apps(h, a, r, out, target, ctx, state):
    """--tv apps: each stock app of the target (the expected table's apps) launched, in front, the
    remote's keys, still in front in the same process, its screenshot (graphics), closed;
    graphics: our test app installed and the same. Headless: launched and running only."""
    say(f"{target}: apps")
    h.run(f"mkdir -p {out}/apps", 30)
    run, items = tvsuite.app_plan(ctx["expect"], a.mode)
    items = list(items)
    for role, row in run:
        say(f"{target}:   {role}: {row.get('id') or row.get('what')}")
        items.append(tv_app(h, a, r, out, role, row, state))
    if a.mode == "graphics":
        items.append(install(h, a, r, out, target, state))
        row = dict(present=True, id=tvsuite.TEST_APP, type="web", what="the test web app")
        items.append(
            tv_app(h, a, r, out, "testapp", row, state, '{"mode":"canvas"}')
            if state["ok"]
            else ("app.testapp", "FAIL", "not installed")
        )
    if a.dry_run:
        r.steps["apps"] = "dry"
        return
    r.items["apps"] = items
    r.steps["apps"] = tvsuite.verdict(items)


def tv_draw(h, a, r, out, target, state):
    """--tv draw: the test app's pattern with canvas 2D and with WebGL, on the screen where it puts
    it (tvsuite.judge_draw)."""
    say(f"{target}: draw")
    h.run(f"mkdir -p {out}/apps", 30)
    items = []
    if not state["installed"]:
        items.append(install(h, a, r, out, target, state))
    for mode in tvsuite.pattern()["modes"]:
        if not state.get("ok"):
            items.append((f"draw.{mode}", "FAIL", "the test app is not installed"))
            continue
        gstep(
            h,
            a,
            r,
            out,
            "app-launch",
            tvsuite.TEST_APP,
            json.dumps({"mode": mode}, separators=(",", ":")),
            a.mode,
            40 * a.scale,
            save=f"apps/draw-{mode}.launch",
        )
        if "front_wait=none" in r.text or "TV FACTS END" not in r.text:
            items.append(
                (f"draw.{mode}", "FAIL", f"the test app is not in front: {r.text.strip()[-160:]}")
            )
        else:
            h.run(f"sleep {a.settle}", a.settle + 30)
            facts = tvsuite.parse(r.text)
            item = tvsuite.judge_draw(mode, grab(h, a, f"{out}/apps/draw-{mode}.png"))
            if item[1] == "FAIL" and facts.get("console"):
                item = (item[0], item[1], f"{item[2]}; the page logged: {facts['console'][:200]}")
            items.append(item)
        gstep(
            h,
            a,
            r,
            out,
            "app-close",
            tvsuite.TEST_APP,
            20 * a.scale,
            a.mode,
            save=f"apps/draw-{mode}.close",
        )
    if a.dry_run:
        r.steps["draw"] = "dry"
        return
    r.items["draw"] = items
    r.steps["draw"] = tvsuite.verdict(items)


def tv_histogram(h, a, r, out, target, ctx, state):
    """--tv histogram: the test app's histogram picture, a screenshot of it, and libvtcapture's
    histogram calls on it through the firmware's vtCaptureTestSuite (tv.sh histogram), judged
    against a real set's region map (tvsuite.judge_histogram); SKIP where the expected table says
    the firmware has no working calls."""
    say(f"{target}: histogram")
    suite, items = tvsuite.histogram_plan(ctx["expect"], a.mode)
    if suite is None or a.dry_run:
        r.items["histogram"] = items
        r.steps["histogram"] = "dry" if a.dry_run else tvsuite.verdict(items)
        return
    h.run(f"mkdir -p {out}/apps", 30)
    if not state["installed"]:
        items.append(install(h, a, r, out, target, state))
    if not state.get("ok"):
        items.append(("histogram.calls", "FAIL", "the test app is not installed"))
    else:
        gstep(
            h,
            a,
            r,
            out,
            "app-launch",
            tvsuite.TEST_APP,
            json.dumps({"mode": "histogram"}, separators=(",", ":")),
            a.mode,
            40 * a.scale,
            save="apps/histogram.launch",
        )
        if "front_wait=none" in r.text or "TV FACTS END" not in r.text:
            items.append(
                (
                    "histogram.calls",
                    "FAIL",
                    f"the test app is not in front: {r.text.strip()[-160:]}",
                )
            )
        else:
            h.run(f"sleep {a.settle}", a.settle + 30)
            grab(h, a, f"{out}/apps/histogram.png")
            gstep(h, a, r, out, "histogram", suite)
            items += tvsuite.judge_histogram(r.text)
        gstep(
            h,
            a,
            r,
            out,
            "app-close",
            tvsuite.TEST_APP,
            20 * a.scale,
            a.mode,
            save="apps/histogram.close",
        )
    r.items["histogram"] = items
    r.steps["histogram"] = tvsuite.verdict(items)


def tv_gles(h, a, r, out, target):
    """--tv gles: the OpenGL ES version an app gets (tv.sh gles, the gl layer's gles-version) and
    the launch log's GL renderer (qemu.out), judged against the TV's version and the measured
    host table (tvsuite.judge_gles)."""
    say(f"{target}: gles")
    gstep(h, a, r, out, "gles")
    if a.dry_run:
        r.steps["gles"] = "dry"
        return
    # the launcher's own output (the unit's LOG_DIR/qemu.out), with start's
    _, launch = h.run(f"cat {out}/start.txt {h.inst.log_dir}/qemu.out 2>/dev/null", 30)
    r.items["gles"] = tvsuite.judge_gles(r.text, launch)
    r.steps["gles"] = tvsuite.verdict(r.items["gles"])


def record(h, a, wav, start):
    """QEMU's WAV tap of the card (tests/regress/audio/capture.py) on or off; its exit status."""
    rc, text = h.run(
        f"python3 tests/regress/audio/capture.py start {wav}"
        if start
        else "python3 tests/regress/audio/capture.py stop",
        60,
    )
    if rc:
        say(f"  capture: {text.strip()[-200:]}")
    return rc


def tones(h, a, wav, freqs):
    """tvsuite.tone_facts of a recording, computed on the VM host."""
    rc, text = h.run(
        f"python3 tests/regress/lib/tvsuite.py tones {wav} {','.join(map(str, freqs))}", 300
    )
    if a.dry_run:
        return None
    try:
        return json.loads(text.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return dict(error=f"the tone facts failed ({rc}): {text.strip()[-160:]}")


def tv_audio(h, a, r, out, target, ctx, state):
    """--tv audio: tones through the firmware's own sound path to the card, recorded by QEMU on the
    VM host (tests/regress/audio/capture.py) and judged by frequency and level (tvsuite.judge_audio): a
    native client's (paplay into PulseAudio) at the set's volume, after volumeDown, muted, and
    restored, with the Audio API's getVolume read back; graphics: the test app's WebAudio tone."""
    say(f"{target}: audio")
    row = ctx["expect"].get("audio") or {}
    # the tones are made beside the share (in the run directory), then put into it
    made = f"{h.inst.run_dir}/regress-tones"
    h.run(f"mkdir -p {out}/audio {made}", 30)
    freqs = [f for _, f in tvsuite.AUDIO_PHASES + tvsuite.ALSA_TONES]
    for name, f in tvsuite.AUDIO_PHASES + tvsuite.ALSA_TONES:
        h.run(
            f"python3 tests/regress/audio/check-audio.py --make-tone {made}/{name}.wav --freq {f} "
            f"--seconds {tvsuite.AUDIO_SECONDS} --level {tvsuite.AUDIO_LEVEL} >/dev/null && "
            f"{PUT_OUT} {made}/{name}.wav regress/tones/{name}.wav >/dev/null",
            60,
        )
    h.run(f"rm -rf {made}", 30)
    facts, web = None, None
    if row.get("api", {}).get("present", True):
        wav = f"{out}/audio/volume.wav"
        if record(h, a, wav, True) == 0:
            svc = row.get("service", tvsuite.AUDIO_SERVICE)
            hw = row.get("alsa_hw") or {}
            gstep(
                h,
                a,
                r,
                out,
                "audio",
                "/mnt/host/out/regress/tones",
                svc,
                tvsuite.AUDIO_STEPS,
                (row.get("readback") or {}).get("uri", svc + "/getVolume"),
                hw.get("device") if hw.get("present") else "-",
            )
            text = r.text
            record(h, a, wav, False)
            facts = (text, tones(h, a, wav, freqs + [tvsuite.WEBAUDIO_HZ]))
        else:
            facts = ("", dict(error="QEMU's wavcapture did not start"))
    if a.mode == "graphics":
        if not state["installed"]:
            install(h, a, r, out, target, state)
        if state.get("ok"):
            wav = f"{out}/audio/webaudio.wav"
            record(h, a, wav, True)
            params = json.dumps(
                {"mode": "audio", "freq": tvsuite.WEBAUDIO_HZ, "seconds": tvsuite.AUDIO_SECONDS},
                separators=(",", ":"),
            )
            gstep(
                h,
                a,
                r,
                out,
                "app-launch",
                tvsuite.TEST_APP,
                params,
                a.mode,
                40 * a.scale,
                save="audio/webaudio.launch",
            )
            launch = r.text
            h.run(f"sleep {tvsuite.AUDIO_SECONDS + 3 * a.scale}", 60 * a.scale)
            record(h, a, wav, False)
            gstep(
                h,
                a,
                r,
                out,
                "app-close",
                tvsuite.TEST_APP,
                20 * a.scale,
                a.mode,
                save="audio/webaudio.close",
            )
            web = (launch, tones(h, a, wav, freqs + [tvsuite.WEBAUDIO_HZ]))
        else:
            web = ("", dict(error="the test app is not installed"))
    if a.dry_run:
        r.steps["audio"] = "dry"
        return
    r.items["audio"] = tvsuite.judge_audio(facts, web, row, a.mode)
    r.steps["audio"] = tvsuite.verdict(r.items["audio"])


def tv_decode(h, a, r, out, target, ctx, state):
    """--tv decode: the test app plays each case of tvsuite.DECODE_CASES the target's decode row
    expects, with <video> or with its Media Source player, while the run's viewer (the --viewer
    window, else one started for the step; the media hub serves it) decodes and records what the
    guest's sinks send; each case gets its part of the viewer's log and audio and its captures
    (decode/<case>/), judged on those and the page's events (tvsuite.judge_decode). Headless: SKIP."""
    say(f"{target}: decode")
    run, items = tvsuite.decode_plan(ctx["expect"].get("decode"), a.mode)
    run = [x for x in run if x[0] in a.decode_cases]
    items = [x for x in items if x[0][len("decode.") :] in a.decode_cases]
    if run and not state["installed"]:
        items.append(install(h, a, r, out, target, state))
    if run and not a.viewer:
        viewer(h, out, True, headless=True)  # the step's viewer; with --viewer the run's window
    log, wav, ctl = (
        f"{out}/host/viewer.log",
        f"{out}/{VIEWER_WAV}",
        f"{h.inst.run_dir}/{CAPTURE_CTL}",
    )
    helper_log = f"{h.inst.run_dir}/media/media-helper.log"
    # the page's beacons (its log lines as GETs) to the test server in the VM's own namespace: not
    # every firmware's WebAppMgr puts the app's console in PmLog
    token = os.urandom(8).hex()
    life = int(len(run) * 120 * a.scale + 60)
    portfile, pidfile, served = (
        f"{out}/decode/http-port",
        f"{out}/decode/http-server.pid",
        f"{out}/decode/http-server.txt",
    )
    port = ""
    if run:
        _, port = h.run(
            f"mkdir -p {out}/decode && rm -f {portfile} && {{ setsid {test_server(portfile, token, life)} "
            f"> {served} 2>&1 < /dev/null & "
            f"echo $! > {pidfile}; }} && for i in $(seq 100); do [ -s {portfile} ] && break; sleep 0.1; done; "
            f"cat {portfile}",
            60,
        )
        port = port.strip()
    for case, path, vc, ac, exp in run:
        say(f"{target}:   {case}")
        d = f"{out}/decode/{case}"
        if not state.get("ok"):
            items.append((f"decode.{case}", "FAIL", "the test app is not installed"))
            continue
        # the case's part of the viewer's log and audio: their sizes now and after the close;
        # its captures: CAPTURE_CTL names d while the case runs
        _, marks = h.run(
            f"rm -rf {d} && mkdir -p {d} && echo $PWD/{d}/shot.ppm > {ctl} && "
            f"{{ {sizes(log, wav, helper_log)}; }}; true",
            30,
        )
        h.run(f"sleep {2 * a.scale}", 30 * a.scale)
        params = json.dumps(
            {
                "mode": "decode",
                "case": case,
                "seconds": tvsuite.DECODE_PAGE,
                "log": f"http://{tvsuite.TEST_SERVER}:{port or 0}/{token}/",
            },
            separators=(",", ":"),
        )
        gstep(
            h,
            a,
            r,
            out,
            "app-launch",
            tvsuite.TEST_APP,
            params,
            a.mode,
            40 * a.scale,
            save=f"decode/{case}.launch",
        )
        launch = r.text
        page = ""
        if "front_wait=none" in launch or "TV FACTS END" not in launch:
            item = (
                f"decode.{case}",
                "FAIL",
                f"the test app is not in front: {launch.strip()[-160:]}",
            )
        else:
            # the page logs its end at "ended" (the clip's 8 s) or after DECODE_PAGE s
            h.run(f"sleep {int(tvsuite.DECODE_CLIP + 4) * a.scale}", 60 * a.scale)
            for _ in range(5):
                _, beacons = h.run(f"cat {served}", 30)
                lines = tvsuite.beacon_lines(beacons, token, case)
                if any(ln.startswith("end ") for ln in lines):
                    break
                h.run(f"sleep {4 * a.scale}", 30 * a.scale)
            gstep(h, a, r, out, "decode-log", case, save=f"decode/{case}.page")
            # the beacons' lines where they came, else the console's from PmLog
            page = (
                r.text
                if not lines
                else "\n".join("page=" + ln for ln in lines)
                + "\n"
                + "\n".join(ln for ln in r.text.splitlines() if not ln.startswith("page="))
            )
            h.run(f"printf '%s\\n' {shlex.quote(page)} > {out}/decode/{case}.facts.txt", 30)
            item = None
        gstep(
            h,
            a,
            r,
            out,
            "app-close",
            tvsuite.TEST_APP,
            20 * a.scale,
            a.mode,
            save=f"decode/{case}.close",
        )
        h.run(
            f"sleep {2 * a.scale}; rm -f {ctl}", 30 * a.scale
        )  # the close's reports, then no captures
        start = (marks.split() + ["0", "0", "0"])[:3]
        h.run(
            f"python3 tests/regress/lib/tvsuite.py slice {log} {start[0]} {d}/viewer.log && "
            f"python3 tests/regress/lib/tvsuite.py slice {wav} {start[1]} {d}/media.wav && "
            f"python3 tests/regress/lib/tvsuite.py slice {helper_log} {start[2]} {d}/media-helper.log; "
            f"tail -c 4096 {h.inst.run_dir}/sound-status > {d}/sound-status 2>/dev/null; true",  # the TV's volume
            60,
        )
        if item is None and not a.dry_run:
            rc, text = h.run(f"python3 tests/regress/lib/tvsuite.py media {d} --prune", 120)
            try:
                media = json.loads(text.strip().splitlines()[-1])
            except (ValueError, IndexError):
                media = dict(error=f"media facts failed ({rc}): {text.strip()[-160:]}")
            before = sorted(tvsuite.crashes(tvsuite.parse(launch)))
            item = tvsuite.judge_decode(
                case, path, vc, ac, exp, tvsuite.page_facts(page), media, before
            )
        if item:
            items.append(item)
            say(f"{target}:     {item[1]} {item[2][:200]}")
    if run:
        h.run(
            f"[ -s {pidfile} ] && kill $(cat {pidfile}) 2>/dev/null; rm -f {wav}; true", 30
        )  # sliced
    if run and not a.viewer:
        viewer(h, out, False)
    if a.dry_run:
        r.steps["decode"] = "dry"
        return
    r.items["decode"] = items
    r.steps["decode"] = tvsuite.verdict(items)


def tv_smp(h, a, r, out, target, ctx):
    """--tv smp: the SMP check app (tests/regress/smp) installed with dev/install, run by sam while the run's
    viewer (the --viewer window, else a headless one) decodes what the sink sends; its lines and the
    viewer's log judged (tvsuite.judge_smp); removed. Headless, or a firmware whose StarfishMediaAPIs
    library lacks a symbol the app looks up (the expected table's smp row): SKIP."""
    say(f"{target}: smp")
    skip = (
        [("smp.frameready", "SKIP", tvsuite.SMP_HEADLESS)]
        if a.mode != "graphics"
        else tvsuite.smp_plan(ctx["expect"])
    )
    if skip:
        r.items["smp"] = skip
        r.steps["smp"] = tvsuite.verdict(skip)
        return
    d = f"{out}/smp"
    h.run(
        f"mkdir -p {d} && {PUT_OUT} {SMP_IPK.format(run=a.run)} regress/smpcheck.ipk >/dev/null", 30
    )
    gstep(
        h,
        a,
        r,
        out,
        "app-install",
        "/mnt/host/out/regress/smpcheck.ipk",
        tvsuite.SMP_APP,
        save="smp/install",
    )
    items = [tvsuite.judge_install(r.text, tvsuite.SMP_APP)]
    if items[0][1] == "PASS":
        if not a.viewer:
            viewer(h, out, True, headless=True)
        log, ctl = f"{out}/host/viewer.log", f"{h.inst.run_dir}/{CAPTURE_CTL}"
        helper_log = f"{h.inst.run_dir}/media/media-helper.log"
        # the viewer's log from here on, and its captures while the app runs (one kept, to look at)
        _, mark = h.run(f"echo $PWD/{d}/shot.ppm > {ctl} && {{ {sizes(log, helper_log)}; }}", 30)
        gstep(h, a, r, out, "smp", tvsuite.SMP_APP, 60, save="smp/run")
        text = r.text
        h.run(f"sleep {2 * a.scale}; rm -f {ctl}", 30 * a.scale)
        start = (mark.split() + ["0", "0"])[:2]
        h.run(
            f"python3 tests/regress/lib/tvsuite.py slice {log} {start[0]} {d}/viewer.log && "
            f"python3 tests/regress/lib/tvsuite.py slice {helper_log} {start[1]} {d}/media-helper.log; true",
            60,
        )
        if not a.viewer:
            viewer(h, out, False)
        media = {}
        if not a.dry_run:
            rc, ftext = h.run(f"python3 tests/regress/lib/tvsuite.py media {d} --prune", 120)
            try:
                media = json.loads(ftext.strip().splitlines()[-1])
            except (ValueError, IndexError):
                media = dict(error=f"media facts failed ({rc}): {ftext.strip()[-160:]}")
            items.append(tvsuite.judge_smp(text, media))
            say(f"{target}:     {items[-1][1]} {items[-1][2][:200]}")
    gstep(h, a, r, out, "app-remove", tvsuite.SMP_APP, save="smp/remove")
    if not a.dry_run:
        items.append(tvsuite.judge_remove(r.text, tvsuite.SMP_APP))
    r.items["smp"] = items
    r.steps["smp"] = "dry" if a.dry_run else tvsuite.verdict(items)


def vm_identity(h, a):
    """The started VM's identity, as its launcher has it: {MAC, SERIAL, IDENTITY} (a development VM
    has its own MAC, serial and identity directory, with its tee-huk); {} on a dry run."""
    if a.dry_run:
        return {}
    _, text = h.run(
        "for k in MAC SERIAL IDENTITY; do printf '%s=' $k; host/scripts/vm-launcher config $k; done",
        60,
    )
    return {
        k: v
        for k, _, v in (x.partition("=") for x in text.splitlines())
        if k in ("MAC", "SERIAL", "IDENTITY") and v
    }


# What the guest's steps run from the host share (/mnt/host/PATH in webOS), put into it once the VM
# has started (vm-launcher put): every run's, the boot checks', and the TV suite's in either lane and
# in graphics only (the gl layer's gles-version, which a target without the gl layer has not; the
# histogram probe, whose step needs a front end)
PUT_ALWAYS = ("tests/regress/guest.sh", "tests/regress/lb-exit.sh", "tests/regress/idle-cpu.sh")
PUT_BOOT = ("tests/regress/tvservice/app-calls.sh",)
PUT_TV = ("tests/regress/tv.sh", "build/tests/regress/tee")
PUT_TV_GRAPHICS = ("build/tests/regress/histogram", "build/tests/gl/gles-version")


def share_paths(a):
    """The checkout paths a run's steps need in the VM's host share (PUT_*)."""
    if not a.tv:
        return PUT_ALWAYS + PUT_BOOT
    return PUT_ALWAYS + PUT_TV + (PUT_TV_GRAPHICS if a.mode == "graphics" else ())


def boot_and_check(h, a, r, out, rel, target, fw):
    """A started VM's steps, from the guest's scripts put into its share and the boot step to the
    standby (--tv: the suite); each step's verdict in r.steps. Raises GuestRestarted from the step
    that a guest restart interrupted."""
    verdict = {0: "dry" if a.dry_run else "PASS", 124: "TIMEOUT"}
    net_off = a.vm_env.get("NET_LINK", "nat") == "off"
    rc, _ = h.run(f"host/scripts/vm-launcher put {' '.join(share_paths(a))} >/dev/null", 60)
    if rc:
        r.steps["boot"] = "FAIL"
        return
    boot, mark = ("ready", "READY ") if a.headless else ("boot", "BOOTDONE ")
    say(
        f"{target}: waiting for {'core-boot-done from tv-ready' if a.headless else 'boot-done'} "
        f"(up to {a.timeout} s)"
    )
    rc = guest_step(h, a, r, boot, a.timeout, out)
    r.steps[boot] = verdict.get(rc, "FAIL")
    # the mark's line, wherever it is: a guest shell's job notice ("Terminated", a luna-send its
    # 10 s timeout ended on a loaded TCG host) may come before it
    line = next((x for x in r.text.splitlines() if x.startswith(mark)), None)
    if a.dry_run:
        r.boot_done = "dry"
    elif rc == 0 and line:
        meminfo(h, out, "ready")
        r.boot_done = f"{float(line.split()[1]):.1f} s"
        r.tvservice = " ".join(line.split()[3:4])
        r.ready_on = next(
            (x.split()[1] for x in r.text.splitlines() if x.startswith("READY-ON ")), None
        )
        if r.ready_on:
            say(f"{target}: ready on {r.ready_on}")
    else:
        r.boot_done = r.steps[boot] = "TIMEOUT" if rc == 124 else "FAIL"
        return
    if a.tv:
        tv_suite(h, a, r, out, target, fw)
        return
    if not a.headless:
        tv_ready(h, a, r, out, target)
    checks = [
        (
            "check-m1",
            f"regress-{a.run}-{target}-check-m1 {M1_WAIT[a.mode] * a.scale}",
            "M1 PASS",
        ),
        ("app-calls", fw, "APP-CALLS PASS"),
    ]
    if a.headless:
        checks.append(("tvservice", r.tvservice or "none", "TVSERVICE PASS"))
    for step, arg, mark in checks:
        say(f"{target}: {step}")
        rc = guest_step(h, a, r, step, arg, out)
        if rc == 0 and not a.dry_run and mark not in r.text:
            rc = 1
        r.steps[step] = verdict.get(rc, "FAIL")
    say(f"{target}: checklist")
    lastinput, broadcast = checklist_args(target, fw)
    rc = guest_step(h, a, r, "checklist", lastinput, out)
    if a.dry_run or rc == 124:
        r.steps["checklist"] = verdict.get(rc, "FAIL")
    else:
        r.checklist = checklist.judge(r.text, broadcast)
        r.steps["checklist"] = checklist.verdict(r.checklist)
        for item, s, why in r.checklist:
            say(f"{target}:   {s} {item}: {why}")
    # root SSH (tests/regress/rootssh/check-ssh.sh, on the VM host): only with the rootssh
    # layer, which the default LAYERS leave out, and a network (NET_LINK=off forwards no host
    # port); otherwise the step SKIPs. Each instance's port is on its own address (its slot).
    say(f"{target}: ssh")
    skip = (
        "LAYERS has no rootssh"
        if "rootssh" not in a.vm_env["LAYERS"].split(",")
        else "NET_LINK=off forwards no host port"
        if net_off
        else None
    )
    if skip:
        r.steps["ssh"] = "SKIP" if not a.dry_run else "dry"
        if not a.dry_run:
            say(f"{target}: ssh SKIP ({skip})")
    else:
        rc, _ = h.run(
            "IDENT=$(host/scripts/vm-launcher config IDENTITY) && "
            "HOST=$(host/scripts/vm-launcher config ADDRESS) && "
            'HOST=$HOST tests/regress/rootssh/check-ssh.sh "$IDENT"',
            300,
        )
        r.steps["ssh"] = "dry" if a.dry_run else verdict.get(rc, "FAIL")
    if a.headless:
        idle_cpu(h, a, r, out, target)
        standby(h, a, r, out, rel, target)
        return
    say(f"{target}: HOME, screenshot")
    png = f"{rel}/{target}.png"
    rc = home_shot(h, a, r, out, png, "shot")
    r.steps["shot"] = verdict.get(rc, "FAIL")
    if rc == 0:
        r.shot = png
    idle_cpu(h, a, r, out, target)
    standby(h, a, r, out, rel, target)
    return


TV_READY_WAIT = (
    60  # s (scaled) after boot-done for bootd's tv-ready (webOS 5 and later: after core-boot-done)
)


def tv_ready(h, a, r, out, target):
    """Graphics: bootd's log has tvservice's tv-ready (guest.sh tv-ready), as headless's ready step
    requires. SKIP where the firmware sends none, on the guest's evidence as ready's (no TV service,
    a tunerless legacy-broadcast) or for a platform without bootd (NetCast, SimpleSmart)."""
    plat = targets.platform(target_of(target))
    if plat != "webOS":
        r.steps["tv-ready"] = "dry" if a.dry_run else "SKIP"
        if not a.dry_run:
            say(f"{target}: tv-ready SKIP ({plat}: no bootd, no tv-ready signal)")
        return
    say(f"{target}: tv-ready")
    rc = guest_step(h, a, r, "tv-ready", int(TV_READY_WAIT * a.scale), out)
    if a.dry_run:
        r.steps["tv-ready"] = "dry"
        return
    line = next((x for x in r.text.splitlines() if x.startswith("TVREADY ")), None)
    if rc == 0 and line and line.startswith("TVREADY SKIP "):
        r.steps["tv-ready"] = "SKIP"
        say(f"{target}: tv-ready SKIP ({line[len('TVREADY SKIP ') :]})")
    elif rc == 0 and line:
        r.steps["tv-ready"] = "PASS"
        say(f"{target}: tv-ready at {line.split()[1]} s (bootd's clock)")
    else:
        r.steps["tv-ready"] = "TIMEOUT" if rc == 124 else "FAIL"
        say(
            f"{target}: tv-ready {r.steps['tv-ready']}: "
            + "; ".join(r.text.strip().splitlines()[:4])
        )


def follow_restart(h, a, r, target, e):
    """The guest restarted itself while the step e.step ran (GuestRestarted). A target whose firmware
    restarts the set once on the first boot of a fresh state (targets.first_boot_restart: a set of it
    does the same at its first setup) has that one restart followed: wait for the unit's new QEMU
    (unit.run starts the VM again, keeping the run's state), then the steps start over from the boot
    step; True. Any other restart (a target without it, a second one) and a VM that powered off
    (e.off) fail the target (r.restart); False."""
    step = e.step
    if e.off:
        r.restart = f"the VM powered off during {step}" + (
            f" after {r.restarts} followed restart" if r.restarts else ""
        )
        say(f"{target}: {r.restart}: FAIL")
        return False
    if r.restarts or not targets.first_boot_restart(target_of(target)):
        r.restart = f"the guest restarted during {step}" + (
            f" after {r.restarts} followed restart" if r.restarts else ""
        )
        say(f"{target}: {r.restart}: FAIL")
        return False
    n = r.restarts + 1
    say(
        f"{target}: the guest restarted during {step}, its firmware's first-boot restart: "
        "waiting for the VM's second boot"
    )
    wait = int(120 * a.scale)
    rc, _ = h.run(
        f'timeout {wait} sh -c \'until n=$(cat "$RUN_DIR/restarts" 2>/dev/null); '
        f'[ "${{n:-0}}" = {n} ] && [ ! -e "$RUN_DIR/restarting" ]; do sleep 2; done\'',
        wait + 30,
        abort=True,
    )
    if rc:
        r.restart = (
            f"the guest restarted during {step} and the VM did not run again within {wait} s"
        )
        say(f"{target}: {r.restart}: FAIL")
        return False
    r.restarts = n
    # the first boot's verdicts are not this target's: everything after the start runs again
    for s in r.steps:
        if s != "start" and r.steps[s] != "SKIP":
            r.steps[s] = "-"
    r.items, r.checklist = {}, []
    r.idle, r.idle_item = None, None
    r.boot_done, r.tvservice, r.shot, r.standby = "-", "", "-", "-"
    return True


def interrupted(r, target):
    """The run's interrupt stopped the lane: the step it was at (the first not yet judged; the
    start's own when it ran to its end) is INTERRUPTED, and so is the target (r.interrupted)."""
    step = next((s for s, v in r.steps.items() if v == "-" and s != "stop"), "stop")
    if step != "stop":
        r.steps[step] = "INTERRUPTED"
    r.interrupted = step
    say(f"{target}: interrupted at {step}: stopping its VM")


def run_target(h, a, target, fw):
    r = Result(target, fw, a.mode, a.tv)
    r.window = (now(), "")
    began = time.monotonic()
    rel = f"build/regress/{a.run}"
    out = f"{rel}/{target}"
    net_off = a.vm_env.get("NET_LINK", "nat") == "off"
    capture = f"{out}/net.pcap"
    report = f"{out}/pcap-lg.txt"
    if not net_off and "capture" in r.steps:
        r.steps["capture"] = "SKIP"
    env = " ".join(
        f"{k}={shlex.quote(v)}" for k, v in start_env(a, fw, capture if net_off else "").items()
    )
    verdict = {0: "PASS", 124: "TIMEOUT"}
    if a.dry_run:
        verdict[0] = "dry"
    oom_since = oom_before = None
    h.lane = True
    try:
        say(f"{target}: start ({fw})")
        rc, _ = h.run(
            f"mkdir -p {out}/host && "
            + (f"rm -f {shlex.quote(capture)} {shlex.quote(report)} && " if net_off else "")
            + f"rm -rf {h.inst.guest_out}",
            30,
        )
        if rc:
            r.steps["start"] = "FAIL"
            return r
        meminfo(h, out, "start")
        oom_since, oom_before = time.time(), oom_count(h)
        rc, _ = h.run(
            f"{env} timeout {a.timeout} host/scripts/vm-launcher start > {out}/start.txt 2>&1",
            a.timeout + 30,
        )
        r.steps["start"] = verdict.get(rc, "FAIL")
        if rc:
            return r
        _, pid = h.run('cat "$RUN_DIR/qemu.pid" 2>/dev/null; true', 30)
        r.qemu_pid = int(pid.strip()) if pid.strip().isdigit() else None
        r.identity = vm_identity(h, a)
        if a.viewer:
            viewer(h, out, True)
        r.restarts = 0
        while True:
            try:
                boot_and_check(h, a, r, out, rel, target, fw)
                # a restart after the last step's wait (its .rc was there before the reset showed)
                rc, _ = h.run(f"sh -c '{restart_check(r.restarts)}true'", 30)
                check_restart(h, "the last step", rc)
                break
            except GuestRestarted as e:
                if not follow_restart(h, a, r, target, e):
                    break
        return r
    except Interrupted:
        interrupted(r, target)
        return r
    finally:
        h.lane = False  # the stop and what follows run whatever happened
        say(f"{target}: stop")
        if a.viewer:
            viewer(h, out, False)
        meminfo(h, out, "end")
        qemu_status(h, r, out)
        rc, _ = h.run(
            f'SAVED_LOG_DIR="$PWD/{out}/saved" LOG_TAG=regress timeout {a.timeout} host/scripts/vm-launcher stop '
            f"> {out}/stop.txt 2>&1",
            a.timeout + 30,
            protected=True,
        )
        r.steps["stop"] = verdict.get(rc, "FAIL")
        if net_off:
            say(f"{target}: capture (NET_LINK=off guest NIC)")
            check = (
                f"if test -f {shlex.quote(capture)}; then "
                f"python3 tests/regress/netstub/pcap-summary.py {shlex.quote(capture)} --lg; "
                f"else printf '%s\\n' 'capture missing: {capture}'; false; fi"
            )
            cap_rc, cap_text = h.run(
                f"{{ {check}; }} > {shlex.quote(report)} 2>&1; "
                f"s=$?; cat {shlex.quote(report)}; exit $s",
                60,
            )
            r.steps["capture"] = (
                "dry" if a.dry_run else ("PASS" if cap_rc == 0 and rc == 0 else "FAIL")
            )
            if not a.dry_run and r.steps["capture"] != "PASS":
                say(
                    f"{target}:   capture FAIL: "
                    + (
                        "VM stop failed; capture may not be flushed"
                        if rc
                        else cap_text.strip() or "capture check failed"
                    )
                )
        logs = h.inst.log_dir
        h.run(
            f"for f in console.log webos.log qemu.out netstub.log netstub-mitm.log netns-*.log; do "
            f"[ -f {logs}/$f ] && cp {logs}/$f {out}/host/; done; true",
            60,
        )
        # the unit and its helpers take a moment to go; an instance's own only (others run beside it)
        for _ in range(1 if a.dry_run else 10):
            _, r.orphans = h.run(h.inst.orphans, 30)
            r.orphans = r.orphans.strip()
            if not r.orphans:
                break
            time.sleep(2)
        if r.orphans and not a.dry_run:
            # the stop above did not end it (cut short, or its VM was started under another
            # RUN_DIR): end the lane's unit itself, and look again
            h.run(f"systemctl --user stop {h.inst.unit}.service", 150, protected=True)
            _, r.orphans = h.run(h.inst.orphans, 30)
            r.orphans = r.orphans.strip()
        if r.orphans:
            h.run(f"cat > {out}/orphans.txt <<'EOF'\n{r.orphans}\nEOF", 30)
            say(f"{target}: left running on the VM host:\n{r.orphans}")
        if oom_before is not None:
            check_oom(h, r, out, oom_since, oom_before)
        r.window = (r.window[0], now())
        r.seconds = time.monotonic() - began
        if h.host:
            if not a.dry_run:
                os.makedirs(os.path.join(TOP, rel), exist_ok=True)
            if local(
                ["rsync", "-a", f"{h.host}:{h.dest}/{rel}/", os.path.join(TOP, rel) + "/"],
                a.dry_run,
            ):
                say(
                    f"{target}: copying the results back failed; they are in {h.host}:{h.dest}/{rel}"
                )
                if net_off:
                    r.steps["capture"] = (
                        "FAIL"  # the capture/report are not retained with this run's results here
                    )
        if not a.dry_run:
            for when in ("start", "end"):
                r.memory[f"swap_{when}_mb"] = lanemem.swap_of_file(
                    os.path.join(TOP, out, "host", f"meminfo-{when}.txt")
                )
        if not a.dry_run and r.idle is not None:
            try:
                with open(os.path.join(TOP, out, "idle-cpu.json"), "w") as f:
                    json.dump(r.idle, f, indent=1)
            except OSError as e:
                say(f"{target}: idle-cpu.json: {e}")
        if not a.dry_run:
            saved = os.path.join(TOP, out, "saved")
            snapshot, error = device_census.select_latest(Path(saved))
            try:
                evidence = (
                    device_census.report(snapshot, target)
                    if snapshot
                    else {
                        "schema": 1,
                        "status": "unavailable-evidence",
                        "issues": [{"status": error}],
                    }
                )
                with open(os.path.join(TOP, out, "device-census.json"), "w") as f:
                    json.dump(evidence, f, indent=2, sort_keys=True)
                r.device_census = {
                    "status": evidence["status"],
                    "report": f"{target}/device-census.json",
                    "unknown_command_groups": len(evidence.get("unknown_commands", [])),
                    "unsupported_counter_rows": evidence.get("unsupported_counter_rows", 0),
                    "failed_open_groups": len(evidence.get("failed_device_opens", [])),
                }
                say(f"{target}: device census {evidence['status']} (device-census.json)")
            except (OSError, ValueError) as e:
                r.device_census = {"status": "report-error", "error": type(e).__name__}
                say(f"{target}: device census report error: {type(e).__name__}")
        say(
            f"{target}: {r.verdict} in {r.seconds:.0f} s "
            + " ".join(f"{s}={v}" for s, v in r.steps.items())
            + (f" restarts={r.restarts}" if r.restarts else "")
            + (f" ({r.restart})" if r.restart else "")
        )


def schedule(items, jobs, work, stop=lambda r: False):
    """work(item) for each of items in their order, at most jobs at once (schedule_hosts with one
    host)."""
    return schedule_hosts(items, [(None, jobs)], lambda item, _host: work(item), stop=stop)


class RunInterrupted(KeyboardInterrupt):
    """schedule_hosts was interrupted: results, the [(item, result)] of the items that ran."""

    def __init__(self, results):
        super().__init__()
        self.results = results


REFUSED = object()  # work's answer for an item its host will not start: it goes back to the queue


def schedule_hosts(
    items, slots, work, can=lambda item, host: True, stop=lambda r: False, ready=None
):
    """work(item, host) for each of items in their order, on the hosts of slots ([(host, n)]: at
    most n at once on host), each item on the first host with a free slot that can(item, host) run
    it; an item no host can run is left out. ready: {host: a callable that blocks until the host is
    prepared and says whether it is}: a host's slots take items only once it is, and none if it
    failed, while the other hosts' go on. Once stop(result) holds for one, no further item starts
    (those running finish). [(item, result)] of the items that ran, in items' order. A
    KeyboardInterrupt starts nothing more, sets INTERRUPT (each running lane stops at its next
    command and stops its VM), waits for the running ones and raises RunInterrupted with the
    results so far. work may answer REFUSED: the host takes no more items and this one goes back in its
    place in the queue, for another host that can run it."""
    lock = threading.Lock()
    pending = list(enumerate(items))
    done, halted = {}, []

    def worker(host):
        if ready and host in ready and not ready[host]():
            return
        while True:
            with lock:
                if halted:
                    return
                k = next((k for k, (_i, item) in enumerate(pending) if can(item, host)), None)
                if k is None:  # nothing left this host can run (pending only shrinks)
                    return
                i, item = pending.pop(k)
            r = work(item, host)
            if r is REFUSED:
                with lock:
                    pending.append((i, item))
                    pending.sort(key=lambda p: p[0])
                return
            with lock:
                done[i] = (item, r)
                if stop(r):
                    halted.append(i)

    threads = [
        threading.Thread(target=worker, args=(host,), daemon=True)
        for host, n in slots
        for _ in range(min(n, len(items)))
    ]
    try:
        # started inside: an interrupt as they start still stops the ones already running
        for t in threads:
            t.start()
        for t in threads:
            t.join()
    except KeyboardInterrupt:
        INTERRUPT.set()
        with lock:
            halted.append(None)
        say("interrupted: the running targets stop at their current step and stop their VMs")
        for t in threads:
            while t.is_alive():
                try:
                    t.join()
                except KeyboardInterrupt:
                    pass
        raise RunInterrupted([done[i] for i in sorted(done)]) from None
    return [done[i] for i in sorted(done)]


def git(*args, top=None):
    """git's output in top (default TOP; stripped); RuntimeError with its message on a failure."""
    r = subprocess.run(
        ["git", "-C", top or TOP, *args],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r.stdout.strip("\n")


def publish_sync():
    """scripts/publish/sync.py, the publishing machinery, which filters a commit to its public tree
    (host_commit); None where it is absent: in the public repository, whose commits are public."""
    path = os.path.join(TOP, "scripts", "publish", "sync.py")
    if not os.path.exists(path):
        return None
    spec = importlib.util.spec_from_file_location("publish_sync", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def source(a):
    """What the run tests (its run directory's source.json): the commit C (a.pin's, else this
    checkout's HEAD); the tree the VM hosts get (a.tree: public, private, working-tree; "checkout" for
    --local); whether it is the paths.txt-filtered one; the commit they check out (host_commit, set by
    make_host_commit); whether this checkout had uncommitted changes (tracked or untracked, not
    ignored), which a pinned run leaves out and an unpinned one tests; and the hosts. --no-sync: the
    VM hosts' checkouts as they were, the commit unknown. RuntimeError if git cannot say (a.pin is
    not a commit)."""
    base = {"hosts": list(a.hosts), "filtered": False, "host_commit": None}
    if a.hosts and a.no_sync:
        return dict(base, commit=None, tree=None, pinned=False, dirty=None)
    commit = git("rev-parse", "--verify", "--end-of-options", f"{a.pin or 'HEAD'}^{{commit}}")
    dirty = bool(git("status", "--porcelain", "--untracked-files=normal"))
    out = dict(base, commit=commit, tree=a.tree or "checkout", pinned=bool(a.pin), dirty=dirty)
    if a.pin:
        out["rev"] = a.pin
    return out


def host_ref(src):
    """The ref of src's host commit, here and in each VM host's bare repository."""
    return hostsrc.REF_PREFIX + ("private/" if src["tree"] == "private" else "") + src["commit"]


def make_host_commit(a):
    """a.source's host commit F, the one the VM hosts check out: for the public tree, the commit
    filtered by .github/publish/paths.txt (scripts/publish/sync.py's host_commit, refs/hosts/<C>;
    in a repository without that machinery, the public one, C itself); for --private-tree, a commit
    of C's whole tree with no parent, refs/hosts/private/<C>, the same id each time. Dry run: named,
    not made. Error from git or the filter on a failure."""
    src = a.source
    if src["tree"] not in ("public", "private"):
        return
    c = src["commit"]
    sync = publish_sync() if src["tree"] == "public" else None
    src["filtered"] = sync is not None
    if a.dry_run:
        say(f"host commit: {host_ref(src)} (dry run: not made)")
        return
    if sync:
        src["host_commit"] = sync.host_commit(TOP, c)
    elif src["tree"] == "public":
        src["host_commit"] = c
    else:
        ref = host_ref(src)
        try:
            src["host_commit"] = git("rev-parse", "--verify", "-q", ref)
        except RuntimeError:
            who = git("log", "-1", "--format=%cn%x00%ce%x00%cd", "--date=raw", c).split("\0")
            ident = dict(
                zip(("GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL", "GIT_COMMITTER_DATE"), who),
                **dict(zip(("GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_AUTHOR_DATE"), who)),
            )
            r = subprocess.run(
                ["git", "-C", TOP, "commit-tree", "--no-gpg-sign", f"{c}^{{tree}}"],
                input=f"Whole tree of {c[:12]}\n\nSource-Commit: {c}\n",
                capture_output=True,
                text=True,
                env=dict(os.environ, **ident),
                check=False,
            )
            if r.returncode:
                raise RuntimeError(r.stderr.strip())
            git("update-ref", ref, r.stdout.strip())
            src["host_commit"] = r.stdout.strip()
    # the identity of the source commit (packaging/identity.py's STAMP), for the hosts' checkouts,
    # which have no history to count; without it a host's build cannot say its version
    r = subprocess.run(
        [sys.executable, IDENTITY_PY, "source-version", "--top", TOP, "--rev", c, "--out", "-"],
        capture_output=True,
        text=True,
        check=False,
    )
    src["identity"] = r.stdout if r.returncode == 0 else None
    if r.returncode:
        say(f"warning: no source identity for the VM hosts' builds: {r.stderr.strip()}")
    say(f"host commit: {src['host_commit']} ({host_ref(src)})")


def describe(src):
    """source()'s one line, for the log and the summary."""
    if src["commit"] is None:
        return "the VM hosts' checkouts as they were (--no-sync), commit unknown"
    if src["pinned"]:
        kind = (
            "its public tree (.github/publish/paths.txt)"
            if src["filtered"]
            else "its whole tree, private paths included"
            if src["tree"] == "private"
            else "its tree"
        )
        return (
            f"commit {src['commit']} ({src['rev']}), {kind}"
            + (f", host commit {src['host_commit']}" if src["host_commit"] else "")
            + ("; this checkout's uncommitted changes left out" if src["dirty"] else "")
        )
    return f"commit {src['commit']}" + (
        " with this checkout's uncommitted changes" if src["dirty"] else ", working tree clean"
    )


class HostBusy(Exception):
    pass


class HostLock:
    """The VM host's lock on its checkout DEST (hostsrc.lock_cmd), held from the run's start to its
    end: its checkout, build and lanes. The run's ssh holds it; it is let go when that ends, the
    run's own end or its death alike. HostBusy at once if another holds it. Dry run: printed."""

    def __init__(self, host, dest, run, dry):
        self.host, self.dest, self.dry = host, dest, dry
        self.cmd = hostsrc.lock_cmd(
            dest, f"scripts/regress run {run} (pid {os.getpid()} on {os.uname().nodename})"
        )
        self.p = None

    def __enter__(self):
        if self.dry:
            say_raw(f"  [{self.host}] {self.cmd}")
            return self
        self.p = subprocess.Popen(
            ["ssh", self.host, self.cmd],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        line = self.p.stdout.readline().strip()
        if line != "LOCKED":
            rest = self.p.stdout.read().strip()
            self.p.wait()
            raise HostBusy(
                f"{self.host}:{self.dest} is held by another run: {rest or 'unknown'}"
                if line == "BUSY"
                else f"cannot lock {self.host}:{self.dest}: {line} {rest}".strip()
            )
        say(f"{self.host}: holding {hostsrc.lock_path(self.dest)}")
        return self

    def __exit__(self, *exc):
        if self.p:
            self.p.stdin.close()
            try:
                self.p.wait(30)
            except subprocess.TimeoutExpired:
                self.p.kill()
                self.p.wait()
        return False


def send_tree(a, host):
    """The host commit into the VM host's checkout: pushed to its bare repository where it lacks
    it (only the objects it lacks go), then checked out into DEST exactly (hostsrc.checkout_cmd).
    False on a failure."""
    src = a.source
    f = src["host_commit"] or host_ref(src)  # a dry run names it
    h = Host(host, ".", a.dry_run)
    rc, out = h.run(
        f"{hostsrc.ensure_cmd()} && {{ {hostsrc.has_cmd(f)} && echo there; true; }}", 60
    )
    if rc:
        say(f"{host}: no bare repository {hostsrc.BARE}: {out.strip()}")
        return False
    if out.strip() != "there":
        say(f"push: {f[:12] if src['host_commit'] else f} to {host}:{hostsrc.BARE}")
        if local(hostsrc.push_argv(TOP, host, f, host_ref(src)), a.dry_run):
            return False
    say(f"checkout: {f[:12] if src['host_commit'] else f} into {host}:{a.dest}")
    rc, out = h.run(hostsrc.checkout_cmd(a.dest, f, src.get("identity")), 600)
    if rc:
        say(f"{host}: checkout failed: {out.strip()}")
        return False
    return True


def machine():
    """This machine's architecture: guest builds happen only on x86_64 (the SDK's)."""
    return os.uname().machine


def builds_here(a):
    """Whether the run builds in this checkout (prepare): the guests on x86_64, the host with --local."""
    return not a.no_build and (machine() == "x86_64" or a.local)


def build_lock(a):
    """The run's hold of this checkout's build lock (scripts/buildlock.py): exclusive when it builds
    here first (prepare lets it down to shared after), else shared. None on a dry run (printed)."""
    mode = "exclusive" if builds_here(a) else "shared"
    if a.dry_run:
        say_raw(
            f"  [here] hold {os.path.relpath(buildlock.LOCK, TOP)} {mode}"
            + (", shared after the build" if mode == "exclusive" else "")
        )
        return None
    return buildlock.Lock(mode, f"scripts/regress run {a.run}", say=say)


def build_here(cmd, a, env=None):
    """A build in this checkout (scripts/build.sh), under the run's exclusive build lock: BUILD_LOCKED
    says so, and it takes none of its own."""
    return local(cmd, a.dry_run, dict(env or {}, BUILD_LOCKED="1"))


def prepare(a, sel):
    """Build (or check) and sync to every VM host; False on a failure. a.traits must hold each VM
    host's host_traits: one without a toolchain gets the cross-built arm64 host side the sync ships
    (build/publish-arm64) instead of building its own."""
    x86 = machine() == "x86_64"
    if a.no_build:
        say("checking what is built")
    elif x86:
        for target, fw in sel:
            say(f"build: guest {target}")
            if build_here(["scripts/build.sh", "guest"], a, {"FW": fw}):
                return False
        if a.local:
            say("build: host")
            if build_here(["scripts/build.sh", "host"], a):
                return False
    if a.no_build or x86:
        # every target run has the gl layer graphics boots with: those that make none are skipped
        # (resolved as the manager does: build/components/<component>/selections.json's variant)
        layer = "gl" if "gl" in a.vm_env["LAYERS"].split(",") else "soc"
        missing = [
            p
            for p in ("build/Image", "build/initramfs.cpio.gz")
            if not os.path.exists(os.path.join(TOP, p))
        ]
        for target, _ in sel:
            comp = guestlayers.component(tuple(target.split("-", 1)), layer)
            try:
                found = guestlayers.select(
                    os.path.join(TOP, "build", "components"), tuple(target.split("-", 1)), comp
                )
            except ValueError as e:
                found = None
                say(str(e))
            if not found:
                missing.append(f"build/components/{comp} ({target})")
        if missing and not a.dry_run:
            say(f"not built: {', '.join(missing)}")
            return False
    elif a.local:
        say("build: host (no guest builds here: the SDK is x86_64)")
        if build_here(["scripts/build.sh", "host"], a):
            return False
    lock = getattr(a, "build_lock", None)
    if lock and lock.mode == "exclusive":
        lock.downgrade()  # built: the rest of the run only reads the outputs
        if not lock.held:
            say(f"holding {os.path.relpath(buildlock.LOCK, TOP)} shared")
    if not a.hosts or a.no_sync:
        return True
    if not a.sync:
        say(
            "no sync command: set REGRESS_SYNC to an executable that copies this checkout to the VM host "
            "(it gets SRC, HOST and DEST in its environment), or sync it yourself and pass --no-sync"
        )
        return False
    published = os.path.isdir(os.path.join(TOP, PUBLISH_ARM64))
    for host in a.hosts:
        t = a.traits[host]
        if t["toolchain"]:
            continue
        if t["arch"] != "aarch64" or not (published or a.dry_run):
            say(
                f"{host} has no toolchain ({', '.join(TOOLCHAIN)}), so it needs the cross-built arm64 host "
                f"side, {PUBLISH_ARM64} (scripts/build.sh host-arm64)"
                + ("" if t["arch"] == "aarch64" else f", which a {t['arch']} host cannot run")
            )
            return False
    return True


def sync_outputs(a, host):
    """The sync command to host (REGRESS_SYNC): what the build published here (SRC=none: no tree),
    or with --working-tree this checkout too (SRC=TOP). The run holds the host's lock (HostLock),
    so the sync takes none of its own (REGRESS_LOCKED). False on a failure."""
    say(f"sync: to {host}" + ("" if a.tree == "working-tree" else " (the build's outputs)"))
    env = {
        "SRC": TOP if a.tree == "working-tree" else "none",
        "HOST": host,
        "DEST": a.dest,
        "REGRESS_LOCKED": "1",
    }
    return not local([a.sync], a.dry_run, env)


def host_tree(a, host):
    """The VM host's source tree, first and host by host (it is quick: only what the host lacks
    goes): the host commit, pushed and checked out exactly (send_tree), or with --working-tree this
    checkout, through the sync command with the build's outputs. Every host gets the same tree.
    False on a failure."""
    if a.no_sync:
        return True
    if a.tree == "working-tree":
        return sync_outputs(a, host)
    return send_tree(a, host)


def host_side(a, host, files=()):
    """The rest of a VM host's preparation, each host's in a thread of its own while the others go
    on and its lanes wait (main): what the build published (sync_outputs; --working-tree sent it with
    the tree), the host side's build where the host has a toolchain (one without runs the shipped
    build/publish-arm64), and the run's files (files: paths in this checkout, the test apps) to the
    same paths there. False on a failure."""
    if not a.no_sync:
        if a.tree != "working-tree" and not sync_outputs(a, host):
            return False
        if not a.no_build:
            if not a.traits[host]["toolchain"]:
                say(f"build: none on {host} (no toolchain): its host side is {PUBLISH_ARM64}'s")
            else:
                say(f"build: host side on {host}")
                rc, text = Host(host, a.dest, a.dry_run).run(
                    "scripts/build.sh host > build/regress-host-build.log 2>&1 || "
                    "{ tail -n 20 build/regress-host-build.log; exit 1; }",
                    3600,
                )
                if rc:
                    say(f"{host}: scripts/build.sh host failed:\n{text.strip()}")
                    return False
    for path in files:
        if Host(host, a.dest, a.dry_run).run(f"mkdir -p {os.path.dirname(path)}", 30)[0] or local(
            ["rsync", "-a", path, f"{host}:{a.dest}/{path}"], a.dry_run
        ):
            return False
    return True


# What a VM host's traits are read from (host_traits). The toolchain is what scripts/build.sh host
# needs; the render node is the one the launcher gives a KVM guest's virgl display (qemu.py:
# RENDERNODE's default under KVM; a graphics lane fails its start without it); the desktop is
# where viewer() opens the --viewer window (a Wayland socket in XDG_RUNTIME_DIR, else X :0).
TOOLCHAIN = ("meson", "ninja", "cc")
KVM_RENDERNODE = "/dev/dri/renderD128"
PUBLISH_ARM64 = "build/publish-arm64"
TRAITS = (
    'echo "arch $(uname -m)"; '
    + "".join(f"command -v {t} >/dev/null && " for t in TOOLCHAIN)
    + "echo toolchain; "
    + f"n={KVM_RENDERNODE}; "
    + '[ -c "$n" ] && [ -r "$n" ] && [ -w "$n" ] && '
    + '[ "$(basename "$(readlink -f /sys/class/drm/${n##*/}/device)")" != vgem ] && echo render; '
    + "rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}; "
    + "{ ls -d $rt/wayland-[0-9]* 2>/dev/null | grep -qv lock || [ -S /tmp/.X11-unix/X0 ]; } "
    + "&& echo desktop; "
    # the installed packages (`beanjar --version --json`: what HOST/NAME commands run there)
    + 'printf "packages %s\\n" "$(beanjar --version --json 2>/dev/null | head -n 1)"; true'
)


def host_traits(h):
    """{arch, toolchain, render, desktop} of the VM host h (TRAITS); this machine (no host) has
    everything a --local run needs. A dry run prints the probe and assumes a capable arm64 host.
    RuntimeError if the host cannot say."""
    if not h.host:
        return {"arch": machine(), "toolchain": True, "render": True, "desktop": True}
    rc, out = h.run(TRAITS, 30)
    if h.dry:
        return {"arch": "aarch64", "toolchain": True, "render": True, "desktop": True}
    words = dict((line.split(" ", 1) + [""])[:2] for line in out.splitlines() if line)
    if rc or "arch" not in words:
        raise RuntimeError(f"cannot read {h.host}'s traits: {out.strip()}")
    try:
        packages = json.loads(words.get("packages") or "null")
    except ValueError:
        packages = None
    return {
        "arch": words["arch"],
        "toolchain": "toolchain" in words,
        "render": "render" in words,
        "desktop": "desktop" in words,
        "packages": packages if isinstance(packages, dict) else None,
    }


def pinned_identity(src):
    """The run's commit as compat.drift takes it ({"version", "commit"}): the source identity's
    (make_host_commit), else the commit alone; None when the run pins none (--no-sync)."""
    if not src.get("commit"):
        return None
    try:
        ident = tomllib.loads(src.get("identity") or "")
    except ValueError:
        ident = {}
    return {"version": ident.get("version") or src["commit"][:12], "commit": src["commit"]}


def package_drift(a):
    """Each VM host's installed packages (its traits' `beanjar --version --json`) against the run's
    commit: a.source["packages"] {host: that object or None} for source.json, and a warning for
    each difference (compat.drift). The run uses the hosts' checkouts, so nothing fails by it, but a
    HOST/NAME command or a plain `beanjar` there runs the installed code."""
    pinned = pinned_identity(a.source)
    a.source["packages"] = {host: a.traits[host].get("packages") for host in a.hosts}
    for host, info in a.source["packages"].items():
        if info is None:
            say(f"{host}: no installed beanjar answers `beanjar --version --json`")
            continue
        for item in compat.drift(pinned, info, host) if pinned else []:
            if item["package"] == "beanjar":
                say(
                    f"warning: {host}: its installed beanjar is {compat.label(item['found'])}, "
                    f"the run's commit {compat.label(item['expected'])}; the run uses its checkout, "
                    f"but HOST/NAME commands and `beanjar` there run the installed one; fix: "
                    f"{item['fix']}"
                )
            else:
                say(f"warning: {compat.drift_text(item)}")


def write_source(a):
    """The run directory's source.json (a.source); nothing on a dry run."""
    if a.dry_run:
        return
    d = os.path.join(TOP, "build", "regress", a.run)
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "source.json"), "w") as f:
        json.dump(a.source, f, indent=1)
        f.write("\n")


def host_firmwares(h, names):
    """(the VM host's firmware collections, {name: its directory there}) of the firmware names: where
    `host/scripts/vm-launcher config FIRMWARE_DIRS` there lists it, the first collection that has it.
    Nothing is copied: a name absent from them is absent from the dict. RuntimeError if the host
    cannot say."""
    rc, out = h.run(
        "dirs=$(host/scripts/vm-launcher config FIRMWARE_DIRS) || exit 1; "
        'printf "dir %s\\n" $dirs; '
        f"for n in {' '.join(shlex.quote(n) for n in names)}; do "
        'for d in $dirs; do [ -d "$d/$n" ] && { echo "fw $n $d/$n"; break; }; done; done; true',
        60,
    )
    if rc:
        raise RuntimeError(f"cannot read the VM host's firmware collections: {out.strip()}")
    dirs, found = [], {}
    for line in out.splitlines():
        f = line.split(" ", 2)
        if f[0] == "dir" and len(f) == 2 and f[1]:
            dirs.append(f[1])
        elif f[0] == "fw" and len(f) == 3:
            found.setdefault(f[1], f[2])
    return dirs, found


def why_not(a, host, fw, collections):
    """Why the VM host cannot run a target of firmware fw, "" if it can: its firmware collections
    (collections: host_firmwares' (dirs, found), None: any firmware, --local or a dry run), and its
    traits: graphics needs the KVM render node, --viewer a desktop."""
    if collections is not None and fw not in collections[1]:
        return f"firmware {fw} not in the host's firmware collections ({':'.join(collections[0]) or 'none'})"
    t = a.traits[host]
    if a.mode == "graphics" and not t["render"]:
        return f"graphics needs the render node {KVM_RENDERNODE}, which the host has not"
    if a.viewer and not t["desktop"]:
        return "--viewer needs a desktop session on the host (a Wayland socket, or X :0)"
    return ""


def placement(a, sel):
    """({target: [the VM hosts that can run it]}, {target: Result} of the targets none can run (failed,
    not run)); None if a host cannot say. The firmware is looked up in each VM host's collections
    (--local: this machine's, where it was chosen); nothing is copied."""
    hosts = a.hosts or [None]
    collections = {}
    for host in hosts:
        if host is None or not sel:
            collections[host] = None
            continue
        say(f"firmware: from {host}'s firmware collections")
        try:
            collections[host] = host_firmwares(
                Host(host, a.dest, a.dry_run), sorted({fw for _, fw in sel})
            )
        except RuntimeError as e:
            say(str(e))
            return None
        if a.dry_run:
            collections[host] = None
    where, failed = {}, {}
    for target, fw in sel:
        why = {h: why_not(a, h, fw, collections[h]) for h in hosts}
        where[target] = [h for h in hosts if not why[h]]
        if where[target]:
            if collections[where[target][0]] is not None:
                say(f"{target}: {fw} at {collections[where[target][0]][1][fw]}")
            continue
        r = failed[target] = Result(target, fw, a.mode, a.tv)
        r.steps["start"] = "FAIL"
        r.failed = why[hosts[0]] if len(hosts) == 1 else "; ".join(f"{h}: {why[h]}" for h in hosts)
        say(f"{target}: FAIL ({r.failed})")
    return where, failed


def fit_ram(where, ram, capacity, headroom_mb=HEADROOM_MB):
    """Narrow where ({target: [hosts]}) to the hosts whose room (capacity: {host: (CPUs,
    MemAvailable kB)}, less headroom_mb: MiB, or {host: MiB}) holds the target's RAM (ram: {target: MiB}, or
    {(target, host): MiB}: its booking there), where there are any; a target that fits none keeps
    its hosts (the launcher's admission decides there)."""
    need = lambda p, h: ram[p, h] if (p, h) in ram else ram[p]  # noqa: E731
    keep = lambda h: headroom_mb[h] if isinstance(headroom_mb, dict) else headroom_mb  # noqa: E731
    for p, hs in where.items():
        fits = [h for h in hs if need(p, h) <= capacity[h][1] // 1024 - keep(h)]
        if fits and len(fits) < len(hs):
            say(
                f"{p}: on {', '.join(fits)} only (its {need(p, next(h for h in hs if h not in fits))} MB is more than the others' "
                "MemAvailable less their reserve)"
            )
            where[p] = fits


def pack_smp_app(a):
    """--tv graphics smp: the SMP check app packed here (tests/regress/smp/pack.sh: ares-package, with the
    guest build's build/tests/regress/smp/smpcheck and its clip) into the run's directory; its path
    (host_side copies it to each VM host), or False."""
    ipk = SMP_IPK.format(run=a.run)
    tmp = os.path.join(os.path.dirname(ipk), "smp-pkg")
    if local(
        [
            "sh",
            "-c",
            f'rm -rf {tmp} && ipk=$(sh tests/regress/smp/pack.sh {tmp}) && mv "$ipk" {ipk} && rm -rf {tmp}',
        ],
        a.dry_run,
    ):
        return False
    return ipk


def pack_test_app(a):
    """--tv graphics: the test web app (tests/regress/tvapp) packed here with the SDK's ares-package
    into the run's directory; its path (host_side copies it to each VM host), or False."""
    ipk = TV_IPK.format(run=a.run)
    tmp = os.path.join(os.path.dirname(ipk), "tvapp-pkg")
    tool = shutil.which("ares-package") or os.path.expanduser("~/.cargo/bin/ares-package")
    app = os.path.relpath(tvsuite.TEST_APP_DIR, TOP)
    if not a.dry_run:
        os.makedirs(os.path.join(TOP, tmp), exist_ok=True)
    if "decode" in a.tv_steps:
        # the decode step's clips, made now (never committed), packed with a copy of the app
        app = os.path.join(os.path.dirname(ipk), "tvapp")
        if not a.dry_run:
            shutil.rmtree(os.path.join(TOP, app), ignore_errors=True)
            shutil.copytree(tvsuite.TEST_APP_DIR, os.path.join(TOP, app))
        if local(["sh", "tests/regress/video/make-clips.sh", "--decode", app], a.dry_run):
            say("tests/regress/video/make-clips.sh --decode failed")
            return False
    if local([tool, "-o", tmp, app], a.dry_run):
        return False
    if not a.dry_run:
        built = [f for f in os.listdir(os.path.join(TOP, tmp)) if f.endswith(".ipk")]
        if len(built) != 1:
            say(f"ares-package made {built or 'nothing'} in {tmp}")
            return False
        os.replace(os.path.join(TOP, tmp, built[0]), os.path.join(TOP, ipk))
        os.rmdir(os.path.join(TOP, tmp))
    return ipk


def gallery(d, results):
    """build/regress/<run>/gallery.html: each target's screenshots of the apps and draw steps."""
    rows = []
    for r in results:
        shots = (
            sorted(f for f in os.listdir(os.path.join(d, r.target, "apps")) if f.endswith(".png"))
            if os.path.isdir(os.path.join(d, r.target, "apps"))
            else []
        )
        if shots:
            cells = "".join(
                f'<figure><a href="{r.target}/apps/{f}"><img src="{r.target}/apps/{f}" width="384"></a>'
                f"<figcaption>{f[:-4]}</figcaption></figure>"
                for f in shots
            )
            rows.append(f"<h2>{r.target} ({r.fw})</h2><div>{cells}</div>")
    if rows:
        with open(os.path.join(d, "gallery.html"), "w") as f:
            f.write(
                "<!DOCTYPE html><meta charset=utf-8><title>TV suite gallery</title><style>figure{display:"
                "inline-block;margin:4px}</style>" + "".join(rows) + "\n"
            )


def main(argv=None):
    try:
        a, sel = parse(sys.argv[1:] if argv is None else argv)
    except Usage as e:
        print(f"scripts/regress: {e}", file=sys.stderr)
        return 2
    # a killed run (SIGTERM, a closed terminal) ends as an interrupted one does: every lane stops
    # its VM (schedule_hosts), instead of the run dying with VMs left running
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, signal.default_int_handler)
    say(
        f"run {a.run} ({a.mode}{', TV suite' if a.tv else ''}): "
        + ", ".join(f"{p} ({fw})" for p, fw in sel)
        + f" on {', '.join(a.hosts) or 'this machine'}"
        + (" (dry run)" if a.dry_run else "")
    )
    try:
        a.source = source(a)
    except RuntimeError as e:
        print(f"scripts/regress: {a.pin or 'HEAD'}: {e}", file=sys.stderr)
        return 2
    try:
        make_host_commit(a)
    except Exception as e:  # git's (RuntimeError) or the filter's (its Failure)
        say(f"host commit of {a.source['commit']}: {e}")
        return 1
    say(f"source: {describe(a.source)}")
    write_source(a)
    for p, _fw in sel:
        warning = targets.untested_warning(targets.by_name(p))
        if warning:
            say(f"warning: {warning}")
    skipped = {}
    if "gl" in a.vm_env["LAYERS"].split(","):
        for target, fw in sel:
            if not gl_expected(target):
                skipped[target] = Result(target, fw, a.mode, a.tv)
                skipped[
                    target
                ].skipped = f"no gl layer: guest/layers/soc/{target.split('-')[0]} has no graphics ABI configured"
                say(f"{target}: SKIP ({skipped[target].skipped})")
    run = [(p, fw) for p, fw in sel if p not in skipped]
    hosts = a.hosts or [None]  # None: this machine (--local)
    try:
        # from the home directory: a new host has no checkout before its first sync
        a.traits = {host: host_traits(Host(host, ".", a.dry_run)) for host in hosts}
    except RuntimeError as e:
        say(str(e))
        return 1
    for host in a.hosts:
        t = a.traits[host]
        say(
            f"{host}: {t['arch']}, "
            + ", ".join(f"{'' if t[k] else 'no '}{k}" for k in ("toolchain", "render", "desktop"))
        )
    if a.hosts:
        package_drift(a)
        write_source(a)
    # this checkout's build/ is the run's from here to its end: exclusive while it builds here, then
    # shared (its outputs read, synced, booted); each VM host's checkout too: its checkout, build and
    # lanes
    try:
        with contextlib.ExitStack() as held:
            a.build_lock = build_lock(a)
            if a.build_lock:
                held.enter_context(a.build_lock)
                say(
                    f"holding {os.path.relpath(buildlock.LOCK, TOP)} {a.build_lock.mode}"
                    + (
                        " (its caller's: BUILD_LOCKED or an outer flock)"
                        if a.build_lock.held
                        else ""
                    )
                )
            for host in a.hosts:
                held.enter_context(HostLock(host, a.dest, a.run, a.dry_run))
            return lanes(a, sel, run, skipped, hosts)
    except (HostBusy, buildlock.Held) as e:
        say(f"not starting: {e}")
        return 1


def lanes(a, sel, run, skipped, hosts):
    """main's run once the VM hosts are held: build and sync, then the targets; its exit status."""
    if not prepare(a, run):
        say("build failed")
        return 1
    for host in a.hosts:
        if not host_tree(a, host):
            say(f"{host}: sending its tree failed")
            return 1
    placed = placement(a, run)
    if placed is None:
        return 1
    where, missing = placed
    files = []
    if a.tv and {"apps", "draw", "audio", "decode"} & set(a.tv_steps) and a.mode == "graphics":
        files.append(pack_test_app(a))
        if not files[-1]:
            say("packing the test app failed")
            return 1
    if a.tv and "smp" in a.tv_steps and a.mode == "graphics":
        files.append(pack_smp_app(a))
        if not files[-1]:
            say("packing the SMP check app failed")
            return 1
    if a.scale != 1:
        say(
            f"{a.accel}: the run's deadlines x{a.scale} (step limit {a.timeout} s), as the guest's bootd timers"
        )
    for host in hosts:
        say("checking that nothing runs on the VM host" + (f" {host}" if len(hosts) > 1 else ""))
        rc, busy = Host(host, a.dest, a.dry_run).run(ORPHANS, 30)
        if rc or busy.strip():
            say(
                f"not starting: the VM host{f' {host}' if host else ''} is busy or unreachable:\n{busy.strip()}"
            )
            return 1
    # each VM host's targets at once: -j capped by its own CPUs and RAM (cap_jobs) against the targets
    # it can run. A target whose RAM does not fit a host's room (MemAvailable less HEADROOM_MB) goes
    # to the hosts it fits, where there are any (else it is tried as on one host: the launcher's
    # admission decides).
    # Each lane books what it is expected to take of MemAvailable: a headless lane whose target has a
    # measured peak (PEAKS, this host's architecture) that peak and a margin, any other its RAM
    # (lanemem.booking); the slots are planned on the bookings, and each lane is admitted on the
    # host's state as it starts (lanemem.HostGate).
    smp = int(a.vm_env.get("SMP") or 4)
    ram = {p: int(a.vm_env.get("MEM") or nvm.board_ram(targets.by_name(p))) for p, _fw in run}
    store = lanemem.Peaks(PEAKS)
    stored = store.load()
    book = {}  # {(target, host): (MiB booked, rule, the stored peak or None)}
    for p, _fw in run:
        for host in hosts:
            peak = (
                None
                if a.vm_env.get("MEM")
                else store.get(p, a.mode, a.traits[host]["arch"], stored)
            )
            book[p, host] = lanemem.booking(ram[p], a.mode, peak) + (peak,)
    capacity, swap_base, reserve = {}, {}, {}
    for host in hosts:
        mems = [ram[p] for p, _fw in run if p not in missing and host in where.get(p, ())]
        if mems:
            capacity[host] = (
                (a.jobs * smp, (sum(sorted(mems)[-a.jobs :]) + HEADROOM_MB) * 1024)
                if a.dry_run and host
                else host_capacity(Host(host, a.dest, a.dry_run))
            )
            state = host_state(a, host, []) or {}
            swap_base[host] = state.get("swap_mb")
            # the host's own reserve: HEADROOM_MB, less on a host without swap (lanemem.reserve_mb)
            reserve[host] = lanemem.reserve_mb(
                state.get("total_mb"), state.get("swap_total_mb"), HEADROOM_MB
            )
    fit_ram(where, {(p, h): book[p, h][0] for p, h in book}, capacity, reserve)
    slots, slots_ram = {}, {}
    for host in hosts:
        mine = [p for p, _fw in run if p not in missing and host in where.get(p, ())]
        if not mine:
            slots[host] = slots_ram[host] = 0
            continue
        cpus, avail = capacity[host]
        n, why = cap_jobs(
            a.jobs,
            len(mine),
            cpus,
            avail,
            [book[p, host][0] for p in mine],
            smp,
            reserve[host],
        )
        slots[host] = n
        # the rule before measured peaks: each target's full RAM and HEADROOM_MB
        slots_ram[host] = cap_jobs(a.jobs, len(mine), cpus, avail, [ram[p] for p in mine], smp)[0]
        peaked = [p for p in mine if book[p, host][1] == "peak"]
        say(
            (f"{host}: " if len(hosts) > 1 else "")
            + f"{n} VM(s) at once, each in an instance of its own (INSTANCE=<target>, build/instances/<target>; instance_id)"
            + (f"; -j {a.jobs} capped by {why}" if n < a.jobs and why else "")
        )
        say(
            (f"{host}: " if len(hosts) > 1 else "")
            + f"memory: {len(peaked)} of {len(mine)} target(s) booked from measured peaks"
            + (
                " (" + ", ".join(f"{p} {book[p, host][0]} of {ram[p]} MB" for p in peaked) + ")"
                if peaked
                else ""
            )
            + f"; {reserve[host]} MB reserve; {n} slot(s), {slots_ram[host]} with each target's "
            f"full RAM and {HEADROOM_MB} MB"
            + (f"; swap {swap_base[host]} MB in use" if swap_base.get(host) is not None else "")
        )
    jobs = sum(slots.values())
    gate = lanemem.HostGate(
        swap_base,
        (lambda host, lanes: None)
        if a.dry_run
        else (lambda host, lanes: host_state(a, host, lanes)),
        {h: reserve.get(h, HEADROOM_MB) for h in hosts},
        say=say,
    )
    say(
        "each lane starts once its host's MemAvailable holds its booking and the host's reserve, and "
        f"while the host's swap has grown by no more than {lanemem.SWAP_GROWTH_MB} MB since the run began"
    )

    def work(item, host):
        target, fw = item
        if target in skipped:
            return skipped[target]
        if target in missing:
            return missing[target]
        booked, rule, peak = book[target, host]
        if not gate.admit(host, target, booked):
            return REFUSED
        try:
            r = run_target(
                Host(
                    host,
                    a.dest,
                    a.dry_run,
                    Instance(instance_id(target, fw)) if a.instances else None,
                ),
                a,
                target,
                fw,
            )
        finally:
            gate.done(host, target)
        r.instance = instance_id(target, fw) if a.instances else None
        r.host = host
        r.memory.update(
            ram_mb=ram[target],
            booked_mb=booked,
            rule=rule,
            stored_peak_mb=peak["peak_mb"] if peak else None,
        )
        if not a.dry_run:
            keep_peak(a, store, r)
        return r

    def can(item, host):
        # skipped and not-run targets take no VM: whichever slot comes first reports them
        return item[0] in skipped or item[0] in missing or host in where[item[0]]

    def stop(r):
        if r.interrupted:
            return True  # the run is interrupted: nothing more starts anyway
        if r.orphans:
            say(f"{r.target}: left processes behind; starting no more targets")
            return True
        if not r.ok and not a.keep_going:
            say(f"{r.target}: failed; starting no more targets (--keep-going goes on)")
            return True
        return False

    began = time.monotonic()
    # each VM host's own preparation (host_side) in a thread of its own; its lanes start once it is
    # done, while the other hosts' run: a slow first sync holds back only its own host
    prepared, ready = {}, {}
    for host in a.hosts:
        done = threading.Event()

        def prep(host=host, done=done):
            try:
                prepared[host] = host_side(a, host, files)
            except Exception as e:  # noqa: BLE001 - a host's failure, said; the others go on
                say(f"{host}: {e}")
                prepared[host] = False
            finally:
                done.set()

        threading.Thread(target=prep, daemon=True).start()
        ready[host] = lambda host=host, done=done: done.wait() and prepared[host]
    results = []
    try:
        order = interleave(sel) if jobs > 1 else sel
        # a slot for a host with nothing to run still reports the skipped and not-run targets
        busy = [(host, n) for host, n in slots.items() if n] or [(hosts[0], 1)]
        results = [r for _, r in schedule_hosts(order, busy, work, can, stop, ready=ready)]
    except KeyboardInterrupt as e:
        # the lanes that ran, the interrupted ones among them, are in the summary
        results = [r for _, r in getattr(e, "results", [])]
        say("interrupted")
    for host in a.hosts:
        if host in prepared and not prepared[host]:
            say(f"{host}: its preparation failed; no target ran there")
    failed_hosts = {h for h, ok in prepared.items() if not ok}
    ran = {r.target for r in results}
    for target, fw in run:
        hs = where.get(target, [])
        if target not in ran and hs and set(hs) <= failed_hosts | set(gate.closed):
            r = Result(target, fw, a.mode, a.tv)
            r.steps["start"] = "FAIL"
            if set(hs) <= failed_hosts:
                r.failed = f"no VM host that could run it got ready ({', '.join(hs)} failed)"
            else:
                r.failed = (
                    "no VM host would run it ("
                    + "; ".join(
                        f"{h or 'this machine'}: "
                        + ("its preparation failed" if h in failed_hosts else gate.closed[h])
                        for h in hs
                    )
                    + ")"
                )
            say(f"{target}: FAIL ({r.failed})")
            results.append(r)
    wall = time.monotonic() - began
    left = ""
    if a.instances and not a.dry_run:
        # every instance checked its own; now each host as a whole
        for host in hosts:
            _, out = Host(host, a.dest, a.dry_run).run(ORPHANS, 30)
            if out.strip():
                say(
                    f"left running on the VM host{f' {host}' if host else ''} after the run:\n{out.strip()}"
                )
                left += out
    many = len(hosts) > 1
    per_host = ", ".join(f"{h} {n}" for h, n in slots.items()) if many else ""
    summary = (
        table(results, a.mode, a.tv, hosts=bool(a.hosts))
        + f"\n\nwall {wall:.0f} s, {jobs} at once"
        + (f" ({per_host})" if per_host else "")
        + "\nslots: "
        + ", ".join(
            f"{h or 'this machine'} {slots[h]} booked, {slots_ram[h]} with full RAM"
            + (f", swap {swap_base[h]} MB at the start" if swap_base.get(h) is not None else "")
            for h in hosts
            if h in slots
        )
        + memory_table(results)
        + f"\nsource: {describe(a.source)}"
    )
    say_raw(summary)
    d = os.path.join(TOP, "build", "regress", a.run)
    if not a.dry_run:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "summary.txt"), "w") as f:
            f.write(summary + "\n")
        if a.tv:
            gallery(d, results)
            if "decode" in a.tv_steps and a.mode == "graphics":
                try:
                    sheet = tvsuite.decode_sheet(d)  # one capture per case, for looking at
                    if sheet:
                        say(f"decode contact sheet: {os.path.relpath(sheet, TOP)}")
                except (OSError, ImportError) as e:
                    say(f"decode contact sheet: {e}")
        with open(os.path.join(d, "summary.json"), "w") as f:
            json.dump(
                [
                    dict(
                        target=r.target,
                        fw=r.fw,
                        mode=r.mode,
                        vm_env=a.vm_env,
                        steps=r.steps,
                        **{"core_boot_done" if r.mode == "headless" else "boot_done": r.boot_done},
                        ready_on=r.ready_on,
                        shot=r.shot,
                        standby=r.standby,
                        window=r.window,
                        orphans=r.orphans,
                        restarts=r.restarts,
                        restart=r.restart,
                        interrupted=r.interrupted,
                        ok=r.ok,
                        skipped=r.skipped,
                        failed=r.failed,
                        seconds=r.seconds,
                        instance=r.instance,
                        host=r.host,
                        jobs=slots.get(r.host, 0),
                        jobs_full_ram=slots_ram.get(r.host, 0),
                        swap_run_start_mb=swap_base.get(r.host),
                        memory=r.memory,
                        oom=r.oom,
                        commit=a.source["commit"],
                        device_census=r.device_census,
                        checklist=[dict(item=i, status=s, reason=why) for i, s, why in r.checklist],
                        idle_cpu=(
                            dict(
                                status=r.idle_item[0],
                                reason=r.idle_item[1],
                                report=f"{r.target}/idle-cpu.json" if r.idle else None,
                                top=r.idle["processes"][:5] if r.idle else [],
                                flagged=r.idle["flagged"] if r.idle else [],
                            )
                            if r.idle_item
                            else None
                        ),
                        tv={
                            step: [dict(item=i, status=s, reason=why) for i, s, why in items]
                            for step, items in r.items.items()
                        },
                    )
                    for r in results
                ],
                f,
                indent=1,
            )
        say(f"results: {os.path.relpath(d, os.getcwd())}")
    return (
        0
        if results
        and len(results) == len(sel)
        and all(r.ok for r in results)
        and not left
        and not failed_hosts
        else 1
    )


if __name__ == "__main__":
    sys.exit(main())
