from pathlib import Path

TOP = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
IDENTITY_PY = os.path.join(TOP, "packaging", "identity.py")
sys.path.insert(0, os.path.join(TOP, "host", "core"))
sys.path.insert(0, os.path.join(TOP, "tests", "regress", "lib"))
sys.path.insert(0, os.path.join(TOP, "scripts"))
from beanjar import compat, guestlayers, launch, paths, qemu, vmunits  # noqa: E402
from beanjar.firmware import targets  # noqa: E402
from beanjar.board import nvm  # noqa: E402
import buildlock  # noqa: E402
