STANDBY_CPU = 10.0  # QEMU's CPU in standby, % of one host CPU, at most
RESUME_SETTLE = 12  # s from the resume to HOME for its screenshot
STANDBY_SETTLE = 2  # s from the standby port to the CPU measure: the micom's
