"""Stand-in QEMU for the manager tests (it names itself qemu-system-fake in /proc/<pid>/comm, as the
launcher's and the manager's checks for a QEMU expect):
`qemu-system-fake [kernel cmdline words...]`, run by beanjar.unit as the launcher (RUN) for
the VM directory FAKE_VM_DIR, writes run/qemu.pid, serves QMP query-status on run/qmp.sock
(FAKE_QMP_STATUS, default running), writes "debug shell" to logs/console.log after
FAKE_BOOT_DELAY seconds (default 0) and runs until SIGTERM, on which it exits 0 as QEMU does
(which also stands for a guest power-off).

With LIFECYCLE_SOCK (unit.run's, lifecycle.py) it connects there as QEMU's lifecycle monitor, answers
every command with an empty return and records them in run/fake-lifecycle.jsonl, and acts out the
n-th word of FAKE_LIFECYCLE (comma-separated, n counted in run/fake-runs; none: run on):
reset (SHUTDOWN guest-reset, exit 0), poweroff (SHUTDOWN guest-shutdown, exit 0), enospc
(BLOCK_IO_ERROR nospace, then on `quit` SHUTDOWN host-qmp-quit, exit 0). FAKE_ORPHAN=S leaves a child
that lives S seconds after this exits, as the launcher's helpers outlive QEMU briefly. With
FRESH_STATE (unit.run's temporary state of a STATE=none run) each start records the directory and
the files it finds there in run/fake-fresh.jsonl, then writes run<n>.img into it, as a guest writes
its state disks."""

import json
import os
import signal
import socket
import threading
import time

with open("/proc/self/comm", "w") as f:  # an interpreter's comm would be python3
    f.write("qemu-system-fake")
d = os.environ["FAKE_VM_DIR"]
run, logs = os.path.join(d, "run"), os.path.join(d, "logs")
os.makedirs(run, exist_ok=True)
os.makedirs(logs, exist_ok=True)
qmp = os.path.join(run, "qmp.sock")


# netns.py's way with its socket directory (NETNS_SOCK_DIR): made at the start, removed at the end
if os.environ.get("NETNS_SOCK_DIR"):
    os.makedirs(os.environ["NETNS_SOCK_DIR"], exist_ok=True)


def bye(*_):
    if os.environ.get("NETNS_SOCK_DIR"):
        import shutil

        shutil.rmtree(os.environ["NETNS_SOCK_DIR"], ignore_errors=True)
    for p in (qmp, os.path.join(run, "qemu.pid")):
        try:
            os.unlink(p)
        except OSError:
            pass
    os._exit(0)


signal.signal(signal.SIGTERM, bye)
srv = socket.socket(socket.AF_UNIX)
try:
    os.unlink(qmp)
except OSError:
    pass
srv.bind(qmp)
srv.listen(1)


def serve():
    while True:
        c, _ = srv.accept()
        f = c.makefile("rw")
        try:
            f.write(json.dumps({"QMP": {"version": {}, "capabilities": []}}) + "\n")
            f.flush()
            for line in f:
                cmd = json.loads(line).get("execute")
                if cmd == "query-status":
                    st = os.environ.get("FAKE_QMP_STATUS", "running")
                    f.write(
                        json.dumps({"return": {"status": st, "running": st == "running"}}) + "\n"
                    )
                else:
                    f.write(json.dumps({"return": {}}) + "\n")
                f.flush()
        except (OSError, ValueError):
            pass
        c.close()


threading.Thread(target=serve, daemon=True).start()
with open(os.path.join(run, "qemu.pid"), "w") as f:
    f.write(f"{os.getpid()}\n")

if os.environ.get("FAKE_ORPHAN") and os.fork() == 0:
    os.setsid()  # not in the test's way; lives on after this exits, as a helper would
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):  # as the launcher's helpers: not on the launcher's output
        os.dup2(null, fd)
    time.sleep(float(os.environ["FAKE_ORPHAN"]) + 0.5)
    os._exit(0)


def lifecycle(path):
    runs = os.path.join(run, "fake-runs")
    try:
        with open(runs) as f:
            n = int(f.read())
    except (OSError, ValueError):
        n = 0
    with open(runs, "w") as f:
        f.write(str(n + 1))
    fresh = os.environ.get("FRESH_STATE")
    if fresh:
        record = {"run": n, "dir": fresh, "files": sorted(os.listdir(fresh))}
        with open(os.path.join(run, "fake-fresh.jsonl"), "a") as f:
            f.write(json.dumps(record) + "\n")
        with open(os.path.join(fresh, f"run{n}.img"), "w") as f:
            f.write("written\n")
    words = os.environ.get("FAKE_LIFECYCLE", "").split(",")
    act = words[n] if n < len(words) else ""
    c = socket.socket(socket.AF_UNIX)
    c.connect(path)
    buf = b""
    log = open(os.path.join(run, "fake-lifecycle.jsonl"), "a")

    def send(msg):
        c.sendall((json.dumps(msg) + "\n").encode())

    def answer():
        nonlocal buf
        while b"\n" not in buf:
            data = c.recv(65536)
            if not data:
                return None
            buf += data
        line, buf = buf.split(b"\n", 1)
        cmd = json.loads(line)
        log.write(json.dumps({"run": n, **cmd}) + "\n")
        log.flush()
        send({"return": {}})
        return cmd.get("execute")

    send({"QMP": {"version": {}, "capabilities": []}})
    answer()  # qmp_capabilities
    c.settimeout(0.5)  # the replayed commands, if any
    try:
        while answer():
            pass
    except OSError:
        pass
    c.settimeout(None)
    if act in ("reset", "poweroff"):
        reason = "guest-reset" if act == "reset" else "guest-shutdown"
        send({"event": "SHUTDOWN", "data": {"guest": True, "reason": reason}})
        bye()
    if act == "enospc":
        send(
            {
                "event": "BLOCK_IO_ERROR",
                "data": {
                    "device": "state",
                    "operation": "write",
                    "action": "stop",
                    "nospace": True,
                    "reason": "No space left on device",
                },
            }
        )
        send({"event": "STOP", "data": {}})
        while answer() not in ("quit", None):
            pass
        send({"event": "SHUTDOWN", "data": {"guest": False, "reason": "host-qmp-quit"}})
        bye()


if os.environ.get("LIFECYCLE_SOCK"):
    threading.Thread(target=lifecycle, args=(os.environ["LIFECYCLE_SOCK"],), daemon=True).start()
time.sleep(float(os.environ.get("FAKE_BOOT_DELAY", "0")))
with open(os.path.join(logs, "console.log"), "a") as f:
    f.write("Starting the initramfs debug shell\n")
while True:
    time.sleep(3600)
