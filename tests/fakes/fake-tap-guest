"""A stand-in for QEMU under mode=mitm (tests/integration/network/test_netns.py): a "guest" on the TAP, without
a VM. Run by beanjar.network.netns inner in QEMU's place, it attaches to the TAP (NETNS_TAP) as QEMU does,
then moves itself into a network namespace of its own with a TAP of its own, eth0, and copies
frames between the two, so eth0 is the guest's NIC on the other end of the namespace's tap0.

In there it gets a lease with a DHCP client of its own (and renews it by unicast, as a client in
RENEWING does), runs the probes of the JSON file FAKE_GUEST_SPEC and writes their results to
FAKE_GUEST_RESULTS (a probe's "timeout": its connect timeout, default 5 s; FAKE_GUEST_LEASED, a
file it makes once it has its lease, before the probes), then serves FAKE_GUEST_PORT (a banner, for the forwarded-port relay) until the
file FAKE_GUEST_STOP appears.
"""

import fcntl
import json
import os
import select
import socket
import ssl
import struct
import subprocess
import sys
import threading
import time

TUNSETIFF = 0x400454CA
IFF_TAP, IFF_NO_PI = 0x0002, 0x1000
MAGIC = bytes((99, 130, 83, 99))
MAC = bytes.fromhex("a823fe123456")


def tap(name):
    fd = os.open("/dev/net/tun", os.O_RDWR)
    fcntl.ioctl(fd, TUNSETIFF, struct.pack("16sH", name.encode(), IFF_TAP | IFF_NO_PI))
    return fd


def pump(a, b):
    while True:
        for fd in select.select([a, b], [], [])[0]:
            try:
                os.write(b if fd == a else a, os.read(fd, 65536))
            except OSError:
                pass


def ip(*args):
    subprocess.run(["ip", *args], check=True)


def options(data):
    out, i = {}, 0
    while i < len(data) and data[i] != 255:
        if data[i] == 0:
            i += 1
            continue
        out[data[i]] = data[i + 2 : i + 2 + data[i + 1]]
        i += 2 + data[i + 1]
    return out


def dhcp(sock, dest, msgtype, xid, ciaddr="0.0.0.0", extra=b""):
    """Send one DHCP message to dest and return (yiaddr, options) of the reply to xid."""
    pkt = bytearray(240)
    pkt[0:4] = bytes((1, 1, 6, 0))
    pkt[4:8] = xid
    pkt[12:16] = socket.inet_aton(ciaddr)
    pkt[28:34] = MAC
    pkt[236:240] = MAGIC
    pkt += bytes((53, 1, msgtype)) + extra + bytes((255,))
    sock.sendto(bytes(pkt), (dest, 67))
    end = time.monotonic() + 5
    while time.monotonic() < end:
        sock.settimeout(max(0.1, end - time.monotonic()))
        try:
            data = sock.recv(2048)
        except socket.timeout:
            break
        if data[4:8] == xid and data[236:240] == MAGIC:
            opts = options(data[240:])
            out = {
                k: socket.inet_ntoa(opts[k]) for k in (1, 3, 6, 54) if len(opts.get(k, b"")) == 4
            }
            out[53] = opts.get(53, b"\0")[0]
            return socket.inet_ntoa(data[16:20]), out
    return None, {}


def lease():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, b"eth0")
    s.bind(("", 68))
    offer_ip, offer = dhcp(s, "255.255.255.255", 1, b"\x01\x02\x03\x04")
    server = offer.get(54)
    ack_ip, ack = dhcp(
        s,
        "255.255.255.255",
        3,
        b"\x01\x02\x03\x05",
        extra=bytes((50, 4))
        + socket.inet_aton(offer_ip or "0.0.0.0")
        + bytes((54, 4))
        + socket.inet_aton(server or "0.0.0.0"),
    )
    result = {
        "offer": offer_ip,
        "router": offer.get(3),
        "dns": offer.get(6),
        "server": server,
        "mask": offer.get(1),
        "ack": ack_ip if ack.get(53) == 5 else None,
    }
    if ack_ip:
        ip("addr", "add", f"{ack_ip}/24", "dev", "eth0")
        ip("route", "add", "default", "via", ack[3])
        # RENEWING: unicast to the server that granted the lease, from the leased address.
        renew_ip, renew = dhcp(s, server, 3, b"\x01\x02\x03\x06", ciaddr=ack_ip)
        result["renew"] = renew_ip if renew.get(53) == 5 else None
        result["renew_server"] = renew.get(54)
    s.close()
    return result


def complete(data):
    """Whether data is a whole HTTP response by its Content-Length (False: read on to the end)."""
    head, sep, body = data.partition(b"\r\n\r\n")
    if not sep or not head.startswith(b"HTTP/"):
        return False
    for line in head.split(b"\r\n")[1:]:
        name, _, value = line.partition(b":")
        if name.strip().lower() == b"content-length" and value.strip().isdigit():
            return len(body) >= int(value)
    return False


def tcp(host, port, send=b"", timeout=5):
    """What a TCP client sees: what it receives until the server closes (or an HTTP response is
    whole by its Content-Length), or the error. A server may write a reply in several pieces (an
    HTTP server its headers, then its body), so one recv() could miss the end of it."""
    data = b""
    try:
        with socket.create_connection((host, port), timeout) as c:
            if send:
                c.sendall(send)
            while not complete(data):
                chunk = c.recv(4096)
                if not chunk:
                    break
                data += chunk
    except (OSError, socket.timeout) as e:
        if not data:
            return {"error": type(e).__name__}
    return {"data": data.decode("latin-1")}


def udp(host, port, send=b"", timeout=5):
    """What a UDP client sees: the first datagram received in reply to send, or the error."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as c:
            c.settimeout(timeout)
            c.sendto(send, (host, port))
            return {"data": c.recv(4096).decode("latin-1")}
    except (OSError, socket.timeout) as e:
        return {"error": type(e).__name__}


def https(host, port, sni, cafile, timeout=5):
    ctx = ssl.create_default_context(cafile=cafile)
    try:
        with (
            socket.create_connection((host, port), timeout) as raw,
            ctx.wrap_socket(raw, server_hostname=sni) as c,
        ):
            issuer = dict(x[0] for x in c.getpeercert()["issuer"])
            c.sendall(f"GET /probe HTTP/1.1\r\nHost: {sni}\r\nConnection: close\r\n\r\n".encode())
            return {"issuer": issuer.get("commonName"), "data": c.recv(4096).decode("latin-1")}
    except (OSError, ssl.SSLError, socket.timeout) as e:
        return {"error": f"{type(e).__name__}: {e}"}


def main():
    outer = tap(os.environ.get("NETNS_TAP", "tap0"))
    os.unshare(os.CLONE_NEWNET)
    inner = tap("eth0")
    ip("link", "set", "lo", "up")
    ip("link", "set", "eth0", "address", MAC.hex(":"), "up")
    # A real DHCP client reads the offer from a packet socket; this one uses a UDP socket, whose
    # replies (from an address with no route back yet) reverse-path filtering would drop.
    for conf in ("all", "eth0"):
        with open(f"/proc/sys/net/ipv4/conf/{conf}/rp_filter", "w") as f:
            f.write("0\n")
    threading.Thread(target=pump, args=(outer, inner), daemon=True).start()
    with open(os.environ["FAKE_GUEST_SPEC"]) as f:
        spec = json.load(f)
    results = {"dhcp": lease()}
    if os.environ.get("FAKE_GUEST_LEASED"):
        open(os.environ["FAKE_GUEST_LEASED"], "w").close()
    for name, probe in spec.items():
        start = time.monotonic()
        kind = probe.pop("kind")
        if kind == "udp":
            r = udp(
                probe["host"],
                probe["port"],
                probe.get("send", "").encode(),
                probe.get("timeout", 5),
            )
        elif kind == "tcp":
            r = tcp(
                probe["host"],
                probe["port"],
                probe.get("send", "").encode(),
                probe.get("timeout", 5),
            )
        else:
            r = https(
                probe["host"], probe["port"], probe["sni"], probe["cafile"], probe.get("timeout", 5)
            )
        r["seconds"] = round(time.monotonic() - start, 2)
        results[name] = r
    tmp = os.environ["FAKE_GUEST_RESULTS"] + ".tmp"
    with open(tmp, "w") as f:
        json.dump(results, f, indent=1)
    srv = socket.create_server(("0.0.0.0", int(os.environ["FAKE_GUEST_PORT"])))
    os.rename(tmp, os.environ["FAKE_GUEST_RESULTS"])
    srv.settimeout(0.2)
    while not os.path.exists(os.environ["FAKE_GUEST_STOP"]):
        try:
            c, _ = srv.accept()
        except socket.timeout:
            continue
        with c:
            c.sendall(b"guest-banner\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
