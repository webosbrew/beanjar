#!/usr/bin/python3
# SPDX-FileCopyrightText: Mariotaku <git@mariotaku.me> and the Beanjar contributors
# SPDX-License-Identifier: GPL-2.0-or-later
"""beanjar-viewer: Beanjar Viewer, the desktop window of a Beanjar VM (host/viewer/README.md).

The GTK 4 window (beanjar_ui.viewer, published beside this file in build/viewer, over the
checkout's core package beanjar in host/core), or, for --headless, --replay,
--screenshot, --screenshot-every, --osd-alpha, --no-osd and --capture-sink, the headless program
viewer-headless, exec'd in place (same pid) before anything imports GTK, so hosts without
GTK 4 for Python run every test.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
HEADLESS = (
    "--headless",
    "--replay",
    "--screenshot",
    "--screenshot-every",
    "--osd-alpha",
    "--no-osd",
    "--capture-sink",
)


def main():
    args = sys.argv[1:]
    if any(a in HEADLESS for a in args):
        exe = os.path.join(HERE, "viewer-headless")
        os.execv(exe, [exe] + args)
    sys.dont_write_bytecode = True  # the published tree stays as published
    sys.path.insert(0, HERE)
    sys.path.append(os.path.join(os.path.dirname(os.path.dirname(HERE)), "host", "core"))
    from beanjar_ui.viewer.main import main as gtk_main

    return gtk_main(args)


if __name__ == "__main__":
    sys.exit(main())
