<?xml version="1.0" encoding="EUC-JP" ?>
<!DOCTYPE bml PUBLIC "+//ARIB STD-B24:1999//DTD BML Document for Japanese//JA" "http://www.arib.or.jp/B24/DTD/bml_1_0.dtd">
<?bml bml-version="100.0" ?>
<bml>
<head>
<title>データ放送メニュー</title>
<style><![CDATA[
body { resolution: 960x540; display-aspect-ratio: 16v9; used-key-list: basic data-button; background-color-index: 19; }
p { font-family: 丸ゴシック; font-size: 28px; line-height: 40px; color-index: 7; }
]]></style>
<script><![CDATA[
function key() {
  if (document.currentEvent.keyCode == 21) browser.launchDocument("/40/0000/startup.bml", "cut");
}
]]></script>
</head>
<body onload="document.getElementById('video').focus();">
<div id="video" style="left:48px;top:36px;width:480px;height:270px;nav-index:0;" onkeydown="key();">
<object type="video/X-arib-mpeg2" data="/00" streamstatus="play" style="left:0px;top:0px;width:480px;height:270px;"/>
</div>
<div style="left:560px;top:36px;width:352px;height:270px;">
<p style="left:0px;top:0px;width:352px;height:40px;">データ放送メニュー</p>
<p style="left:0px;top:56px;width:352px;height:40px;font-size:24px;">Beanjar BML menu</p>
</div>
<div style="left:48px;top:346px;width:864px;height:154px;">
<p style="left:0px;top:0px;width:864px;height:40px;">ビーンジャー データ放送テスト</p>
<p style="left:0px;top:56px;width:864px;height:40px;font-size:24px;">青ボタンで戻る</p>
</div>
</body>
</bml>
